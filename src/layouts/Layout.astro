---
import "../styles/tokens.css";
import { visibleNavigationItems } from "../config/navigation";
import { siteConfig } from "../config/site";

const {
  title = "Minseok Song | A1 Firms",
  description = "Layered site foundation for Minseok Song and A1 Firms.",
  headerNote = "Personal site / V0.1"
} = Astro.props;

const nav = visibleNavigationItems();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand-lockup" href="/" aria-label="Minseok Song home">
          <img class="brand-logo" src="/A1Firm.png" alt="" width="44" height="44" />
          <span>
            <strong>{siteConfig.name}</strong>
            <small>A1 Firms</small>
          </span>
        </a>

        <nav class="numbered-nav" aria-label="Primary navigation">
          {nav.map((item) => {
            const itemPath = item.path.replace(/\/$/, "") || "/";
            const isCurrent = pathname === itemPath;

            return (
              <a
                href={item.path}
                aria-current={isCurrent ? "page" : undefined}
              >
                <span class="nav-number">{item.num}</span>
                <span class="nav-label">{item.label}</span>
              </a>
            );
          })}
        </nav>

        <p class="header-note">{headerNote}</p>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <span>Copyright {currentYear} Minseok Song. Seoul.</span>
        <span>{siteConfig.title}</span>
      </footer>
    </div>
    <script is:inline>
      document.addEventListener("click", (event) => {
        const link = event.target.closest("a");

        if (!link) return;
        if (link.target || link.hasAttribute("download")) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const url = new URL(link.href, window.location.href);

        if (url.origin !== window.location.origin) return;
        if (url.pathname === window.location.pathname && url.hash) return;

        event.preventDefault();
        document.body.classList.add("is-exiting");
        window.setTimeout(() => {
          window.location.href = url.href;
        }, 180);
      });
    </script>
  </body>
</html>
