---
import { getSession } from 'auth-astro/server';
import { SignOut } from 'auth-astro/components';
import "../styles/tokens.css";
import { visibleNavigationItems } from "../config/navigation";
import { siteConfig } from "../config/site";
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import A1Chan from "../features/a1-chan/A1Chan.astro";

const session = await getSession(Astro.request);
const {
  title = "Minseok Song | A1 Firms",
  description = "Layered site foundation for Minseok Song and A1 Firms.",
  headerNote = "Personal site / V0.1",
  image = siteConfig.defaultImage,
  type = "website",
  noindex = false
} = Astro.props;

const nav = visibleNavigationItems();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const siteUrl = (import.meta.env.SITE_URL || siteConfig.url).replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, `${siteUrl}/`).toString();
const imageUrl = new URL(image, `${siteUrl}/`).toString();
const shouldNoindex = noindex || pathname.startsWith("/admin");
const contentProtectionEnabled = !pathname.startsWith("/admin");
const locale = siteConfig.defaultLocale === "ko" ? "ko_KR" : siteConfig.defaultLocale;
const currentYear = new Date().getFullYear();
const faviconVersion = "20260612";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteUrl,
  description: siteConfig.description,
  inLanguage: siteConfig.defaultLocale
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#030407" id="theme-color" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
        const themeStorageKey = "theme-session-preference";
        const themeSystemStorageKey = "theme-session-system";
        let savedTheme = null;
        const systemTheme = darkQuery.matches ? "dark" : "light";

        try {
          localStorage.removeItem("theme");
        } catch {}

        try {
          const value = sessionStorage.getItem(themeStorageKey);
          const savedSystemTheme = sessionStorage.getItem(themeSystemStorageKey);
          savedTheme = (value === "light" || value === "dark") && savedSystemTheme === systemTheme ? value : null;
          if (!savedTheme) {
            sessionStorage.removeItem(themeStorageKey);
            sessionStorage.removeItem(themeSystemStorageKey);
          }
        } catch {}

        const resolvedTheme = savedTheme || systemTheme;
        root.dataset.themeMode = savedTheme ? "manual" : "system";
        root.dataset.resolvedTheme = resolvedTheme;
        if (savedTheme) {
          root.setAttribute("data-theme", resolvedTheme);
        } else {
          root.removeAttribute("data-theme");
        }
        root.style.colorScheme = resolvedTheme === "dark" ? "only dark" : "only light";

        const metaThemeColor = document.getElementById("theme-color");
        if (metaThemeColor) {
          metaThemeColor.setAttribute("content", resolvedTheme === "dark" ? "#030407" : "#EBEAE4");
        }
      })();
    </script>
    <link rel="icon" type="image/png" href={`/A1Firm-logo_light.png?v=${faviconVersion}`} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href={`/A1Firm-logo.png?v=${faviconVersion}`} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href={`/A1Firm-logo.png?v=${faviconVersion}`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} writings`} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="description" content={description} />
    <meta name="robots" content={shouldNoindex ? "noindex,nofollow" : "index,follow"} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      /* Disable CSS transitions during theme toggle so View Transitions capture the final state perfectly */
      html.is-animating-theme *,
      html.is-animating-theme *::before,
      html.is-animating-theme *::after {
        transition: none !important;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }
      
      ::view-transition-old(root) {
        z-index: 1;
      }
      
      ::view-transition-new(root) {
        z-index: 2;
      }

      /* Prevent the 1-frame flash before JS animate() kicks in */
      html.is-animating-theme ::view-transition-new(root) {
        clip-path: circle(0px);
      }

      .browser-recommendation-toast {
        position: fixed;
        z-index: 1000;
        top: -96px;
        left: 0;
        right: 0;
        display: grid;
        grid-template-columns: 30px minmax(0, 1fr);
        gap: 10px;
        align-items: center;
        width: min(calc(100vw - 28px), 430px);
        margin: 0 auto;
        padding: 10px 12px;
        border: 1px solid color-mix(in srgb, var(--color-line-strong) 78%, transparent);
        border-radius: 8px;
        background: var(--color-panel-solid);
        color: var(--color-ink);
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.24);
        font-family: var(--font-sans);
        text-align: left;
        opacity: 0;
        pointer-events: none;
        transition:
          top 420ms var(--easing-smooth),
          opacity 260ms ease;
      }

      .browser-recommendation-toast.is-visible {
        top: max(10px, env(safe-area-inset-top));
        opacity: 1;
      }

      .browser-recommendation-toast__mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border-radius: 999px;
        border: 1px solid color-mix(in srgb, var(--color-accent) 38%, transparent);
        background: var(--color-accent-soft);
        color: var(--color-accent-ink);
        font-size: 0.84rem;
        font-weight: 900;
        line-height: 1;
      }

      .browser-recommendation-toast__copy {
        display: grid;
        gap: 2px;
        min-width: 0;
      }

      .browser-recommendation-toast__title {
        display: block;
        overflow: hidden;
        color: var(--color-ink);
        font-size: 0.82rem;
        font-weight: 850;
        line-height: 1.15;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .browser-recommendation-toast__message {
        display: block;
        color: var(--color-ink-soft);
        font-size: 0.76rem;
        font-weight: 650;
        line-height: 1.35;
      }

      @media (prefers-color-scheme: light) {
        html:not([data-theme]) .browser-recommendation-toast {
          background: rgba(250, 248, 240, 0.94);
          color: #2a2722;
          border-color: rgba(179, 138, 77, 0.28);
          box-shadow: 0 14px 34px rgba(91, 73, 38, 0.14);
        }
      }

      html[data-theme="light"] .browser-recommendation-toast {
        background: rgba(250, 248, 240, 0.94);
        color: #2a2722;
        border-color: rgba(179, 138, 77, 0.28);
        box-shadow: 0 14px 34px rgba(91, 73, 38, 0.14);
      }

      @media (max-width: 640px) {
        .browser-recommendation-toast {
          grid-template-columns: 28px minmax(0, 1fr);
          gap: 9px;
          width: min(calc(100vw - 24px), 390px);
          padding: 9px 10px;
        }

        .browser-recommendation-toast__mark {
          width: 28px;
          height: 28px;
          font-size: 0.78rem;
        }

        .browser-recommendation-toast__title {
          font-size: 0.78rem;
        }

        .browser-recommendation-toast__message {
          font-size: 0.72rem;
        }
      }
    </style>
    <slot name="head" />
  </head>
  <body data-content-protection={contentProtectionEnabled ? "enabled" : "disabled"}>
    <Analytics />
    <SpeedInsights />
    <div class="site-shell">
      <header class="site-header">
        <a class="brand-lockup" href="/" aria-label="Minseok Song home">
          <span class="brand-wordmark">Minseok Song</span>
        </a>

        <nav class="numbered-nav" aria-label="Primary navigation">
          <div class="nav-indicator-line" id="nav-indicator" aria-hidden="true"></div>
          {nav.map((item) => {
            const itemPath = item.path.replace(/\/$/, "") || "/";
            const isCurrent = pathname === itemPath;

            return (
              <a
                href={item.path}
                aria-current={isCurrent ? "page" : undefined}
              >
                <span class="nav-label">{item.label}</span>
              </a>
            );
          })}
        </nav>

        <div class="header-utility">
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Toggle dark/light mode"
            aria-pressed="false"
          >
            <svg class="theme-icon theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="theme-icon theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <div class="login-link" aria-label="Client greeting">
            <picture class="logo-dark">
              <source srcset="/A1Firm-logo.webp" type="image/webp" />
              <img class="utility-logo" src="/A1Firm-logo.png" alt="" width="16" height="16" />
            </picture>
            <picture class="logo-light">
              <source srcset="/A1Firm-logo_light.webp" type="image/webp" />
              <img class="utility-logo" src="/A1Firm-logo_light.png" alt="" width="16" height="16" />
            </picture>
            <span>{session ? `Hi, ${session.user?.name || 'Minseok'}!` : 'Hi, Client!'}</span>
          </div>
          {session && (
            <SignOut class="logout-button">
              Logout
            </SignOut>
          )}
        </div>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <span>Copyright {currentYear} Minseok Song. Seoul.</span>
        <span>{siteConfig.title}</span>
      </footer>
    </div>
    <A1Chan />
    <script is:inline>
      (() => {
        if (document.body?.dataset.contentProtection !== "enabled") return;

        const selectableSelector = [
          "input",
          "textarea",
          "select",
          "[contenteditable]",
          ".allow-select",
          "[data-allow-selection]"
        ].join(",");

        const getElement = (target) => {
          if (target instanceof Element) return target;
          if (target instanceof Node) return target.parentElement;
          return null;
        };

        const isSelectableTarget = (target) => Boolean(getElement(target)?.closest(selectableSelector));

        const blockDefault = (event) => {
          if (isSelectableTarget(event.target)) return;
          event.preventDefault();
          event.stopPropagation();
        };

        const blockSecondaryPointer = (event) => {
          if (isSelectableTarget(event.target)) return;
          if (event.button === 1 || event.button === 2) {
            event.preventDefault();
            event.stopPropagation();
          }
        };

        ["contextmenu", "selectstart", "dragstart", "drop", "copy", "cut"].forEach((eventName) => {
          document.addEventListener(eventName, blockDefault, { capture: true });
        });

        ["mousedown", "pointerdown", "auxclick"].forEach((eventName) => {
          document.addEventListener(eventName, blockSecondaryPointer, { capture: true });
        });

        document.addEventListener("selectionchange", () => {
          const selection = document.getSelection();
          if (!selection || selection.isCollapsed) return;
          if (isSelectableTarget(selection.anchorNode) || isSelectableTarget(selection.focusNode)) return;
          selection.removeAllRanges();
        });

        document.addEventListener("keydown", (event) => {
          if (isSelectableTarget(event.target)) return;

          const key = event.key.toLowerCase();
          const usesCommand = event.ctrlKey || event.metaKey;
          const blockedShortcut =
            key === "f12" ||
            key === "printscreen" ||
            (usesCommand && ["a", "c", "x", "s", "p", "u"].includes(key)) ||
            (usesCommand && event.shiftKey && ["c", "i", "j"].includes(key));

          if (blockedShortcut) {
            event.preventDefault();
            event.stopPropagation();
          }
        }, { capture: true });

        document.querySelectorAll("img, svg, canvas, video").forEach((element) => {
          element.setAttribute("draggable", "false");
        });
      })();

      (() => {
        if (!/SamsungBrowser/i.test(navigator.userAgent)) return;

        const storageKey = 'samsung-browser-recommendation-seen';
        try {
          if (sessionStorage.getItem(storageKey) === 'true') return;
          sessionStorage.setItem(storageKey, 'true');
        } catch {}

        const toast = document.createElement('div');
        toast.id = 'browser-recommendation-toast';
        toast.className = 'browser-recommendation-toast';
        toast.setAttribute('role', 'status');
        toast.setAttribute('aria-live', 'polite');
        toast.innerHTML = [
          '<span class="browser-recommendation-toast__mark" aria-hidden="true">i</span>',
          '<span class="browser-recommendation-toast__copy">',
          '<strong class="browser-recommendation-toast__title">Chrome 브라우저 권장</strong>',
          '<span class="browser-recommendation-toast__message">Samsung Internet의 강제 다크 모드가 색상을 바꿀 수 있습니다.</span>',
          '</span>'
        ].join(' ');
        document.body.appendChild(toast);

        window.requestAnimationFrame(() => {
          toast.classList.add('is-visible');
        });

        window.setTimeout(() => {
          toast.classList.remove('is-visible');
          window.setTimeout(() => {
            toast.remove();
          }, 460);
        }, 5200);
      })();

      document.addEventListener("click", (event) => {
        const link = event.target.closest("a");

        if (!link) return;
        if (link.target || link.hasAttribute("download")) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const url = new URL(link.href, window.location.href);

        if (url.origin !== window.location.origin) return;
        if (url.pathname === window.location.pathname && url.hash) return;

        event.preventDefault();
        document.body.classList.add("is-exiting");
        window.setTimeout(() => {
          window.location.href = url.href;
        }, 180);
      });

      const themeToggle = document.getElementById('theme-toggle');
      const systemThemeQuery = '(prefers-color-scheme: dark)';
      const themeMedia = window.matchMedia(systemThemeQuery);
      const themeStorageKey = 'theme-session-preference';
      const themeSystemStorageKey = 'theme-session-system';
      const legacyThemeStorageKey = 'theme';
      const root = document.documentElement;
      const getSystemTheme = () => themeMedia.matches ? 'dark' : 'light';
      let lastSystemTheme = getSystemTheme();

      const readSavedTheme = () => {
        try {
          localStorage.removeItem(legacyThemeStorageKey);
        } catch {}

        try {
          const value = sessionStorage.getItem(themeStorageKey);
          const savedSystemTheme = sessionStorage.getItem(themeSystemStorageKey);
          const savedTheme = (value === 'light' || value === 'dark') && savedSystemTheme === getSystemTheme() ? value : null;
          if (!savedTheme) {
            sessionStorage.removeItem(themeStorageKey);
            sessionStorage.removeItem(themeSystemStorageKey);
          }
          return savedTheme;
        } catch {
          return null;
        }
      };

      const saveManualTheme = (theme) => {
        try {
          sessionStorage.setItem(themeStorageKey, theme);
          sessionStorage.setItem(themeSystemStorageKey, getSystemTheme());
        } catch {}

        try {
          localStorage.removeItem(legacyThemeStorageKey);
        } catch {}
      };

      const clearSavedTheme = () => {
        try {
          sessionStorage.removeItem(themeStorageKey);
          sessionStorage.removeItem(themeSystemStorageKey);
        } catch {}

        try {
          localStorage.removeItem(legacyThemeStorageKey);
        } catch {}
      };

      const getThemeMode = () => root.dataset.themeMode === 'manual' ? 'manual' : 'system';
      const getEffectiveTheme = () => root.dataset.resolvedTheme || readSavedTheme() || getSystemTheme();

      const updateThemeChrome = (theme = getEffectiveTheme()) => {
        themeToggle?.setAttribute('aria-pressed', theme === 'light' ? 'true' : 'false');
        themeToggle?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');

        const metaThemeColor = document.getElementById('theme-color');
        if (metaThemeColor) {
          metaThemeColor.setAttribute('content', theme === 'dark' ? '#030407' : '#EBEAE4');
        }
      };

      const publishThemeChange = (theme) => {
        window.__getResolvedSiteTheme = () => getEffectiveTheme();
        window.dispatchEvent(new CustomEvent('site-theme-change', {
          detail: { theme, mode: getThemeMode() }
        }));
      };

      const applyTheme = (theme, mode) => {
        root.dataset.themeMode = mode;
        root.dataset.resolvedTheme = theme;

        if (mode === 'manual') {
          root.setAttribute('data-theme', theme);
        } else {
          root.removeAttribute('data-theme');
        }

        root.style.colorScheme = theme === 'dark' ? 'only dark' : 'only light';
        updateThemeChrome(theme);
        publishThemeChange(theme);
      };

      const applySavedOrSystemTheme = () => {
        const savedTheme = readSavedTheme();
        const systemTheme = getSystemTheme();
        const theme = savedTheme || systemTheme;
        applyTheme(theme, savedTheme ? 'manual' : 'system');
      };

      const setPreferredTheme = (theme) => {
        if (theme === getSystemTheme()) {
          clearSavedTheme();
          applyTheme(theme, 'system');
          return;
        }

        saveManualTheme(theme);
        applyTheme(theme, 'manual');
      };

      applySavedOrSystemTheme();

      const syncWithSystem = () => {
        clearSavedTheme();
        const systemTheme = getSystemTheme();
        lastSystemTheme = systemTheme;
        applyTheme(systemTheme, 'system');
      };

      const syncSystemIfChanged = () => {
        const systemTheme = getSystemTheme();
        if (systemTheme === lastSystemTheme) return;
        clearSavedTheme();
        lastSystemTheme = systemTheme;
        applyTheme(systemTheme, 'system');
      };

      if (typeof themeMedia.addEventListener === 'function') {
        themeMedia.addEventListener('change', syncWithSystem);
      } else if (typeof themeMedia.addListener === 'function') {
        themeMedia.addListener(syncWithSystem);
      }
      window.addEventListener('storage', (event) => {
        if ([themeStorageKey, themeSystemStorageKey, legacyThemeStorageKey].includes(event.key)) {
          applySavedOrSystemTheme();
        }
      });

      window.addEventListener('pageshow', syncSystemIfChanged);
      window.addEventListener('focus', syncSystemIfChanged);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          syncSystemIfChanged();
        }
      });

      if (themeToggle) {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        themeToggle.addEventListener('click', async (event) => {
          const currentTheme = getEffectiveTheme();
          const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
          
          const switchTheme = () => {
            setPreferredTheme(newTheme);
          };

          if (!document.startViewTransition || reducedMotion.matches) {
            switchTheme();
            return;
          }

          const x = event.clientX;
          const y = event.clientY;
          const endRadius = Math.hypot(
            Math.max(x, innerWidth - x),
            Math.max(y, innerHeight - y)
          );

          document.documentElement.classList.add('is-animating-theme');

          const transition = document.startViewTransition(() => {
            switchTheme();
          });

          transition.ready.then(() => {
            document.documentElement.animate(
              {
                clipPath: [
                  `circle(0px at ${x}px ${y}px)`,
                  `circle(${endRadius}px at ${x}px ${y}px)`
                ]
              },
              {
                duration: 600,
                easing: 'cubic-bezier(0.86, 0, 0.07, 1)',
                pseudoElement: '::view-transition-new(root)'
              }
            );

            document.documentElement.animate(
              {
                filter: [
                  `blur(0px) brightness(1)`,
                  `blur(12px) brightness(1)`
                ]
              },
              {
                duration: 600,
                easing: 'cubic-bezier(0.86, 0, 0.07, 1)',
                pseudoElement: '::view-transition-old(root)'
              }
            );
          });

          transition.finished.finally(() => {
            document.documentElement.classList.remove('is-animating-theme');
          });
        });
      }

      // Nav Indicator sliding logic
      const initNavIndicator = () => {
        const nav = document.querySelector('.numbered-nav');
        const indicator = document.getElementById('nav-indicator');
        if (!nav || !indicator) return;

        const items = nav.querySelectorAll('a');
        const activeItem = nav.querySelector('a[aria-current="page"]');

        const updateIndicator = (targetLink) => {
          if (!targetLink) {
            indicator.style.opacity = '0';
            return;
          }
          
          const label = targetLink.querySelector('.nav-label');
          if (!label) return;

          const navRect = nav.getBoundingClientRect();
          const labelRect = label.getBoundingClientRect();

          indicator.style.width = `${labelRect.width}px`;
          indicator.style.left = `${labelRect.left - navRect.left}px`;
          indicator.style.opacity = '1';
        };

        // Initialize position reliably without magic number delays
        const initializePosition = () => {
          if (!indicator) return;
          
          // Disable transition for initial placement to avoid sliding from 0
          indicator.style.transition = 'none';
          updateIndicator(activeItem);
          
          // Restore transition after the next frame when layout is committed
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              indicator.style.transition = '';
            });
          });
        };

        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(initializePosition);
        } else {
          window.addEventListener('load', initializePosition);
        }

        // Dynamic hover bindings
        items.forEach(item => {
          item.addEventListener('mouseenter', () => updateIndicator(item));
        });

        nav.addEventListener('mouseleave', () => {
          updateIndicator(activeItem);
        });

        // Update on window resize to keep position correct
        window.addEventListener('resize', () => {
          const currentActive = nav.querySelector('a[aria-current="page"]');
          updateIndicator(currentActive);
        });
      };

      initNavIndicator();

      // Global Scroll Reveal Observer
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.15
      };
      
      const scrollObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            // Optional: stop observing once visible to run only once
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      // Run initially and whenever DOM changes (useful for Astro client-side navigation if added later)
      const initScrollObserver = () => {
        document.querySelectorAll('.reveal-up, .reveal-in').forEach(el => {
          scrollObserver.observe(el);
        });
      };
      
      initScrollObserver();
    </script>
  </body>
</html>
