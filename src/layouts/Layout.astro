---
const {
	title = "Minseok Song | A1 Firms",
	description = "Layered site foundation for Minseok Song and A1 Firms."
} = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background: #0b0c10;
		color: #f6f7fb;
		font-family:
			Inter,
			Pretendard,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			sans-serif;
	}
</style>
