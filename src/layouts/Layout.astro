---
import { getSession } from 'auth-astro/server';
import { SignOut } from 'auth-astro/components';
import "../styles/tokens.css";
import { visibleNavigationItems } from "../config/navigation";
import { siteConfig } from "../config/site";
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import A1Chan from "../features/a1-chan/A1Chan.astro";

const session = await getSession(Astro.request);
const {
  title = "Minseok Song | A1 Firms",
  description = "Layered site foundation for Minseok Song and A1 Firms.",
  headerNote = "Personal site / V0.1",
  image = siteConfig.defaultImage,
  type = "website",
  noindex = false
} = Astro.props;

const nav = visibleNavigationItems();
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const siteUrl = (import.meta.env.SITE_URL || siteConfig.url).replace(/\/$/, "");
const canonicalUrl = new URL(Astro.url.pathname, `${siteUrl}/`).toString();
const imageUrl = new URL(image, `${siteUrl}/`).toString();
const shouldNoindex = noindex || pathname.startsWith("/admin");
const contentProtectionEnabled = !pathname.startsWith("/admin");
const locale = siteConfig.defaultLocale === "ko" ? "ko_KR" : siteConfig.defaultLocale;
const currentYear = new Date().getFullYear();
const faviconVersion = "20260612";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.name,
  url: siteUrl,
  description: siteConfig.description,
  inLanguage: siteConfig.defaultLocale
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#030407" id="theme-color" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const sessionKey = "theme-override";
        const legacyKey = "theme";
        const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
        const isSamsungBrowser = /SamsungBrowser/i.test(navigator.userAgent);

        try {
          sessionStorage.removeItem(sessionKey);
          localStorage.removeItem(legacyKey);
        } catch {}

        const systemTheme = darkQuery.matches ? "dark" : "light";
        if (isSamsungBrowser) {
          root.setAttribute("data-theme", systemTheme);
          root.setAttribute("data-theme-source", "samsung-system");
        } else {
          root.removeAttribute("data-theme");
          root.removeAttribute("data-theme-source");
        }
        root.style.colorScheme = "";

        const metaThemeColor = document.getElementById("theme-color");
        if (metaThemeColor) {
          metaThemeColor.setAttribute("content", systemTheme === "dark" ? "#030407" : "#EBEAE4");
        }
      })();
    </script>
    <link rel="icon" type="image/png" href={`/A1Firm-logo_light.png?v=${faviconVersion}`} media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" href={`/A1Firm-logo.png?v=${faviconVersion}`} media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href={`/A1Firm-logo.png?v=${faviconVersion}`} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} writings`} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="description" content={description} />
    <meta name="robots" content={shouldNoindex ? "noindex,nofollow" : "index,follow"} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <style is:global>
      /* Disable CSS transitions during theme toggle so View Transitions capture the final state perfectly */
      html.is-animating-theme *,
      html.is-animating-theme *::before,
      html.is-animating-theme *::after {
        transition: none !important;
      }

      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }
      
      ::view-transition-old(root) {
        z-index: 1;
      }
      
      ::view-transition-new(root) {
        z-index: 2;
      }

      /* Prevent the 1-frame flash before JS animate() kicks in */
      html.is-animating-theme ::view-transition-new(root) {
        clip-path: circle(0px);
      }
    </style>
  </head>
  <body data-content-protection={contentProtectionEnabled ? "enabled" : "disabled"}>
    <Analytics />
    <SpeedInsights />
    <div class="site-shell">
      <header class="site-header">
        <a class="brand-lockup" href="/" aria-label="Minseok Song home">
          <span class="brand-wordmark">Minseok Song</span>
        </a>

        <nav class="numbered-nav" aria-label="Primary navigation">
          <div class="nav-indicator-line" id="nav-indicator" aria-hidden="true"></div>
          {nav.map((item) => {
            const itemPath = item.path.replace(/\/$/, "") || "/";
            const isCurrent = pathname === itemPath;

            return (
              <a
                href={item.path}
                aria-current={isCurrent ? "page" : undefined}
              >
                <span class="nav-label">{item.label}</span>
              </a>
            );
          })}
        </nav>

        <div class="header-utility">
          <button
            id="theme-toggle"
            class="theme-toggle"
            type="button"
            aria-label="Toggle dark/light mode"
            aria-pressed="false"
          >
            <svg class="theme-icon theme-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="theme-icon theme-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
          <div class="login-link" aria-label="Client greeting">
            <picture class="logo-dark">
              <source srcset="/A1Firm-logo.webp" type="image/webp" />
              <img class="utility-logo" src="/A1Firm-logo.png" alt="" width="16" height="16" />
            </picture>
            <picture class="logo-light">
              <source srcset="/A1Firm-logo_light.webp" type="image/webp" />
              <img class="utility-logo" src="/A1Firm-logo_light.png" alt="" width="16" height="16" />
            </picture>
            <span>{session ? `Hi, ${session.user?.name || 'Minseok'}!` : 'Hi, Client!'}</span>
          </div>
          {session && (
            <SignOut class="logout-button">
              Logout
            </SignOut>
          )}
        </div>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <span>Copyright {currentYear} Minseok Song. Seoul.</span>
        <span>{siteConfig.title}</span>
      </footer>
    </div>
    <A1Chan />
    <script is:inline>
      (() => {
        if (document.body?.dataset.contentProtection !== "enabled") return;

        const selectableSelector = [
          "input",
          "textarea",
          "select",
          "[contenteditable]",
          ".allow-select",
          "[data-allow-selection]"
        ].join(",");

        const getElement = (target) => {
          if (target instanceof Element) return target;
          if (target instanceof Node) return target.parentElement;
          return null;
        };

        const isSelectableTarget = (target) => Boolean(getElement(target)?.closest(selectableSelector));

        const blockDefault = (event) => {
          if (isSelectableTarget(event.target)) return;
          event.preventDefault();
          event.stopPropagation();
        };

        const blockSecondaryPointer = (event) => {
          if (isSelectableTarget(event.target)) return;
          if (event.button === 1 || event.button === 2) {
            event.preventDefault();
            event.stopPropagation();
          }
        };

        ["contextmenu", "selectstart", "dragstart", "drop", "copy", "cut"].forEach((eventName) => {
          document.addEventListener(eventName, blockDefault, { capture: true });
        });

        ["mousedown", "pointerdown", "auxclick"].forEach((eventName) => {
          document.addEventListener(eventName, blockSecondaryPointer, { capture: true });
        });

        document.addEventListener("selectionchange", () => {
          const selection = document.getSelection();
          if (!selection || selection.isCollapsed) return;
          if (isSelectableTarget(selection.anchorNode) || isSelectableTarget(selection.focusNode)) return;
          selection.removeAllRanges();
        });

        document.addEventListener("keydown", (event) => {
          if (isSelectableTarget(event.target)) return;

          const key = event.key.toLowerCase();
          const usesCommand = event.ctrlKey || event.metaKey;
          const blockedShortcut =
            key === "f12" ||
            key === "printscreen" ||
            (usesCommand && ["a", "c", "x", "s", "p", "u"].includes(key)) ||
            (usesCommand && event.shiftKey && ["c", "i", "j"].includes(key));

          if (blockedShortcut) {
            event.preventDefault();
            event.stopPropagation();
          }
        }, { capture: true });

        document.querySelectorAll("img, svg, canvas, video").forEach((element) => {
          element.setAttribute("draggable", "false");
        });
      })();

      document.addEventListener("click", (event) => {
        const link = event.target.closest("a");

        if (!link) return;
        if (link.target || link.hasAttribute("download")) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        const url = new URL(link.href, window.location.href);

        if (url.origin !== window.location.origin) return;
        if (url.pathname === window.location.pathname && url.hash) return;

        event.preventDefault();
        document.body.classList.add("is-exiting");
        window.setTimeout(() => {
          window.location.href = url.href;
        }, 180);
      });

      // Theme toggle functionality
      const themeToggle = document.getElementById('theme-toggle');
      const themeMedia = window.matchMedia('(prefers-color-scheme: dark)');
      const themeSessionKey = 'theme-override';
      const legacyThemeKey = 'theme';
      const isSamsungBrowser = /SamsungBrowser/i.test(navigator.userAgent);
      const samsungSystemSource = 'samsung-system';
      const samsungResyncKey = 'samsung-theme-resync-at';
      const getSystemTheme = () => themeMedia.matches ? 'dark' : 'light';
      let lastKnownSystemTheme = getSystemTheme();
      let lastSamsungBlurAt = 0;

      const clearStoredTheme = () => {
        try { sessionStorage.removeItem(themeSessionKey); } catch {}
        try { localStorage.removeItem(legacyThemeKey); } catch {}
      };

      const getThemeSource = () => document.documentElement.getAttribute('data-theme-source');

      const getEffectiveTheme = () => (
        document.documentElement.getAttribute('data-theme') || getSystemTheme()
      );

      const updateThemeChrome = (theme = getEffectiveTheme()) => {
        themeToggle?.setAttribute('aria-pressed', theme === 'light' ? 'true' : 'false');
        themeToggle?.setAttribute('aria-label', theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');

        const metaThemeColor = document.getElementById('theme-color');
        if (metaThemeColor) {
          metaThemeColor.setAttribute('content', theme === 'dark' ? '#030407' : '#EBEAE4');
        }
      };

      const applySystemTheme = () => {
        const systemTheme = getSystemTheme();
        clearStoredTheme();
        if (isSamsungBrowser) {
          document.documentElement.setAttribute('data-theme', systemTheme);
          document.documentElement.setAttribute('data-theme-source', samsungSystemSource);
        } else {
          document.documentElement.removeAttribute('data-theme');
          document.documentElement.removeAttribute('data-theme-source');
        }
        document.documentElement.style.colorScheme = '';
        updateThemeChrome(systemTheme);
      };

      const setManualTheme = (theme) => {
        clearStoredTheme();
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-theme-source', 'manual');
        document.documentElement.style.colorScheme = '';
        updateThemeChrome(theme);
      };

      applySystemTheme();

      // Live sync with OS
      const syncWithSystem = (e) => {
        const systemTheme = e?.matches ? 'dark' : getSystemTheme();
        lastKnownSystemTheme = systemTheme;
        applySystemTheme();
      };

      const reconcileSystemTheme = () => {
        const systemTheme = getSystemTheme();
        const systemChanged = systemTheme !== lastKnownSystemTheme;
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const themeSource = getThemeSource();
        lastKnownSystemTheme = systemTheme;

        if (
          systemChanged ||
          themeSource !== 'manual' && (
            !currentTheme ||
            isSamsungBrowser && (themeSource !== samsungSystemSource || currentTheme !== systemTheme)
          )
        ) {
          applySystemTheme();
        }
      };

      const resyncSamsungSystemTheme = () => {
        if (!isSamsungBrowser || getThemeSource() === 'manual') return;
        const beforeTheme = getEffectiveTheme();

        window.setTimeout(() => {
          if (document.visibilityState === 'hidden' || getThemeSource() === 'manual') return;

          reconcileSystemTheme();

          const currentTheme = getEffectiveTheme();
          const blurElapsed = Date.now() - lastSamsungBlurAt;
          if (!lastSamsungBlurAt || beforeTheme !== 'light' || currentTheme !== 'light' || blurElapsed < 600) return;

          try {
            const lastReloadAt = Number(sessionStorage.getItem(samsungResyncKey) || '0');
            const now = Date.now();
            if (now - lastReloadAt < 30000) return;
            sessionStorage.setItem(samsungResyncKey, String(now));
          } catch {
            return;
          }

          window.location.reload();
        }, 700);
      };
      
      if (typeof themeMedia.addEventListener === 'function') {
        themeMedia.addEventListener('change', syncWithSystem);
      } else if (typeof themeMedia.addListener === 'function') {
        themeMedia.addListener(syncWithSystem);
      }
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          reconcileSystemTheme();
          resyncSamsungSystemTheme();
        } else if (isSamsungBrowser) {
          lastSamsungBlurAt = Date.now();
        }
      });
      window.addEventListener('blur', () => {
        if (isSamsungBrowser) {
          lastSamsungBlurAt = Date.now();
        }
      });
      window.addEventListener('focus', () => {
        reconcileSystemTheme();
        resyncSamsungSystemTheme();
      });
      window.addEventListener('pageshow', () => {
        reconcileSystemTheme();
        resyncSamsungSystemTheme();
      });
      window.addEventListener('resize', reconcileSystemTheme);
      window.addEventListener('orientationchange', reconcileSystemTheme);
      window.setInterval(reconcileSystemTheme, 750);

      // Toggle theme on button click.
      if (themeToggle) {
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        themeToggle.addEventListener('click', async (event) => {
          const currentTheme = getEffectiveTheme();
          const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
          
          const switchTheme = () => {
            setManualTheme(newTheme);
          };

          if (!document.startViewTransition || reducedMotion.matches) {
            switchTheme();
            return;
          }

          const x = event.clientX;
          const y = event.clientY;
          const endRadius = Math.hypot(
            Math.max(x, innerWidth - x),
            Math.max(y, innerHeight - y)
          );

          document.documentElement.classList.add('is-animating-theme');

          const transition = document.startViewTransition(() => {
            switchTheme();
          });

          transition.ready.then(() => {
            document.documentElement.animate(
              {
                clipPath: [
                  `circle(0px at ${x}px ${y}px)`,
                  `circle(${endRadius}px at ${x}px ${y}px)`
                ]
              },
              {
                duration: 600,
                easing: 'cubic-bezier(0.86, 0, 0.07, 1)',
                pseudoElement: '::view-transition-new(root)'
              }
            );

            document.documentElement.animate(
              {
                filter: [
                  `blur(0px) brightness(1)`,
                  `blur(12px) brightness(1)`
                ]
              },
              {
                duration: 600,
                easing: 'cubic-bezier(0.86, 0, 0.07, 1)',
                pseudoElement: '::view-transition-old(root)'
              }
            );
          });

          transition.finished.finally(() => {
            document.documentElement.classList.remove('is-animating-theme');
          });
        });
      }

      // Nav Indicator sliding logic
      const initNavIndicator = () => {
        const nav = document.querySelector('.numbered-nav');
        const indicator = document.getElementById('nav-indicator');
        if (!nav || !indicator) return;

        const items = nav.querySelectorAll('a');
        const activeItem = nav.querySelector('a[aria-current="page"]');

        const updateIndicator = (targetLink) => {
          if (!targetLink) {
            indicator.style.opacity = '0';
            return;
          }
          
          const label = targetLink.querySelector('.nav-label');
          if (!label) return;

          const navRect = nav.getBoundingClientRect();
          const labelRect = label.getBoundingClientRect();

          indicator.style.width = `${labelRect.width}px`;
          indicator.style.left = `${labelRect.left - navRect.left}px`;
          indicator.style.opacity = '1';
        };

        // Initialize position reliably without magic number delays
        const initializePosition = () => {
          if (!indicator) return;
          
          // Disable transition for initial placement to avoid sliding from 0
          indicator.style.transition = 'none';
          updateIndicator(activeItem);
          
          // Restore transition after the next frame when layout is committed
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              indicator.style.transition = '';
            });
          });
        };

        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(initializePosition);
        } else {
          window.addEventListener('load', initializePosition);
        }

        // Dynamic hover bindings
        items.forEach(item => {
          item.addEventListener('mouseenter', () => updateIndicator(item));
        });

        nav.addEventListener('mouseleave', () => {
          updateIndicator(activeItem);
        });

        // Update on window resize to keep position correct
        window.addEventListener('resize', () => {
          const currentActive = nav.querySelector('a[aria-current="page"]');
          updateIndicator(currentActive);
        });
      };

      initNavIndicator();

      // Global Scroll Reveal Observer
      const observerOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.15
      };
      
      const scrollObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            // Optional: stop observing once visible to run only once
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      // Run initially and whenever DOM changes (useful for Astro client-side navigation if added later)
      const initScrollObserver = () => {
        document.querySelectorAll('.reveal-up, .reveal-in').forEach(el => {
          scrollObserver.observe(el);
        });
      };
      
      initScrollObserver();
    </script>
  </body>
</html>
