---
import Layout from "../layouts/Layout.astro";
import HeroSystem from "../components/ui/HeroSystem.astro";
import OperatingLoop from "../components/ui/OperatingLoop.astro";
import SurfaceGrid from "../components/ui/SurfaceGrid.astro";
import TechToolsRail from "../components/ui/TechToolsRail.astro";
import { visibleNavigationItems } from "../config/navigation";
import { siteConfig } from "../config/site";
import { pageEntriesById } from "../lib/content/registry";

const nav = visibleNavigationItems();
const a1Firms = pageEntriesById.get("a1-firms");

const surfaceMeta = {
  about: {
    glyph: "MS",
    line: "Person"
  },
  "a1-firms": {
    glyph: "A1",
    line: "Firm"
  },
  projects: {
    glyph: "PX",
    line: "Work"
  },
  contacts: {
    glyph: "CO",
    line: "Reach"
  }
};

const sectionCards = nav
  .filter((item) => item.id !== "home")
  .map((item) => {
    const page = pageEntriesById.get(item.contentEntry);

    return {
      ...item,
      page,
      meta: surfaceMeta[item.id] ?? surfaceMeta.about
    };
  });

const signalLoop = [
  {
    num: "01",
    title: "Brief",
    copy: "Condense ambiguous context into a useful operating question."
  },
  {
    num: "02",
    title: "Model",
    copy: "Shape the question into prompts, schemas, constraints, and review loops."
  },
  {
    num: "03",
    title: "Surface",
    copy: "Turn the work into a product view, document, deck, or reusable workflow."
  },
  {
    num: "04",
    title: "Archive",
    copy: "Keep the reasoning trace visible so the firm gets sharper over time."
  }
];

const focusStats = [
  ["Firm", "Minseok Song & Company"],
  ["Industry", "Technology Strategy & Consulting"],
  ["Product", "A1trategize"]
];
---

<Layout
  title={siteConfig.title}
  description={siteConfig.description}
  headerNote="A1 Firms / Seoul"
>
  <section class="home-page">
    <div class="reveal-up"><HeroSystem a1Firms={a1Firms} focusStats={focusStats} siteConfig={siteConfig} /></div>

    <div class="reveal-up stagger-1"><TechToolsRail /></div>

    <div class="reveal-up stagger-2"><OperatingLoop signalLoop={signalLoop} /></div>

    <div class="reveal-up stagger-3"><SurfaceGrid sectionCards={sectionCards} /></div>

    <section id="product-band" class="product-band reveal-up stagger-4" aria-label="A1trategize">
      <div class="band-content">
        <p class="micro-label">Flagship product</p>
        <h2>{a1Firms?.hero?.title ?? "A1trategize"}</h2>
        <div class="band-rule"></div>
      </div>
      <div class="band-desc">
        <p>
          A1trategize remains the working application surface. This site gives it
          a sharper public layer: context, proof, writing, and product memory.
        </p>
      </div>
      <div class="band-action">
        <a class="primary-action" href={siteConfig.a1FirmsPath}>
          Enter product
          <svg class="arrow-shifted" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </section>
  </section>
</Layout>

<style>
  .home-page {
    background: transparent;
    color: var(--color-ink);
  }

  .home-page :global(.micro-label) {
    color: var(--color-ink-muted);
  }

  .product-band {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 48px;
    align-items: center;
    padding: 64px 56px;
    margin: 0 auto 112px;
    width: calc(100% - (var(--space-page) * 2));
    max-width: calc(var(--max-site) - (var(--space-page) * 2));
    border-radius: var(--radius-lg);
    background: var(--color-panel);
    border: 1px solid var(--glass-border);
    box-shadow: 0 12px 32px var(--glass-shadow);
    backdrop-filter: var(--glass-blur);
    position: relative;
    overflow: hidden;
    z-index: 1;
    transition: border-color var(--motion-base) ease, box-shadow var(--motion-base) ease;
  }

  .product-band:hover {
    border-color: var(--color-line-strong);
    box-shadow: 0 24px 48px var(--glass-shadow);
  }

  .band-content {
    flex: 1 1 280px;
  }

  .product-band .micro-label {
    margin: 0 0 12px 0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--color-ink-muted);
    text-transform: uppercase;
  }

  .product-band h2 {
    margin: 0 0 20px 0;
    font-size: clamp(3.5rem, 6vw, 6rem);
    font-weight: 850;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--color-ink);
    font-family: var(--font-sans);
  }

  .band-rule {
    width: 64px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
  }

  .band-desc {
    flex: 1 1 320px;
  }

  .product-band p:not(.micro-label) {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.65;
    font-size: 15px;
    max-width: 440px;
  }

  .band-action {
    flex: 0 0 auto;
  }

  .primary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 28px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    color: var(--color-paper-deep);
    background: var(--color-ink);
    border: 1px solid transparent;
  }

  .primary-action .arrow-shifted {
    width: 16px;
    height: 16px;
    margin-left: 8px;
    transition: transform var(--motion-fast) var(--easing-smooth);
  }

  .primary-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15);
    background: transparent;
    color: var(--color-ink);
    border-color: var(--color-ink);
  }

  .primary-action:hover .arrow-shifted {
    transform: translateX(4px);
  }

  .fade-in-up {
    animation: fadeInUp 0.8s var(--easing-smooth) both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1180px) {
    .product-band {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
      padding: 48px;
    }

    .band-content,
    .band-desc,
    .band-action {
      flex: 1 1 100%;
      width: 100%;
    }

    .band-action {
      margin-top: 8px;
    }
  }

  @media (max-width: 640px) {
    .product-band {
      padding: 40px 32px;
    }
    .product-band h2 {
      font-size: 3.1rem;
    }
  }
</style>
