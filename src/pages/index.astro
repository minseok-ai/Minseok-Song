---
import Layout from "../layouts/Layout.astro";
import HeroSystem from "../components/ui/HeroSystem.astro";
import OperatingLoop from "../components/ui/OperatingLoop.astro";
import SurfaceGrid from "../components/ui/SurfaceGrid.astro";
import { visibleNavigationItems } from "../config/navigation";
import { siteConfig } from "../config/site";
import { pageEntriesById } from "../lib/content/registry";

const nav = visibleNavigationItems();
const a1Firms = pageEntriesById.get("a1-firms");

const surfaceMeta = {
  about: {
    glyph: "MS",
    line: "Person"
  },
  "a1-firms": {
    glyph: "A1",
    line: "Firm"
  },
  projects: {
    glyph: "PX",
    line: "Work"
  },
  writings: {
    glyph: "WR",
    line: "Notes"
  },
  contacts: {
    glyph: "CO",
    line: "Reach"
  }
};

const sectionCards = nav
  .filter((item) => item.id !== "home")
  .map((item) => {
    const page = pageEntriesById.get(item.contentEntry);

    return {
      ...item,
      page,
      meta: surfaceMeta[item.id] ?? surfaceMeta.about
    };
  });

const signalLoop = [
  {
    num: "01",
    title: "Brief",
    copy: "Condense ambiguous context into a useful operating question."
  },
  {
    num: "02",
    title: "Model",
    copy: "Shape the question into prompts, schemas, constraints, and review loops."
  },
  {
    num: "03",
    title: "Surface",
    copy: "Turn the work into a product view, document, deck, or reusable workflow."
  },
  {
    num: "04",
    title: "Archive",
    copy: "Keep the reasoning trace visible so the firm gets sharper over time."
  }
];

const focusStats = [
  ["Domain", "Strategy systems"],
  ["Product", "A1trategize"],
  ["Mode", "Research to operating surface"]
];
---

<Layout
  title={siteConfig.title}
  description={siteConfig.description}
  headerNote="A1 Firms / Seoul"
>
  <section class="home-page">
    <div class="reveal-up"><HeroSystem a1Firms={a1Firms} focusStats={focusStats} siteConfig={siteConfig} /></div>
    
    <div class="reveal-up stagger-1"><OperatingLoop signalLoop={signalLoop} /></div>
    
    <div class="reveal-up stagger-2"><SurfaceGrid sectionCards={sectionCards} /></div>

    <section id="product-band" class="product-band reveal-up stagger-3" aria-label="A1trategize">
      <div class="band-grid-bg" aria-hidden="true"></div>
      <div>
        <p class="micro-label">Flagship product</p>
        <h2>{a1Firms?.hero?.title ?? "A1trategize"}</h2>
      </div>
      <p>
        A1trategize remains the working application surface. This site gives it
        a sharper public layer: context, proof, writing, and product memory.
      </p>
      <a class="primary-action" href={siteConfig.a1FirmPath}>
        Enter product
        <svg class="arrow-shifted" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </section>
  </section>
</Layout>

<script is:inline>
  const productBand = document.getElementById('product-band');
  if (productBand) {
    productBand.addEventListener('mousemove', (e) => {
      const rect = productBand.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      
      const rotateX = ((y - centerY) / centerY) * -4;
      const rotateY = ((x - centerX) / centerX) * 4;
      
      // We keep the translateY(-3px) from the hover effect and add perspective
      productBand.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.01, 1.01, 1.01)`;
    });
    
    productBand.addEventListener('mouseleave', () => {
      productBand.style.transform = '';
      productBand.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.6s ease, box-shadow 0.6s ease';
    });
    
    productBand.addEventListener('mouseenter', () => {
      productBand.style.transition = 'border-color 0.6s ease, box-shadow 0.6s ease';
    });
  }
</script>

<style>
  .home-page {
    background: transparent;
    color: var(--color-ink);
  }

  .home-page :global(.micro-label) {
    color: var(--color-ink-muted);
  }

  .product-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.72fr) auto;
    gap: 48px;
    align-items: center;
    padding: 64px 48px;
    margin: 0 auto 112px;
    width: min(calc(100% - 48px), var(--max-site));
    border-radius: var(--radius-lg);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: 
      inset 0 1px 0 var(--glass-border),
      0 24px 60px var(--glass-shadow),
      0 0 0 1px var(--color-accent-soft);
    backdrop-filter: blur(24px);
    position: relative;
    overflow: hidden;
    transition: transform 0.6s var(--easing-spring), border-color 0.6s ease, box-shadow 0.6s ease;
    z-index: 1;
  }

  .product-band > div:not(.band-grid-bg) {
    grid-column: 1;
    grid-row: 1;
  }

  .product-band > p {
    grid-column: 2;
    grid-row: 1;
  }

  .product-band > .primary-action {
    grid-column: 3;
    grid-row: 1;
  }

  .product-band:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent-soft);
    box-shadow: 
      inset 0 1px 0 var(--glass-border),
      0 32px 80px var(--glass-shadow),
      0 0 0 1px var(--color-accent);
  }

  .band-grid-bg {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(90deg, rgba(255, 255, 255, 0.01) 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.01) 1px, transparent 1px);
    background-size: 48px 48px;
    background-position: center;
    mask-image: radial-gradient(circle at 15% 50%, black 10%, rgba(0, 0, 0, 0.1) 85%);
    -webkit-mask-image: radial-gradient(circle at 15% 50%, black 10%, rgba(0, 0, 0, 0.1) 85%);
    z-index: 0;
    pointer-events: none;
    opacity: 0.4;
    animation: gridFloat 20s ease-in-out infinite;
  }

  @keyframes gridFloat {
    0%, 100% { background-position: center; }
    50% { background-position: 52px 52px; }
  }

  .product-band::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 100%;
    background: linear-gradient(180deg, transparent, var(--color-accent), transparent);
    pointer-events: none;
    z-index: 0;
    opacity: 0.72;
  }

  .product-band::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.15) 0%, transparent 50%, rgba(255, 255, 255, 0.05) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    transition: background var(--motion-base) ease;
    pointer-events: none;
    z-index: 1;
  }

  .product-band:hover::after {
    background: linear-gradient(135deg, rgba(107, 156, 242, 0.5) 0%, transparent 60%, rgba(255, 255, 255, 0.2) 100%);
  }

  .product-band h2 {
    margin: 12px 0 0;
    font-size: 5.2rem;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.02em;
    background: linear-gradient(180deg, var(--color-ink) 0%, var(--color-ink-soft) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
    z-index: 2;
  }

  .product-band h2::after {
    content: "";
    display: block;
    width: 58px;
    height: 2px;
    margin-top: 20px;
    background: linear-gradient(90deg, var(--color-accent), transparent);
  }

  .product-band p {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.7;
    font-size: 16px;
    max-width: 480px;
    position: relative;
    z-index: 2;
  }

  .primary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 32px;
    border-radius: var(--radius-lg);
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid var(--glass-border);
    color: var(--color-paper-deep);
    background: var(--color-ink);
    box-shadow: 
      0 8px 20px var(--glass-shadow),
      0 0 0 1px var(--color-accent-soft);
    position: relative;
    z-index: 2;
  }

  .primary-action .arrow-shifted {
    width: 16px;
    height: 16px;
    margin-left: 8px;
    transition: transform var(--motion-fast) var(--easing-smooth);
    display: inline-block;
  }

  .primary-action:hover {
    transform: translateY(-2px);
    box-shadow: 
      0 12px 30px var(--glass-shadow),
      0 0 0 1px var(--color-accent);
  }

  .primary-action:hover .arrow-shifted {
    transform: translateX(4px);
  }

  .fade-in-up {
    animation: fadeInUp 0.8s var(--easing-smooth) both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1180px) {
    .product-band {
      grid-template-columns: 1fr;
      align-items: start;
    }
    
    .product-band > div:not(.band-grid-bg) {
      grid-column: auto;
      grid-row: auto;
    }

    .product-band > p {
      grid-column: auto;
      grid-row: auto;
    }

    .product-band > .primary-action {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 640px) {
    .product-band h2 {
      font-size: 3.1rem;
    }
  }
</style>
