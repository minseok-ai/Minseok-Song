---
import Layout from "../layouts/Layout.astro";
import { visibleNavigationItems } from "../config/navigation";
import { siteConfig } from "../config/site";
import { pageEntriesById } from "../lib/content/registry";

const nav = visibleNavigationItems();
const a1Firms = pageEntriesById.get("a1-firms");

const surfaceMeta = {
  about: {
    accent: "#8ab4f8",
    glyph: "MS",
    line: "Person"
  },
  "a1-firms": {
    accent: "#fbbc04",
    glyph: "A1",
    line: "Firm"
  },
  projects: {
    accent: "#34a853",
    glyph: "PX",
    line: "Work"
  },
  writings: {
    accent: "#f28b82",
    glyph: "WR",
    line: "Notes"
  },
  contacts: {
    accent: "#a78bfa",
    glyph: "CO",
    line: "Reach"
  }
};

const sectionCards = nav.map((item) => {
  const page = pageEntriesById.get(item.contentEntry);

  return {
    ...item,
    page,
    meta: surfaceMeta[item.id] ?? surfaceMeta.about
  };
});

const signalLoop = [
  {
    num: "01",
    title: "Brief",
    copy: "Condense ambiguous context into a useful operating question."
  },
  {
    num: "02",
    title: "Model",
    copy: "Shape the question into prompts, schemas, constraints, and review loops."
  },
  {
    num: "03",
    title: "Surface",
    copy: "Turn the work into a product view, document, deck, or reusable workflow."
  },
  {
    num: "04",
    title: "Archive",
    copy: "Keep the reasoning trace visible so the firm gets sharper over time."
  }
];
---

<Layout
  title={siteConfig.title}
  description={siteConfig.description}
  headerNote="A1 Firms / Seoul"
>
  <section class="home-page">
    <section class="hero-system" aria-label="A1 Firms overview">
      <div class="hero-copy-panel">
        <p class="micro-label">Minseok Song / A1 Firms</p>
        <h1>
          Strategy systems for
          <span>AI-native</span>
          firms.
        </h1>
        <p>
          A public operating layer for A1trategize, selected work, field notes,
          and the strategic intelligence loop behind them.
        </p>
        <div class="hero-actions" aria-label="Primary actions">
          <a class="primary-action" href={siteConfig.a1FirmPath}>Open A1trategize</a>
          <a class="secondary-action" href="#surfaces">Explore surfaces</a>
        </div>
      </div>

      <div class="signal-lab" aria-hidden="true">
        <div class="lab-grid"></div>
        <svg class="signal-lines" viewBox="0 0 620 520">
          <path class="line-blue" d="M72 338 C154 252, 228 380, 318 262 S486 158, 556 246" />
          <path class="line-green" d="M62 212 C164 134, 244 198, 318 166 S458 104, 580 128" />
          <path class="line-red" d="M88 408 C190 436, 244 336, 350 374 S486 442, 572 330" />
          <circle cx="72" cy="338" r="7" />
          <circle cx="318" cy="262" r="10" />
          <circle cx="556" cy="246" r="7" />
          <circle cx="318" cy="166" r="7" />
          <circle cx="350" cy="374" r="8" />
        </svg>
        <div class="lab-card card-brief">
          <span>01</span>
          <strong>Brief</strong>
        </div>
        <div class="lab-card card-model">
          <span>02</span>
          <strong>Model</strong>
        </div>
        <div class="lab-card card-firm">
          <span>03</span>
          <strong>A1</strong>
        </div>
        <div class="lab-card card-ship">
          <span>04</span>
          <strong>Ship</strong>
        </div>
        <div class="lab-core">
          <span>A1</span>
        </div>
      </div>

      <nav class="hero-index" aria-label="Quick site sections">
        {sectionCards.map((item) => (
          <a href={item.path} style={`--accent: ${item.meta.accent};`}>
            <span>{item.num}</span>
            <strong>{item.label}</strong>
          </a>
        ))}
      </nav>
    </section>

    <section class="loop-section" aria-label="Operating loop">
      <div class="section-head">
        <p class="micro-label">Operating loop</p>
        <h2>From signal to surface, without losing the reasoning trace.</h2>
      </div>

      <div class="loop-grid">
        {signalLoop.map((step) => (
          <article>
            <span>{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="surfaces" class="surface-index" aria-label="Site index">
      <div class="section-head">
        <p class="micro-label">Surfaces</p>
        <h2>Five public surfaces around one working product.</h2>
      </div>

      <div class="surface-grid">
        {sectionCards.map((item) => (
          <a
            class="surface-card"
            href={item.path}
            style={`--accent: ${item.meta.accent};`}
          >
            <span class="surface-num">{item.num}</span>
            <span class="surface-glyph">{item.meta.glyph}</span>
            <div>
              <small>{item.meta.line}</small>
              <h3>{item.label}</h3>
              <p>{item.page?.description ?? item.layoutType}</p>
            </div>
            <span class="surface-command">
              {item.id === "a1-firms" ? "Launch product" : "Open section"}
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="product-band" aria-label="A1trategize">
      <div>
        <p class="micro-label">Flagship product</p>
        <h2>{a1Firms?.hero?.title ?? "A1trategize"}</h2>
      </div>
      <p>
        A1trategize remains the working application surface. This site gives it
        a sharper public layer: context, proof, writing, and product memory.
      </p>
      <a class="primary-action" href={siteConfig.a1FirmPath}>Enter product</a>
    </section>
  </section>
</Layout>

<script is:inline>
  const lab = document.querySelector(".signal-lab");

  if (lab && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    lab.addEventListener("pointermove", (event) => {
      const rect = lab.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      lab.style.setProperty("--tilt-x", `${(y * -6).toFixed(2)}deg`);
      lab.style.setProperty("--tilt-y", `${(x * 8).toFixed(2)}deg`);
      lab.style.setProperty("--shift-x", `${(x * 18).toFixed(1)}px`);
      lab.style.setProperty("--shift-y", `${(y * 18).toFixed(1)}px`);
    });

    lab.addEventListener("pointerleave", () => {
      lab.style.removeProperty("--tilt-x");
      lab.style.removeProperty("--tilt-y");
      lab.style.removeProperty("--shift-x");
      lab.style.removeProperty("--shift-y");
    });
  }
</script>

<style>
  .home-page {
    --paper: #050505;
    --ink: #f8f7f2;
    --muted: rgba(248, 247, 242, 0.62);
    --line: rgba(248, 247, 242, 0.16);
    background: var(--paper);
    color: var(--ink);
  }

  .home-page :global(.micro-label) {
    color: rgba(248, 247, 242, 0.56);
  }

  .hero-system,
  .loop-section,
  .surface-index,
  .product-band {
    width: min(100%, var(--max-site));
    margin: 0 auto;
    padding-right: var(--space-page);
    padding-left: var(--space-page);
  }

  .hero-system {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.78fr);
    grid-template-rows: 1fr auto;
    gap: 42px 62px;
    min-height: calc(100svh - var(--header-height));
    padding-top: 56px;
    padding-bottom: 28px;
    overflow: hidden;
  }

  .hero-system::before {
    content: "";
    position: absolute;
    inset: 0 var(--space-page) auto;
    height: 1px;
    background: linear-gradient(90deg, #4285f4, #34a853, #fbbc04, #ea4335);
    opacity: 0.68;
  }

  .hero-copy-panel {
    position: relative;
    z-index: 2;
    align-self: center;
    max-width: 800px;
  }

  .hero-copy-panel h1 {
    margin: 18px 0 22px;
    font-size: 8.2rem;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.88;
  }

  .hero-copy-panel h1 span {
    display: inline-block;
    color: transparent;
    background: linear-gradient(100deg, #8ab4f8 0%, #34a853 36%, #fbbc04 68%, #ea4335 100%);
    background-clip: text;
    -webkit-background-clip: text;
  }

  .hero-copy-panel p:not(.micro-label) {
    max-width: 650px;
    margin: 0;
    color: rgba(248, 247, 242, 0.7);
    font-size: 18px;
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 850;
    text-decoration: none;
    transition:
      transform var(--motion-fast) ease,
      background var(--motion-fast) ease,
      border-color var(--motion-fast) ease;
  }

  .primary-action {
    border: 1px solid var(--ink);
    color: var(--paper);
    background: var(--ink);
  }

  .secondary-action {
    border: 1px solid rgba(248, 247, 242, 0.22);
    color: var(--ink);
    background: rgba(248, 247, 242, 0.055);
  }

  .primary-action:hover,
  .secondary-action:hover {
    transform: translateY(-2px);
  }

  .signal-lab {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --shift-x: 0px;
    --shift-y: 0px;
    position: relative;
    z-index: 1;
    align-self: center;
    min-height: 580px;
    transform: rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transform-style: preserve-3d;
    transition: transform var(--motion-base) ease;
  }

  .lab-grid {
    position: absolute;
    inset: 11% 3% 12% 5%;
    border: 1px solid rgba(248, 247, 242, 0.12);
    background:
      linear-gradient(90deg, rgba(248, 247, 242, 0.07) 1px, transparent 1px),
      linear-gradient(180deg, rgba(248, 247, 242, 0.055) 1px, transparent 1px);
    background-size: 64px 100%, 100% 64px;
    transform: skewY(-6deg) translate3d(calc(var(--shift-x) * -0.3), calc(var(--shift-y) * -0.3), -20px);
    opacity: 0.44;
  }

  .signal-lines {
    position: absolute;
    inset: 3% 0 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: translate3d(calc(var(--shift-x) * 0.35), calc(var(--shift-y) * 0.35), 50px);
  }

  .signal-lines path {
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.9;
    stroke-dasharray: 760;
    animation: traceSignal 6s ease-in-out infinite;
  }

  .signal-lines circle {
    fill: #f8f7f2;
    stroke: #050505;
    stroke-width: 4;
  }

  .line-blue {
    stroke: #8ab4f8;
  }

  .line-green {
    stroke: #34a853;
    animation-delay: -1.8s;
  }

  .line-red {
    stroke: #f28b82;
    animation-delay: -3.2s;
  }

  .lab-card {
    position: absolute;
    display: grid;
    align-content: space-between;
    width: 178px;
    height: 224px;
    padding: 18px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 22px;
    color: rgba(5, 5, 5, 0.88);
    box-shadow:
      0 36px 86px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.46);
    transform-style: preserve-3d;
    animation: labFloat 8s ease-in-out infinite;
  }

  .lab-card span {
    font-size: 12px;
    font-weight: 900;
    opacity: 0.56;
  }

  .lab-card strong {
    font-size: 30px;
    font-weight: 900;
    line-height: 1;
  }

  .card-brief {
    left: 4%;
    top: 42%;
    background: linear-gradient(135deg, #8ab4f8, #7ee0cf);
    transform: rotateY(-30deg) rotateZ(-4deg);
  }

  .card-model {
    left: 28%;
    top: 20%;
    background: linear-gradient(135deg, #fdd663, #b7e088);
    transform: rotateY(-14deg) rotateZ(3deg);
    animation-delay: -1.4s;
  }

  .card-firm {
    right: 15%;
    top: 29%;
    background: linear-gradient(135deg, #f28b82, #fbbc04);
    transform: rotateY(16deg) rotateZ(-3deg);
    animation-delay: -2.6s;
  }

  .card-ship {
    right: 3%;
    bottom: 17%;
    background: linear-gradient(135deg, #34a853, #8ab4f8);
    transform: rotateY(32deg) rotateZ(4deg);
    animation-delay: -3.8s;
  }

  .lab-core {
    position: absolute;
    left: 48%;
    top: 48%;
    display: grid;
    place-items: center;
    width: 126px;
    height: 126px;
    border: 1px solid rgba(248, 247, 242, 0.3);
    border-radius: 999px;
    color: var(--ink);
    background: rgba(5, 5, 5, 0.72);
    box-shadow:
      0 0 0 10px rgba(248, 247, 242, 0.045),
      0 0 52px rgba(138, 180, 248, 0.28);
    transform: translate(-50%, -50%) translate3d(var(--shift-x), var(--shift-y), 80px);
  }

  .lab-core span {
    font-size: 42px;
    font-weight: 900;
  }

  .hero-index {
    z-index: 2;
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    border-top: 1px solid var(--line);
  }

  .hero-index a {
    display: grid;
    gap: 8px;
    padding: 16px 0 0;
    color: rgba(248, 247, 242, 0.62);
    text-decoration: none;
    transition: color var(--motion-fast) ease;
  }

  .hero-index a:hover {
    color: var(--accent);
  }

  .hero-index span {
    font-size: 11px;
    font-weight: 850;
  }

  .hero-index strong {
    color: var(--ink);
    font-size: 15px;
  }

  .loop-section,
  .surface-index {
    display: grid;
    gap: 20px;
    padding-top: 104px;
    padding-bottom: 92px;
    border-top: 1px solid rgba(248, 247, 242, 0.12);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: end;
    border-bottom: 1px solid rgba(248, 247, 242, 0.2);
    padding-bottom: 16px;
  }

  .section-head h2 {
    max-width: 620px;
    margin: 0;
    color: rgba(248, 247, 242, 0.68);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.5;
    text-align: right;
  }

  .loop-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-left: 1px solid var(--line);
  }

  .loop-grid article {
    min-height: 300px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .loop-grid span,
  .surface-num {
    color: rgba(248, 247, 242, 0.48);
    font-size: 12px;
    font-weight: 850;
  }

  .loop-grid h3 {
    margin: 84px 0 14px;
    font-size: 3.2rem;
    font-weight: 900;
    line-height: 0.95;
  }

  .loop-grid p {
    margin: 0;
    color: rgba(248, 247, 242, 0.62);
    font-size: 14px;
    line-height: 1.64;
  }

  .surface-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .surface-card {
    position: relative;
    display: grid;
    align-content: space-between;
    min-height: 330px;
    padding: 24px;
    overflow: hidden;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--accent) 18%, transparent), transparent 44%),
      #050505;
    text-decoration: none;
    transition:
      background var(--motion-base) ease,
      color var(--motion-base) ease,
      transform var(--motion-fast) ease;
  }

  .surface-card:nth-child(1),
  .surface-card:nth-child(2) {
    grid-column: span 3;
  }

  .surface-card:nth-child(n + 3) {
    grid-column: span 2;
  }

  .surface-card::after {
    content: "";
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 162px;
    height: 112px;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    opacity: 0.15;
    transform: skewY(-8deg);
  }

  .surface-glyph {
    position: absolute;
    top: 20px;
    right: 22px;
    color: var(--accent);
    font-size: 42px;
    font-weight: 900;
    line-height: 1;
    opacity: 0.86;
  }

  .surface-card small {
    color: var(--accent);
    font-size: 12px;
    font-weight: 850;
    text-transform: uppercase;
  }

  .surface-card h3 {
    margin: 10px 0 12px;
    font-size: 3rem;
    font-weight: 900;
    line-height: 0.98;
  }

  .surface-card p {
    max-width: 470px;
    margin: 0;
    color: rgba(248, 247, 242, 0.64);
    font-size: 15px;
    line-height: 1.62;
  }

  .surface-command {
    color: rgba(248, 247, 242, 0.58);
    font-size: 12px;
    font-weight: 850;
    text-transform: uppercase;
  }

  .surface-card:hover {
    color: #050505;
    background: var(--ink);
    transform: translateY(-3px);
  }

  .surface-card:hover p,
  .surface-card:hover .surface-command,
  .surface-card:hover .surface-num {
    color: rgba(5, 5, 5, 0.68);
  }

  .product-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.72fr) auto;
    gap: 36px;
    align-items: end;
    padding-top: 54px;
    padding-bottom: 112px;
    border-top: 1px solid rgba(248, 247, 242, 0.16);
  }

  .product-band h2 {
    margin: 10px 0 0;
    font-size: 5.6rem;
    font-weight: 900;
    line-height: 0.92;
  }

  .product-band p {
    margin: 0;
    color: rgba(248, 247, 242, 0.68);
    line-height: 1.65;
  }

  @keyframes traceSignal {
    0%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0.62;
    }

    50% {
      stroke-dashoffset: -220;
      opacity: 1;
    }
  }

  @keyframes labFloat {
    0%,
    100% {
      translate: 0 0;
    }

    50% {
      translate: 0 -14px;
    }
  }

  @media (max-width: 1180px) {
    .hero-system,
    .product-band {
      grid-template-columns: 1fr;
    }

    .hero-copy-panel h1 {
      font-size: 6.2rem;
    }

    .signal-lab {
      min-height: 480px;
    }

    .loop-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-band {
      align-items: start;
    }
  }

  @media (max-width: 820px) {
    .hero-system {
      min-height: auto;
      padding-top: 42px;
    }

    .hero-copy-panel h1 {
      font-size: 4.25rem;
    }

    .hero-index,
    .loop-grid,
    .surface-grid {
      grid-template-columns: 1fr;
    }

    .surface-card:nth-child(1),
    .surface-card:nth-child(2),
    .surface-card:nth-child(n + 3) {
      grid-column: auto;
    }

    .section-head {
      display: grid;
      align-items: start;
    }

    .section-head h2 {
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .hero-copy-panel h1 {
      font-size: 3.15rem;
    }

    .hero-copy-panel p:not(.micro-label) {
      font-size: 16px;
    }

    .hero-actions {
      display: grid;
    }

    .signal-lab {
      min-height: 360px;
      margin-top: 12px;
    }

    .lab-grid {
      inset: 12% 0 10%;
    }

    .lab-card {
      width: 110px;
      height: 146px;
      padding: 12px;
      border-radius: 16px;
    }

    .lab-card strong {
      font-size: 22px;
    }

    .card-model {
      left: 22%;
    }

    .card-firm {
      right: 18%;
    }

    .card-ship {
      right: 2%;
    }

    .lab-core {
      width: 84px;
      height: 84px;
    }

    .lab-core span {
      font-size: 28px;
    }

    .loop-grid article {
      min-height: 230px;
    }

    .loop-grid h3 {
      margin-top: 56px;
      font-size: 2.45rem;
    }

    .surface-card {
      min-height: 278px;
    }

    .surface-card h3 {
      font-size: 2.35rem;
    }

    .product-band h2 {
      font-size: 3.1rem;
    }
  }
</style>
