---
import Layout from "../layouts/Layout.astro";
import HeroSystem from "../components/ui/HeroSystem.astro";
import OperatingLoop from "../components/ui/OperatingLoop.astro";
import SurfaceGrid from "../components/ui/SurfaceGrid.astro";
import { visibleNavigationItems } from "../config/navigation";
import { siteConfig } from "../config/site";
import { pageEntriesById } from "../lib/content/registry";

const nav = visibleNavigationItems();
const a1Firms = pageEntriesById.get("a1-firms");

const surfaceMeta = {
  about: {
    accent: "var(--color-blue)",
    glyph: "MS",
    line: "Person"
  },
  "a1-firms": {
    accent: "var(--color-warm)",
    glyph: "A1",
    line: "Firm"
  },
  projects: {
    accent: "var(--color-green)",
    glyph: "PX",
    line: "Work"
  },
  writings: {
    accent: "#c98278",
    glyph: "WR",
    line: "Notes"
  },
  contacts: {
    accent: "#947bd4",
    glyph: "CO",
    line: "Reach"
  }
};

const sectionCards = nav.map((item) => {
  const page = pageEntriesById.get(item.contentEntry);

  return {
    ...item,
    page,
    meta: surfaceMeta[item.id] ?? surfaceMeta.about
  };
});

const signalLoop = [
  {
    num: "01",
    title: "Brief",
    copy: "Condense ambiguous context into a useful operating question."
  },
  {
    num: "02",
    title: "Model",
    copy: "Shape the question into prompts, schemas, constraints, and review loops."
  },
  {
    num: "03",
    title: "Surface",
    copy: "Turn the work into a product view, document, deck, or reusable workflow."
  },
  {
    num: "04",
    title: "Archive",
    copy: "Keep the reasoning trace visible so the firm gets sharper over time."
  }
];

const focusStats = [
  ["Domain", "Strategy systems"],
  ["Product", "A1trategize"],
  ["Mode", "Research to operating surface"]
];
---

<Layout
  title={siteConfig.title}
  description={siteConfig.description}
  headerNote="A1 Firms / Seoul"
>
  <section class="home-page">
    <HeroSystem a1Firms={a1Firms} focusStats={focusStats} siteConfig={siteConfig} />
    
    <OperatingLoop signalLoop={signalLoop} />
    
    <SurfaceGrid sectionCards={sectionCards} />

    <section class="product-band fade-in-up" aria-label="A1trategize">
      <div>
        <p class="micro-label">Flagship product</p>
        <h2>{a1Firms?.hero?.title ?? "A1trategize"}</h2>
      </div>
      <p>
        A1trategize remains the working application surface. This site gives it
        a sharper public layer: context, proof, writing, and product memory.
      </p>
      <a class="primary-action" href={siteConfig.a1FirmPath}>Enter product</a>
    </section>
  </section>
</Layout>

<style>
  .home-page {
    background: transparent;
    color: var(--color-ink);
  }

  .home-page :global(.micro-label) {
    color: var(--color-ink-muted);
  }

  .product-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.72fr) auto;
    gap: 36px;
    align-items: end;
    padding-top: 54px;
    padding-bottom: 112px;
    border-top: 1px solid var(--color-line);
    width: min(100%, var(--max-site));
    margin: 0 auto;
    padding-right: var(--space-page);
    padding-left: var(--space-page);
  }

  .product-band h2 {
    margin: 10px 0 0;
    font-size: 5.6rem;
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .product-band p {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.65;
  }

  .primary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all var(--motion-fast) var(--easing-spring);
    border: 1px solid var(--color-ink);
    color: var(--color-paper-deep);
    background: var(--color-ink);
  }

  .primary-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 255, 255, 0.12);
  }

  .fade-in-up {
    animation: fadeInUp 0.8s var(--easing-smooth) both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1180px) {
    .product-band {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 640px) {
    .product-band h2 {
      font-size: 3.1rem;
    }
  }
</style>
