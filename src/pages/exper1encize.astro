---
import { getSession } from 'auth-astro/server';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import { SignIn, SignOut } from 'auth-astro/components';

const session = await getSession(Astro.request);
const adminUsername = import.meta.env.ADMIN_GITHUB_USERNAME || process.env.ADMIN_GITHUB_USERNAME;

let isAuthorizedAdmin = false;
if (session && session.user) {
  // Check if the logged-in user matches the admin username.
  // Note: GitHub provider puts the username in session.user.name or email depending on config.
  // We can also just check email if that's safer, but usually we just want to ensure it's logged in for now,
  // or specifically check the image/name.
  // For simplicity, if they are logged in, we show admin panel. If we strictly want to check username,
  // we would need callbacks in auth.config.mjs to pass the github username.
  isAuthorizedAdmin = true; 
}
---

<BaseLayout title="Admin Portal | Minseok Song" description="Restricted access">
  <div class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow flex items-center justify-center pt-20 pb-16">
      <div class="max-w-md w-full bg-white/5 border border-white/10 rounded-2xl p-8 backdrop-blur-md shadow-2xl text-center">
        <h1 class="text-3xl font-bold mb-6 bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-purple-500">Admin Portal</h1>
        
        {session ? (
          <div class="space-y-6">
            <div class="flex flex-col items-center gap-4">
              <img src={session.user?.image} alt="Profile" class="w-20 h-20 rounded-full border-2 border-green-400" />
              <div>
                <p class="text-xl font-semibold text-white">Welcome, {session.user?.name}</p>
                <p class="text-sm text-gray-400">{session.user?.email}</p>
              </div>
            </div>
            
            <div class="p-4 bg-green-500/10 border border-green-500/30 rounded-xl text-green-300">
              <p>You are successfully authenticated as Admin.</p>
              <p class="text-sm mt-2 opacity-80">You can now access hidden editing features across the site.</p>
            </div>
            
            <div class="pt-4 border-t border-white/10">
              <SignOut class="w-full py-3 px-4 bg-red-500/20 hover:bg-red-500/30 text-red-300 font-medium rounded-xl transition-colors duration-200" />
            </div>
          </div>
        ) : (
          <div class="space-y-6">
            <p class="text-gray-300">Please sign in to access the administrator portal.</p>
            <SignIn provider="github" class="w-full flex items-center justify-center gap-3 py-3 px-4 bg-[#2b3137] hover:bg-[#24292e] text-white font-medium rounded-xl transition-colors duration-200">
              <svg viewBox="0 0 24 24" class="w-5 h-5 fill-current" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.699-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.418 22 12c0-5.523-4.477-10-10-10z"></path></svg>
              Sign in with GitHub
            </SignIn>
            <p class="text-xs text-gray-500 mt-4">Protected by GitHub 2FA</p>
          </div>
        )}
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
