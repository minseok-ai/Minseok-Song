---
import WritingEditor from "../../components/admin/WritingEditor";
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../config/site";
import { readAdminSession } from "../../lib/auth/admin";
import { writingEntries } from "../../lib/content/registry";
import "../../styles/admin.css";

const session = readAdminSession(Astro.cookies, import.meta.env);

if (!session) {
  return Astro.redirect(
    `/admin/login?next=${encodeURIComponent(Astro.url.pathname)}`
  );
}

const initialWritings = writingEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    id: entry.id,
    data: entry.data
  }));

const sessionLabel =
  session.provider === "github"
    ? `Signed in with GitHub as @${session.username}`
    : `Signed in as ${session.username}`;
---

<Layout
  title={`Writing Desk | ${siteConfig.name}`}
  description="Admin writing editor for A1 Firms."
  headerNote="Admin / Writing Desk"
>
  <section class="page-frame admin-shell">
    <header class="admin-head">
      <div>
        <p class="micro-label">Admin / Writings</p>
        <h1>Writing desk</h1>
        <span class="admin-session-label">{sessionLabel}</span>
      </div>
      <nav class="admin-head-actions" aria-label="Admin actions">
        <a href="/writings">Public index</a>
        <form method="post" action="/api/admin/logout">
          <button type="submit">Logout</button>
        </form>
      </nav>
    </header>

    <WritingEditor client:load initialWritings={initialWritings} />
  </section>
</Layout>
