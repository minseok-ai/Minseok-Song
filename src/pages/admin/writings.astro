---
import WritingEditor from "../../components/admin/WritingEditor";
import Layout from "../../layouts/Layout.astro";
import { siteConfig } from "../../config/site";
import { getSession } from "auth-astro/server";
import { SignOut } from "auth-astro/components";
import { writingEntries } from "../../lib/content/registry";
import "../../styles/admin.css";

const session = await getSession(Astro.request);

if (!session) {
  return Astro.redirect(
    `/admin/login`
  );
}

const initialWritings = writingEntries
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    id: entry.id,
    data: entry.data
  }));

const sessionLabel = `Signed in with GitHub as ${session.user?.name || session.user?.email}`;
---

<Layout
  title={`Writing Desk | ${siteConfig.name}`}
  description="Admin writing editor for A1 Firms."
  headerNote="Admin / Writing Desk"
>
  <section class="page-frame admin-shell">
    <header class="admin-head">
      <div>
        <p class="micro-label">Admin / Writings</p>
        <h1>Writing desk</h1>
        <span class="admin-session-label">{sessionLabel}</span>
      </div>
      <nav class="admin-head-actions" aria-label="Admin actions">
        <a href="/writings">Public index</a>
        <SignOut style="font-family: inherit; font-size: inherit; font-weight: inherit; border: none; background: none; color: inherit; cursor: pointer; padding: 0;">Logout</SignOut>
      </nav>
    </header>

    <WritingEditor client:load initialWritings={initialWritings} />
  </section>

  <script is:inline>
    window.addEventListener('error', function(event) {
      document.body.innerHTML += '<div style="position:fixed;top:0;left:0;z-index:9999;background:red;color:white;padding:20px;">' + event.error.message + '<br/><pre>' + event.error.stack + '</pre></div>';
    });
    window.addEventListener('unhandledrejection', function(event) {
      document.body.innerHTML += '<div style="position:fixed;top:0;left:0;z-index:9999;background:red;color:white;padding:20px;">' + event.reason + '</div>';
    });
  </script>
</Layout>
