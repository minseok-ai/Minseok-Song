---
import { getSession } from 'auth-astro/server';
import Layout from '../../layouts/Layout.astro';
import { SignIn, SignOut } from 'auth-astro/components';
import {
  getAuthAdminConfig,
  getAuthAdminLabel,
  isAllowedAuthAdminSession
} from '../../lib/auth/admin';
import '../../styles/admin.css';

const session = await getSession(Astro.request);
const adminConfig = getAuthAdminConfig(import.meta.env);
const isAuthorizedAdmin = isAllowedAuthAdminSession(session, import.meta.env);
const adminLabel = getAuthAdminLabel(session);
const url = new URL(Astro.request.url);
const error = url.searchParams.get("error");
const errorMessages = {
  unauthorized: "Your GitHub account is signed in, but it is not in the admin allowlist.",
  config: "Admin login is not configured. Set an allowed GitHub username or numeric ID.",
  legacy_auth: "This site now uses the GitHub OAuth session managed by Auth.js."
};
const errorMessage =
  error && error in errorMessages
    ? errorMessages[error as keyof typeof errorMessages]
    : undefined;
---

<Layout title="Admin Portal | Minseok Song" description="Restricted access" noindex={true}>
  <section class="page-frame admin-login-shell">
    <div class="admin-login-panel">
      <p class="micro-label">Admin / Secure entry</p>
      <h1>Admin Portal</h1>
      {errorMessage && (
        <div class="admin-auth-message" data-state="error">
          {errorMessage}
        </div>
      )}
      
      {session ? (
        isAuthorizedAdmin ? (
          <>
            <p>
              You are successfully authenticated. You can now access hidden features across the site.
            </p>
            <div class="admin-login-meta" aria-label="Admin profile">
              <span>{session.user?.name}</span>
              <span>{adminLabel}</span>
              <span>Admin</span>
            </div>
            
            <div class="admin-login-options is-authorized">
              <a href="/admin/writings" class="github-login-button is-primary">
                Open Writing Desk
              </a>
              <SignOut class="github-login-button is-ghost">
                Sign out
              </SignOut>
            </div>
          </>
        ) : (
          <>
            <div class="admin-auth-message is-spaced" data-state="error">
              Access Denied: Your GitHub account ({adminLabel}) does not have administrator privileges.
            </div>
            <p>
              If you believe this is an error, please ensure you are logged into the correct GitHub account.
            </p>
            <div class="admin-login-options is-compact">
              <SignOut class="github-login-button">
                Sign out
              </SignOut>
            </div>
          </>
        )
      ) : (
        <>
          <p>
            Please sign in with your allowed GitHub account to access the administrator portal. Protected by GitHub 2FA.
          </p>
          <div class="admin-login-meta" aria-label="Admin login security model">
            <span>GitHub OAuth</span>
            <span>{adminConfig.isConfigured ? "Allowlist ready" : "Allowlist missing"}</span>
            <span>Two-Factor Auth</span>
          </div>
          
          <div class="admin-login-options">
            <SignIn provider="github" class="github-login-button">
              Sign in with GitHub
            </SignIn>
          </div>
        </>
      )}
    </div>
  </section>
</Layout>
