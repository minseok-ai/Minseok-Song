---
import Layout from "../../layouts/Layout.astro";
import WritingArticle from "../../components/WritingArticle.astro";
import { siteConfig } from "../../config/site";
import { writingEntries } from "../../lib/content/registry";

const slug = Astro.params.slug ?? "";
const entry = writingEntries.find((writing) => writing.id === slug);

if (!entry || entry.data.hidden || entry.data.status !== "published") {
  return Astro.redirect("/writings");
}
---

<Layout
  title={`${entry.data.title} | ${siteConfig.name}`}
  description={entry.data.summary}
  headerNote="Writing / Article"
>
  <WritingArticle writing={entry.data} slug={entry.id} />
</Layout>
