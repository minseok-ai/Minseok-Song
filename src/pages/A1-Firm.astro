---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
import ProductWorkbench from "../components/ui/ProductWorkbench.astro";

const appUrl = import.meta.env.A1TRATEGIZE_URL || siteConfig.a1trategizeUrl;

const operatingLoop = [
  ["01", "Input Detection", "Classifies requests into Biz, IP, Career, or semiconductor domains."],
  ["02", "Research Scrutiny", "Scrapes citations and gathers live contextual reference documents."],
  ["03", "Adaptive Gate", "Checks data adequacy to conditionally bypass unnecessary research stages."],
  ["04", "Adversarial QA", "Runs multi-agent critique and safety checks before final file compilation."]
];
---

<Layout
  title={`A1 Firms | ${siteConfig.name}`}
  description="A public product page for A1trategize, the standalone A1 Firms web app."
  headerNote="02 / A1 Firms"
>
  <section class="a1-product-page">
    <div class="product-kicker">
      <span>Index 02</span>
      <i></i>
      <strong>A1 Firms / Product surface</strong>
    </div>

    <section class="product-hero">
      <div>
        <p class="micro-label">Patent-Pending Platform (KR 10-2026-0009508)</p>
        <h1>Multi-LLM Orchestration for Strategy & Analysis.</h1>
        <p>
          A1trategize is an editorial intelligence platform that solves the cognitive limits and hallucinations of single AI models. 
          By dynamically routing specialized tasks to a heterogeneous network of 5 LLM providers, it produces institutional-grade strategy reports.
        </p>
        <div class="product-stat-strip" aria-label="A1trategize product signals">
          <span>5 LLM providers</span>
          <span>Patent-pending</span>
          <span>Report exports</span>
        </div>
      </div>
      <a class="app-launch" href={appUrl} target="_blank" rel="noopener noreferrer">
        <span class="status-dot"></span>
        <span class="button-label">Open A1trategize</span>
        <svg viewBox="0 0 24 24" class="arrow-icon" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </section>

    <ProductWorkbench operatingLoop={operatingLoop} appUrl={appUrl} />

    <section class="llm-router-board" aria-label="A1trategize Multi-LLM Role Router">
      <div class="router-header">
        <span class="micro-label">Cognitive division of labor</span>
        <h2>Role-Based Multi-LLM Routing</h2>
        <p>A1trategize delegates tasks to specialized models, optimizing for reasoning depth, real-time citation scraping, and cost-efficient self-critique.</p>
      </div>
      <div class="router-grid">
        <div class="router-card reveal-up stagger-1">
          <div class="card-brand">
            <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 1.4h5v1.2l-1 1v1.2l-1 1v1.2l-1 1v1.2l-1 1v1.2l-1 1v1.2l1 1v1.2l1 1v1.2l-9 1v1.2l-1 1v1.2h-8v-1.2l1-1v-1.2l1-1v-1.2l1-1v-1.2l1-1v-1.2l-1-1v-1.2l-1-1v-1.2l10-1v-1.2l2-1v-1.2l2-1z"></path>
            </svg>
            <span>Upstage</span>
          </div>
          <h3>Classification</h3>
          <p>solar-pro3</p>
          <small>Classifies input domain, expanding query parameters and detecting user intent.</small>
        </div>

        <div class="router-card reveal-up stagger-2">
          <div class="card-brand">
            <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square">
              <path d="M12 2v20M12 12 5 6.5v11zM12 12l7-5.5v11zM5 9.5V4h4.5M19 9.5V4h-4.5M5 14.5V20h4.5M19 14.5V20h-4.5"></path>
            </svg>
            <span>Perplexity</span>
          </div>
          <h3>Live Research</h3>
          <p>sonar-pro</p>
          <small>Scrapes global web indexes in real-time, sourcing citation-backed text context.</small>
        </div>

        <div class="router-card reveal-up stagger-3">
          <div class="card-brand">
            <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2C12 7.5 7.5 12 2 12C7.5 12 12 16.5 12 22C12 16.5 16.5 12 22 12C16.5 12 12 7.5 12 2Z"></path>
            </svg>
            <span>Google Gemini</span>
          </div>
          <h3>Drafting</h3>
          <p>gemini-2.5-pro</p>
          <small>Injects deep context windows to draft comprehensive, highly structured briefings.</small>
        </div>

        <div class="router-card reveal-up stagger-4">
          <div class="card-brand">
            <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 12a8 8 0 018-8v8H4zM12 4a8 8 0 018 8h-8V4zM20 12a8 8 0 01-8 8v-8h8z"></path>
            </svg>
            <span>Alibaba</span>
          </div>
          <h3>Self-Critique</h3>
          <p>deepseek-v4-pro</p>
          <small>Reviews drafts as an adversarial agent, spotting logical gaps or minor errors.</small>
        </div>

        <div class="router-card reveal-up stagger-5">
          <div class="card-brand">
            <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 22h20L12 2zM12 6l7 12H5L12 6z"></path>
            </svg>
            <span>SKT A.X</span>
          </div>
          <h3>Localization</h3>
          <p>ax4-consult</p>
          <small>Refines output styling for specific Korean business culture guidelines.</small>
        </div>
      </div>
    </section>

    <section class="domains-overview" aria-label="A1trategize Domain Verticals">
      <div class="domains-header">
        <span class="micro-label">Application Verticals</span>
        <h2>Modular Domain Adaptations</h2>
        <p>A1trategize loads specialized prompt bases and rules depending on the domain. NNFC semiconductor validation is just one application of this core engine.</p>
      </div>
      <div class="domains-grid">
        <article class="domain-card reveal-up stagger-1">
          <span class="micro-label">Domain 01</span>
          <h3>💼 Business Strategy</h3>
          <p>McKinsey-style outlines, market size models, competitive landscaping, and growth initiative recommendations.</p>
        </article>

        <article class="domain-card reveal-up stagger-2">
          <span class="micro-label">Domain 02</span>
          <h3>🔬 NNFC Semiconductor</h3>
          <p>Recipe parameter mapping. Cross-checks wafer sizes, temperatures, and gases against 183 fabrication tools.</p>
        </article>

        <article class="domain-card reveal-up stagger-3">
          <span class="micro-label">Domain 03</span>
          <h3>⚖️ IP & Patent Strategy</h3>
          <p>Prior-art query matching, KIPO patent claim structuring, and draft patent background composition.</p>
        </article>

        <article class="domain-card reveal-up stagger-4">
          <span class="micro-label">Domain 04</span>
          <h3>📋 Career Coaching</h3>
          <p>Resume bullet impact audits, technical skill gap analysis, and global tech company interview prep.</p>
        </article>
      </div>
    </section>
  </section>
</Layout>

<script is:inline>
  // Magnetic Button Hover Effect
  const magnetButton = document.querySelector('.app-launch');
  if (magnetButton) {
    magnetButton.addEventListener('mousemove', (e) => {
      const rect = magnetButton.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      
      magnetButton.style.transform = `translate(${x * 0.25}px, ${y * 0.25}px) scale(1.02)`;
    });
    
    magnetButton.addEventListener('mouseleave', () => {
      magnetButton.style.transform = '';
      magnetButton.style.transition = 'all 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    
    magnetButton.addEventListener('mouseenter', () => {
      magnetButton.style.transition = 'none';
    });
  }
</script>

<style>
  .a1-product-page {
    display: grid;
    gap: 86px;
    width: min(100%, var(--max-site));
    margin: 0 auto;
    padding: 44px var(--space-page) 100px;
    position: relative;
  }

  .a1-product-page::before {
    content: '';
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 500px;
    background: radial-gradient(circle, rgba(107, 156, 242, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .product-kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .product-kicker i {
    display: block;
    width: 34px;
    height: 1px;
    background: var(--color-line-strong);
  }

  .product-kicker strong {
    color: var(--color-ink);
    letter-spacing: 0.05em;
  }

  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 48px;
    align-items: end;
    position: relative;
  }

  .product-hero h1 {
    margin: 12px 0 0;
    max-width: 1080px;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 4.8vw, 4.6rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.05;
    background: linear-gradient(180deg, var(--color-ink) 0%, var(--color-ink-soft) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .product-hero p:not(.micro-label) {
    max-width: 780px;
    margin: 28px 0 0;
    color: var(--color-ink-soft);
    font-size: 20px;
    line-height: 1.65;
  }

  .product-stat-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .product-stat-strip span {
    min-height: 28px;
    padding: 7px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    color: var(--color-ink-muted);
    background: var(--glass-bg);
    font-size: 11px;
    font-weight: 850;
    line-height: 1;
    text-transform: uppercase;
  }

  .app-launch {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 14px;
    color: var(--color-ink);
    background: var(--glass-bg);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: inset 0 0 0 1px var(--glass-border), var(--glass-shadow);
    backdrop-filter: var(--glass-blur);
    overflow: hidden;
  }

  .app-launch::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(107, 156, 242, 0.2), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .app-launch:hover {
    transform: translateY(-2px);
    background: var(--color-panel-solid);
    box-shadow: inset 0 0 0 1px var(--color-accent), 0 12px 32px var(--color-accent-soft), inset 0 0 20px var(--color-accent-soft);
  }

  .app-launch:hover::before {
    opacity: 1;
  }

  .status-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-green);
    margin-right: 14px;
    z-index: 1;
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    background-color: var(--color-green);
    opacity: 0.4;
    animation: statusPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes statusPulse {
    0% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(2.5); opacity: 0; }
    100% { transform: scale(1); opacity: 0; }
  }

  .button-label {
    flex-grow: 1;
    text-align: left;
    margin-right: 16px;
    position: relative;
    z-index: 1;
  }

  .arrow-icon {
    width: 14px;
    height: 14px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    z-index: 1;
  }

  .app-launch:hover .arrow-icon {
    transform: translateX(6px);
    color: var(--color-accent);
  }

  /* LLM Router Styles */
  .llm-router-board {
    display: grid;
    gap: 36px;
    padding: 42px;
    border: 1px solid var(--glass-border);
    border-radius: 20px;
    background: var(--glass-bg);
    box-shadow: inset 0 1px 0 var(--color-line-strong), var(--glass-shadow);
    backdrop-filter: var(--glass-blur);
    position: relative;
    overflow: hidden;
  }

  .llm-router-board::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--glass-border), transparent);
  }

  .router-header h2 {
    margin: 8px 0 12px;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .router-header p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 16px;
    max-width: 720px;
    line-height: 1.65;
  }

  .router-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 20px;
    border-top: 1px solid var(--glass-border);
    padding-top: 36px;
  }

  .router-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 10px;
    padding: 24px 20px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-paper);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .router-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top right, var(--color-accent-soft), transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .router-card:hover {
    background: var(--color-panel-solid);
    border-color: var(--color-line-strong);
    transform: translateY(-4px);
    box-shadow: var(--glass-shadow);
  }

  .router-card:hover::before {
    opacity: 1;
  }

  .card-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
  }

  .router-card:hover .card-brand {
    color: var(--color-ink);
  }

  .brand-icon {
    width: 16px;
    height: 16px;
    opacity: 0.6;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .router-card:hover .brand-icon {
    opacity: 1;
    transform: scale(1.1);
  }

  .router-card h3 {
    margin: 8px 0 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .router-card p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent-ink);
    opacity: 0.9;
  }

  .router-card small {
    margin-top: 10px;
    color: var(--color-ink-soft);
    font-size: 13px;
    line-height: 1.5;
  }

  .router-card::after {
    content: '';
    position: absolute;
    top: 12px;
    right: 12px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 8px var(--color-green-glow);
    animation: statusPulse 2s ease-in-out infinite;
    z-index: 10;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
  }

  .router-card:hover::after {
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent-glow);
    animation-duration: 1s;
  }

  /* Domains Overview Styles */
  .domains-overview {
    display: grid;
    gap: 36px;
  }

  .domains-header h2 {
    margin: 8px 0 12px;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.5vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .domains-header p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 16px;
    max-width: 720px;
    line-height: 1.65;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }

  .domain-card {
    position: relative;
    padding: 28px 24px;
    border: 1px solid var(--color-line);
    border-radius: 16px;
    background: var(--color-paper);
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .domain-card h3,
  .router-card h3 {
    overflow-wrap: anywhere;
  }

  .domain-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--glass-border) 1px, transparent 1px);
    background-size: 16px 16px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.5;
    transition: opacity 0.4s ease;
  }

  .domain-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent-soft), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .domain-card > * {
    position: relative;
    z-index: 1;
  }

  .domain-card:hover {
    border-color: var(--color-line-strong);
    background: var(--color-panel-solid);
    box-shadow: var(--glass-shadow);
    transform: translateY(-4px);
  }

  .domain-card:hover::before {
    opacity: 1;
  }

  .domain-card:hover::after {
    opacity: 1;
  }

  .domain-card .micro-label {
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-ink-muted);
  }

  .domain-card h3 {
    margin: 16px 0 10px;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .domain-card p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 14px;
    line-height: 1.6;
  }

  @media (max-width: 1180px) {
    .product-hero {
      grid-template-columns: 1fr;
    }

    .product-hero h1 {
      font-size: clamp(2.6rem, 7vw, 3.6rem);
    }

    .app-launch {
      width: fit-content;
      padding: 0 24px;
    }

    .router-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .domains-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .a1-product-page {
      gap: 56px;
      padding-top: 32px;
    }

    .product-hero h1 {
      font-size: clamp(2.2rem, 9vw, 2.8rem);
    }

    .product-hero p:not(.micro-label) {
      font-size: 17px;
    }

    .llm-router-board {
      padding: 24px;
    }

    .router-grid,
    .domains-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
