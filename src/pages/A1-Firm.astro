---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
import ProductWorkbench from "../components/ui/ProductWorkbench.astro";

const appUrl = import.meta.env.A1TRATEGIZE_URL || siteConfig.a1trategizeUrl;

const productSignals = [
  ["Domain", "AI strategy"],
  ["Runtime", "Separate app"],
  ["Site", "a1trategize.com"],
  ["Role", "Product"]
];

const operatingLoop = [
  ["01", "Frame", "Turn an ambiguous strategy question into a clear operating brief."],
  ["02", "Research", "Collect source context, model outputs, domain data, and critique traces."],
  ["03", "Synthesize", "Move from raw signal to report, export, and decision support artifacts."],
  ["04", "Archive", "Keep sessions and findings reusable inside the product environment."]
];

const bars = Array.from({ length: 72 }, (_, index) => 18 + ((index * 19) % 54));
---

<Layout
  title={`A1 Firms | ${siteConfig.name}`}
  description="A public product page for A1trategize, the standalone A1 Firms web app."
  headerNote="02 / A1 Firms"
>
  <section class="a1-product-page">
    <div class="product-kicker">
      <span>Index 02</span>
      <i></i>
      <strong>A1 Firms / Product surface</strong>
    </div>

    <section class="product-hero">
      <div>
        <p class="micro-label">Standalone application</p>
        <h1>A1trategize now lives on its own domain.</h1>
        <p>
          This portfolio explains the product, the operating thesis, and the
          public context around it. The working A1trategize app is managed as a
          separate service at a1trategize.com.
        </p>
      </div>
      <a class="app-launch" href={appUrl}>Open A1trategize</a>
    </section>

    <section class="signal-board" aria-label="A1trategize product summary">
      <div class="telemetry-grid">
        {productSignals.map(([label, value]) => (
          <div>
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </div>
      <div class="bar-bank" aria-hidden="true">
        {bars.map((height) => <span style={`height: ${height}%;`}></span>)}
      </div>
      <p>
        Portfolio domain: minseoksong.com / Product domain: a1trategize.com /
        Sessions, API keys, and app data are managed by the product app.
      </p>
    </section>

    <section class="separation-grid">
      <article>
        <span class="micro-label">minseoksong.com</span>
        <h2>Portfolio and editorial layer.</h2>
        <p>
          About, projects, writings, contact, and product context stay here.
          Admin login on this site is for content operations only.
        </p>
      </article>
      <article>
        <span class="micro-label">a1trategize.com</span>
        <h2>Application and data layer.</h2>
        <p>
          User login, product sessions, API access, provider keys, exports, and
          app-specific operations belong to the standalone A1trategize service.
        </p>
      </article>
    </section>

    <ProductWorkbench operatingLoop={operatingLoop} appUrl={appUrl} />
  </section>
</Layout>

<style>
  .a1-product-page {
    display: grid;
    gap: 54px;
    width: min(100%, var(--max-site));
    margin: 0 auto;
    padding: 44px var(--space-page) 86px;
  }

  .product-kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .product-kicker i {
    display: block;
    width: 34px;
    height: 1px;
    background: var(--color-line-strong);
  }

  .product-kicker strong {
    color: var(--color-ink);
  }

  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 48px;
    align-items: end;
  }

  .product-hero h1 {
    margin: 12px 0 0;
    max-width: 1080px;
    font-family: var(--font-serif);
    font-size: clamp(2.85rem, 4.65vw, 4.35rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.06;
  }

  .product-hero p:not(.micro-label) {
    max-width: 760px;
    margin: 28px 0 0;
    color: var(--color-ink-soft);
    font-size: 20px;
    line-height: 1.65;
  }

  .app-launch,
  .panel-cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 46px;
    border: 1px solid var(--color-ink);
    color: var(--color-paper);
    background: var(--color-ink);
    font-size: 13px;
    font-weight: 900;
    text-decoration: none;
  }

  .signal-board {
    display: grid;
    border: 1px solid var(--color-line-strong);
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .telemetry-grid div {
    display: grid;
    gap: 12px;
    min-height: 118px;
    padding: 22px;
    border-right: 1px solid var(--color-line);
  }

  .telemetry-grid div:last-child {
    border-right: 0;
  }

  .telemetry-grid span,
  .signal-board p,
  .panel-toolbar,
  .process-list article > span {
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .telemetry-grid strong {
    align-self: end;
    font-size: clamp(1.65rem, 2.4vw, 2.1rem);
    line-height: 1;
  }

  .bar-bank {
    display: flex;
    align-items: end;
    gap: 5px;
    height: 80px;
    padding: 0 18px 18px;
    border-top: 1px solid var(--color-line);
    overflow: hidden;
  }

  .bar-bank span {
    flex: 1 0 7px;
    max-width: 16px;
    background: var(--color-ink);
    opacity: 0.32;
  }

  .signal-board p {
    margin: 0;
    padding: 12px 18px;
    border-top: 1px solid var(--color-line);
  }

  .separation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .separation-grid article {
    min-height: 260px;
    padding: 28px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .separation-grid h2 {
    max-width: 560px;
    margin: 48px 0 16px;
    font-family: var(--font-serif);
    font-size: clamp(2rem, 3.3vw, 2.85rem);
    font-weight: 600;
    line-height: 1.08;
  }

  .separation-grid p {
    max-width: 620px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 16px;
    line-height: 1.7;
  }

  /* ProductWorkbench styles extracted to component */

  @media (max-width: 1180px) {
    .product-hero {
      grid-template-columns: 1fr;
    }

    .product-hero h1 {
      font-size: clamp(2.45rem, 7vw, 3.45rem);
    }

    .app-launch {
      width: fit-content;
      padding: 0 18px;
    }
  }

  @media (max-width: 760px) {
    .a1-product-page {
      gap: 42px;
      padding-top: 32px;
    }

    .product-hero h1 {
      font-size: clamp(2.05rem, 9vw, 2.65rem);
    }

    .product-hero p:not(.micro-label) {
      font-size: 17px;
    }

    .telemetry-grid,
    .separation-grid {
      grid-template-columns: 1fr;
    }

    .telemetry-grid div {
      min-height: 92px;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .telemetry-grid div:last-child {
      border-bottom: 0;
    }

    .separation-grid h2 {
      font-size: 2.2rem;
    }
  }
</style>
