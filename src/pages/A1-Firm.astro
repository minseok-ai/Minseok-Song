---
import Layout from "../layouts/Layout.astro";
import { siteConfig } from "../config/site";
import ProductWorkbench from "../components/ui/ProductWorkbench.astro";
import A1ntuitizeManifold from "../components/ui/A1ntuitizeManifold.astro";

const appUrl = import.meta.env.A1TRATEGIZE_URL || siteConfig.a1trategizeUrl;

const operatingLoop = [
  ["01", "Input Detection", "Classifies requests into Biz, IP, Career, or semiconductor domains."],
  ["02", "Research Scrutiny", "Scrapes citations and gathers live contextual reference documents."],
  ["03", "Adaptive Gate", "Checks data adequacy to conditionally bypass unnecessary research stages."],
  ["04", "Adversarial QA", "Runs multi-agent critique and safety checks before final file compilation."]
];

const modelStack = [
  {
    provider: "Upstage",
    product: "Solar",
    logo: "/brand-logos/upstage-symbol-black.png",
    description: "A Korean frontier model endpoint built into the stack for structured Korean and technical strategy work."
  },
  {
    provider: "Perplexity",
    product: "Sonar",
    logo: "/brand-logos/perplexity.svg",
    description: "A web-aware model layer used when current citations and external reference context are needed."
  },
  {
    provider: "Google Gemini",
    product: "Gemini",
    logo: "/brand-logos/google-gemini.svg",
    description: "A long-context reasoning model used for dense brief synthesis, planning, and structured report drafting."
  },
  {
    provider: "DeepSeek",
    product: "DeepSeek",
    logo: "/brand-logos/deepseek.svg",
    description: "A critique-oriented model endpoint used to challenge draft logic and expose weak assumptions."
  },
  {
    provider: "Qwen",
    product: "Qwen",
    logo: "/brand-logos/qwen.svg",
    description: "An Alibaba Cloud model family layer built into the current stack for multilingual reasoning and structured strategy output."
  }
];
---

<Layout
  title={`A1 Firms | ${siteConfig.name}`}
  description="A public product surface for A1trategize and emerging cognitive AI initiatives under A1 Firms."
  headerNote="02 / A1 Firms"
>
  <section class="a1-product-page">
    <!-- SECTION 01: A1TRATEGIZE FLAGSHIP PLATFORM -->
    <div class="product-kicker">
      <span>01 / Flagship Platform</span>
      <i></i>
      <strong>A1trategize Core Engine</strong>
    </div>

    <section class="product-hero">
      <div>
        <p class="micro-label">Flagship AI Platform · Patent-Pending (KR 10-2026-0009508)</p>
        <h1>A1trategize: Multi-LLM Orchestration for Strategy & Analysis.</h1>
        <p>
          A1trategize is an editorial intelligence platform that solves the cognitive limits and hallucinations of single AI models. 
          By dynamically routing specialized tasks to a heterogeneous network of 5 LLM providers, it produces institutional-grade strategy reports.
        </p>
        <div class="product-stat-strip" aria-label="A1trategize product signals">
          <span>5 LLM providers</span>
          <span>Patent-pending</span>
          <span>Report exports</span>
          <span>Live Web App</span>
        </div>
      </div>
      <a class="app-launch" href={appUrl} target="_blank" rel="noopener noreferrer">
        <span class="status-dot"></span>
        <span class="button-label">Open A1trategize</span>
        <svg viewBox="0 0 24 24" class="arrow-icon" aria-hidden="true">
          <path fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    </section>

    <ProductWorkbench operatingLoop={operatingLoop} appUrl={appUrl} />

    <section id="llm-router" class="llm-router-board" aria-label="A1trategize built multi-model stack">
      <div class="router-header">
        <span class="micro-label">Built model stack</span>
        <h2>Operational Multi-LLM Stack</h2>
        <p>A1trategize is built around a live model stack rather than fixed role assignments. Each provider is wired as a capability layer for reasoning, citation context, drafting, critique, or multilingual strategy work.</p>
      </div>
      <div class="router-grid">
        {modelStack.map((item, index) => (
          <div class={`router-card reveal-up stagger-${index + 1}`}>
            <div class="card-brand">
              <span class="brand-logo-frame">
                <img src={item.logo} alt="" class="brand-logo" loading="lazy" decoding="async" />
              </span>
              <span>{item.provider}</span>
            </div>
            <h3>{item.product}</h3>
            <small>{item.description}</small>
          </div>
        ))}
      </div>
    </section>

    <section class="domains-overview" aria-label="A1trategize intelligence domains">
      <div class="domains-header">
        <span class="micro-label">Enterprise & Founder Domains</span>
        <h2>Specialized Intelligence Verticals</h2>
        <p>A1trategize tailors its prompt topology and agent routing specifically for high-stakes business decisions.</p>
      </div>
      <div class="domains-grid">
        <article class="domain-card reveal-up stagger-1">
          <span class="micro-label">Domain 01</span>
          <h3 class="domain-title">
            <span class="domain-glyph" title="Business Strategy">
              <svg class="dg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
            </span>
            Business Strategy
          </h3>
          <p>TAM/SAM sizing, unit economics modeling, competitive matrix generation, and risk assessment matrices.</p>
        </article>

        <article class="domain-card reveal-up stagger-2">
          <span class="micro-label">Domain 02</span>
          <h3 class="domain-title">
            <span class="domain-glyph" title="Intellectual Property">
              <svg class="dg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </span>
            Intellectual Property
          </h3>
          <p>Prior-art citation mapping, claim defensibility scrutiny, and patent drafting structuring.</p>
        </article>

        <article class="domain-card reveal-up stagger-3">
          <span class="micro-label">Domain 03</span>
          <h3 class="domain-title">
            <span class="domain-glyph" title="Semiconductors & Deep Tech">
              <svg class="dg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                <rect x="9" y="9" width="6" height="6"></rect>
                <line x1="9" y1="1" x2="9" y2="4"></line>
                <line x1="15" y1="1" x2="15" y2="4"></line>
                <line x1="9" y1="20" x2="9" y2="23"></line>
                <line x1="15" y1="20" x2="15" y2="23"></line>
                <line x1="20" y1="9" x2="23" y2="9"></line>
                <line x1="20" y1="14" x2="23" y2="14"></line>
                <line x1="1" y1="9" x2="4" y2="9"></line>
                <line x1="1" y1="14" x2="4" y2="14"></line>
              </svg>
            </span>
            Semiconductors & Deep Tech
          </h3>
          <p>Yield modeling, microarchitectural comparison, packaging roadmap analysis, and supply chain vulnerability analysis.</p>
        </article>

        <article class="domain-card reveal-up stagger-4">
          <span class="micro-label">Domain 04</span>
          <h3 class="domain-title">
            <span class="domain-glyph" title="Career Coaching">
              <svg class="dg-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <polyline points="17 11 19 13 23 9"></polyline>
              </svg>
            </span>
            Career Coaching
          </h3>
          <p>Resume bullet impact audits, technical skill gap analysis, and global tech company interview prep.</p>
        </article>
      </div>
    </section>

    <!-- SECTION 02: A1NTUITIZE (SEALED R&D INITIATIVE) -->
    <A1ntuitizeManifold />
  </section>
</Layout>

<script is:inline>
  // Magnetic Button Hover Effect
  const magnetButton = document.querySelector('.app-launch');
  if (magnetButton) {
    magnetButton.addEventListener('mousemove', (e) => {
      const rect = magnetButton.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      
      magnetButton.style.transform = `translate(${x * 0.25}px, ${y * 0.25}px) scale(1.02)`;
    });
    
    magnetButton.addEventListener('mouseleave', () => {
      magnetButton.style.transform = '';
      magnetButton.style.transition = 'all 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
    });

    magnetButton.addEventListener('mouseenter', () => {
      magnetButton.style.transition = 'none';
    });
  }
</script>

<style>
  .a1-product-page {
    display: grid;
    gap: 86px;
    width: min(100%, var(--max-site));
    max-width: 100%;
    margin: 0 auto;
    padding: 44px var(--space-page) 100px;
    position: relative;
    box-sizing: border-box;
  }

  .product-kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-kicker i {
    width: 32px;
    height: 1px;
    background: var(--color-line-strong);
  }

  .product-kicker strong {
    color: var(--color-ink);
  }

  .micro-label {
    font-size: 11.5px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-family: var(--font-mono, monospace);
    margin-bottom: 6px;
  }

  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 48px;
    align-items: end;
    position: relative;
  }

  .product-hero h1 {
    margin: 12px 0 0;
    max-width: 1080px;
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 4.5vw, 4.4rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    background: linear-gradient(180deg, var(--color-ink) 0%, var(--color-ink-soft) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .product-hero p:not(.micro-label) {
    max-width: 780px;
    margin: 28px 0 0;
    color: var(--color-ink-soft);
    font-size: 20px;
    line-height: 1.65;
  }

  .product-stat-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .product-stat-strip span {
    min-height: 28px;
    padding: 7px 10px;
    border: 1px solid var(--glass-border);
    border-radius: 999px;
    color: var(--color-ink-muted);
    background: var(--glass-bg);
    font-size: 11px;
    font-weight: 850;
    line-height: 1;
    text-transform: uppercase;
  }

  .app-launch {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-height: 56px;
    padding: 0 28px;
    border-radius: 14px;
    color: var(--color-ink);
    background: var(--glass-bg);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: inset 0 0 0 1px var(--glass-border), var(--glass-shadow);
    backdrop-filter: var(--glass-blur);
    overflow: hidden;
  }

  .app-launch::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(107, 156, 242, 0.2), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .app-launch:hover {
    transform: translateY(-2px);
    background: var(--color-panel-solid);
    box-shadow: inset 0 0 0 1px var(--color-accent), 0 12px 32px var(--color-accent-soft), inset 0 0 20px var(--color-accent-soft);
  }

  .app-launch:hover::before {
    opacity: 1;
  }

  .status-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-green);
    margin-right: 14px;
    z-index: 1;
  }

  .button-label {
    position: relative;
    z-index: 1;
  }

  .arrow-icon {
    position: relative;
    width: 14px;
    height: 14px;
    margin-left: 14px;
    z-index: 1;
    transition: transform var(--motion-fast) var(--easing-smooth);
  }

  .app-launch:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* LLM Router Board */
  .llm-router-board {
    display: grid;
    gap: 36px;
    padding: 38px;
    border-radius: 20px;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
  }

  .router-header h2 {
    margin: 8px 0 12px;
    font-size: 28px;
    font-family: var(--font-serif);
    font-weight: 600;
  }

  .router-header p {
    color: var(--color-ink-muted);
    font-size: 15px;
    line-height: 1.6;
    max-width: 800px;
  }

  .router-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 16px;
  }

  .router-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: 14px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .router-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-line-strong);
    background: var(--color-panel-solid);
  }

  .card-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    font-size: 12px;
    font-weight: 700;
    color: var(--color-ink-muted);
  }

  .brand-logo-frame {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
  }

  .brand-logo {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: filter 0.3s ease;
  }

  /* Dark mode: invert dark icons to be visible on dark card backgrounds */
  html[data-resolved-theme="dark"] .brand-logo {
    filter: invert(1) brightness(1.8);
  }

  .router-card h3 {
    margin: 0 0 10px;
    font-size: 17px;
    font-weight: 700;
  }

  .router-card small {
    color: var(--color-ink-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  /* Domains Overview */
  .domains-overview {
    display: grid;
    gap: 36px;
  }

  .domains-header h2 {
    margin: 8px 0 12px;
    font-size: 28px;
    font-family: var(--font-serif);
    font-weight: 600;
  }

  .domains-header p {
    color: var(--color-ink-muted);
    font-size: 15px;
    line-height: 1.6;
    max-width: 800px;
  }

  .domains-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .domain-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: 14px;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .domain-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-line-strong);
  }

  .domain-title {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 14px 0 10px;
    font-size: 16px;
    font-weight: 700;
  }

  .domain-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
  }

  .dg-icon {
    width: 18px;
    height: 18px;
  }

  .domain-card p {
    color: var(--color-ink-soft);
    font-size: 14px;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 1180px) {
    .product-hero {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .product-hero h1 {
      font-size: clamp(2.4rem, 6vw, 3.4rem);
    }

    .app-launch {
      width: fit-content;
      padding: 0 24px;
    }

    .router-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .domains-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .a1-product-page {
      gap: 48px;
      padding-top: 28px;
      padding-left: 24px;
      padding-right: 24px;
      padding-bottom: 80px;
    }

    /* Hero */
    .product-hero h1 {
      font-size: clamp(1.85rem, 7.5vw, 2.4rem);
      word-break: break-word;
      line-height: 1.3;
    }

    .product-hero p:not(.micro-label) {
      font-size: 15px;
      margin-top: 16px;
      line-height: 1.6;
    }

    /* Kicker strip */
    .product-kicker {
      gap: 6px;
      font-size: 10.5px;
    }

    .product-kicker i {
      display: none;
    }

    /* Stat pills */
    .product-stat-strip {
      margin-top: 18px;
      gap: 6px;
    }

    .product-stat-strip span {
      font-size: 10px;
      padding: 5px 9px;
    }

    /* CTA button: full width on mobile */
    .app-launch {
      width: 100%;
      justify-content: center;
      padding: 0 20px;
      min-height: 52px;
      font-size: 12px;
      border-radius: 12px;
      box-sizing: border-box;
    }

    .arrow-icon {
      margin-left: 10px;
    }

    /* LLM Router Board */
    .llm-router-board {
      padding: 20px 16px;
      border-radius: 14px;
      gap: 24px;
    }

    .router-header h2 {
      font-size: 22px;
      margin-bottom: 8px;
    }

    .router-header p {
      font-size: 14px;
    }

    /* Router cards: 2 col on mobile for cleaner layout */
    .router-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .router-card {
      padding: 16px;
      border-radius: 12px;
    }

    .router-card h3 {
      font-size: 15px;
      margin-bottom: 6px;
    }

    .router-card small {
      font-size: 12px;
    }

    .card-brand {
      margin-bottom: 10px;
      font-size: 11px;
    }

    /* Domains section */
    .domains-header h2 {
      font-size: 22px;
    }

    .domains-header p {
      font-size: 14px;
    }

    /* Domain cards: 2 col on mobile */
    .domains-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .domain-card {
      padding: 16px;
      border-radius: 12px;
    }

    .domain-title {
      font-size: 14px;
      margin: 10px 0 8px;
    }

    .domain-card p {
      font-size: 12.5px;
    }
  }

  @media (max-width: 480px) {
    .router-grid,
    .domains-grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .router-card,
    .domain-card {
      padding: 14px;
    }
  }
</style>
