---
import { getSession } from 'auth-astro/server';

const { navItem, hero, writings = [] } = Astro.props;

const session = await getSession(Astro.request);

const newsletterEntries = writings
  .filter((entry) => !entry.data.hidden && entry.data.status === "published")
  .sort((a, b) => a.data.order - b.data.order);

const articleTags = ["Source", "Crawl", "Review", "Publish"];
---

<div class="page-kicker">
  <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
  <i></i>
  <strong>Newsletter desk</strong>
</div>

<section class="index-hero newsletter-hero">
  <h1>Reviewed articles, crawled sources, and short editorial signals.</h1>
  <p>
    Writings is not a loose essay shelf. It is the newsletter surface:
    find a worthwhile article, crawl the full text, review the argument,
    then publish a concise Korean note with source trace intact.
  </p>
  <div class="newsletter-stats" aria-label="Newsletter publishing status">
    <span>{String(newsletterEntries.length).padStart(2, "0")} published</span>
    <span>Source trace kept</span>
    <span>Drafts hidden</span>
  </div>
  {session && (
    <a class="admin-entry-link" href="/admin/writings">Open writing desk</a>
  )}
</section>

<section class="writings-ad-preview" aria-label="Reserved advertisement placement">
  <span>Advertisement</span>
</section>

<section id="writing-index" class="newsletter-instrument">
  <div class="pipeline-meter" id="pipeline-meter">
    {articleTags.map((tag, index) => (
      <div class="pipeline-step" data-step={tag.toLowerCase()}>
        <span>{String(index + 1).padStart(2, "0")}</span>
        <strong>{tag}</strong>
        <span class="step-tooltip">
          {tag === "Source" && "Identify high-signal tech articles, papers & research logs."}
          {tag === "Crawl" && "Perform clean full-text extracts and archive source metadata."}
          {tag === "Review" && "Run critical analysis, evaluate arguments & refine takeaways."}
          {tag === "Publish" && "Deliver structured Korean summaries with full trace logs intact."}
        </span>
      </div>
    ))}
  </div>
  <div class="newsletter-list">
    {newsletterEntries.length > 0 ? (
      newsletterEntries.map((writing, index) => (
        <a class={`newsletter-row reveal-up stagger-${(index % 5) + 1}`} href={`/writings/${writing.id}`} data-tag={writing.data.tags[0]?.toLowerCase() ?? "review"}>
          <span>{String(index + 1).padStart(3, "0")}</span>
          <time>{writing.data.date ?? "Draft"}</time>
          <strong>{writing.data.title}</strong>
          <em>{writing.data.tags[0] ?? "Review"}</em>
          <small>{writing.data.summary}</small>
          <svg class="row-arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      ))
    ) : (
      <div class="empty-ledger">
        <span class="micro-label">Newsletter pending</span>
        <h2>Connect crawler output to publish reviewed briefs here.</h2>
        <p>Each issue should keep source, crawl, review, and final note separate.</p>
      </div>
    )}
  </div>
</section>

<script is:inline>
  // Spotlight hover for Newsletter Rows
  const rows = document.querySelectorAll('.newsletter-row');
  rows.forEach(row => {
    row.addEventListener('mousemove', (e) => {
      const rect = row.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      row.style.setProperty('--mouse-x', `${x}px`);
      row.style.setProperty('--mouse-y', `${y}px`);
    });
  });

  // Interactive Pipeline Highlights
  const steps = document.querySelectorAll('.pipeline-step');
  steps.forEach(step => {
    step.addEventListener('mouseenter', () => {
      const filterTag = step.getAttribute('data-step');
      rows.forEach(row => {
        const rowTag = row.getAttribute('data-tag');
        if (rowTag === filterTag) {
          row.classList.add('pipeline-highlight');
        } else {
          row.classList.add('pipeline-dim');
        }
      });
    });
    
    step.addEventListener('mouseleave', () => {
      rows.forEach(row => {
        row.classList.remove('pipeline-highlight', 'pipeline-dim');
      });
    });
  });
</script>

<style>
  .index-hero {
    display: grid;
    gap: 28px;
  }

  .newsletter-hero {
    max-width: 1120px;
  }

  .index-hero h1 {
    margin: 0;
    max-width: 960px;
    font-family: var(--font-serif);
    font-size: clamp(2.45rem, 3.65vw, 3.55rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .index-hero p {
    margin: 0;
    max-width: 640px;
    color: var(--color-ink-soft);
    font-size: 18px;
    line-height: 1.65;
  }

  .newsletter-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .newsletter-stats span {
    min-height: 28px;
    padding: 7px 10px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-muted);
    background: var(--glass-bg);
    font-size: 11px;
    font-weight: 850;
    line-height: 1;
    text-transform: uppercase;
    transition: border-color var(--motion-fast) ease, background var(--motion-fast) ease;
  }
  
  .newsletter-stats span:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .admin-entry-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-card);
    color: var(--color-ink);
    background: rgba(248, 247, 242, 0.06);
    font-size: 13px;
    font-weight: 850;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background var(--motion-fast) ease,
      border-color var(--motion-fast) ease,
      transform var(--motion-fast) ease;
  }

  .admin-entry-link:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
    transform: translateY(-1px);
  }

  .writings-ad-preview {
    display: grid;
    place-items: center;
    justify-self: center;
    width: min(728px, 100%);
    min-height: 90px;
    padding: 14px 18px;
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-card);
    background: rgba(248, 247, 242, 0.38);
    box-shadow: 0 18px 52px rgba(12, 14, 18, 0.04);
    backdrop-filter: var(--glass-blur);
  }

  .writings-ad-preview span {
    color: var(--color-ink-muted);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .newsletter-instrument {
    display: grid;
    gap: 24px;
  }

  .pipeline-meter {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow: var(--glass-shadow);
  }

  .pipeline-meter::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.05), transparent);
    background-size: 200% 100%;
    animation: pipelineFlow 4s infinite linear;
    pointer-events: none;
  }

  @keyframes pipelineFlow {
    0% { background-position: 100% 0; }
    100% { background-position: -100% 0; }
  }

  .pipeline-meter .pipeline-step {
    display: grid;
    gap: 12px;
    min-height: 112px;
    padding: 18px;
    border: 0;
    border-right: 1px solid var(--color-line-strong);
    transition: background var(--motion-fast) ease, box-shadow var(--motion-fast) ease;
    position: relative;
  }

  .pipeline-meter .pipeline-step:hover {
    background: var(--color-panel-solid);
    box-shadow: inset 0 0 0 1px var(--color-accent-soft), inset 0 0 24px rgba(var(--rgb-warm), 0.05);
    z-index: 2;
  }
  
  .pipeline-meter .pipeline-step:hover strong {
    color: var(--color-accent);
  }

  .pipeline-meter .pipeline-step:last-child {
    border-right: 0;
  }

  .pipeline-meter span {
    color: var(--color-ink-muted);
    font-size: 12px;
  }

  .pipeline-meter strong {
    align-self: end;
    font-size: 1.45rem;
  }

  .newsletter-list {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .newsletter-row {
    position: relative;
    display: grid;
    grid-template-columns: 64px 104px minmax(180px, 0.55fr) 96px minmax(0, 1fr) 28px;
    gap: 24px;
    align-items: center;
    min-height: 86px;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    overflow: hidden;
    transition: opacity 0.4s var(--easing-smooth), transform 0.4s var(--easing-smooth), border-color 0.3s ease, background-color 0.3s ease;
  }

  .newsletter-row::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity var(--motion-fast) ease;
  }

  .newsletter-row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(800px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(var(--rgb-warm), 0.1), transparent 45%);
    opacity: 0;
    transition: opacity var(--motion-fast) ease;
    pointer-events: none;
    z-index: 0;
  }

  .newsletter-row:hover::before {
    opacity: 1;
  }

  .newsletter-row:hover::after,
  .newsletter-row.pipeline-highlight::after {
    opacity: 1;
  }

  /* Interactive highlights */
  .newsletter-row.pipeline-highlight {
    border-color: var(--color-accent);
    background-color: rgba(var(--rgb-warm), 0.06);
    transform: translateX(6px);
    z-index: 2;
  }

  .newsletter-row.pipeline-dim {
    opacity: 0.25;
  }

  /* Tooltips for pipeline steps */
  .step-tooltip {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    width: 240px;
    background: var(--color-panel-solid);
    border: 1px solid var(--color-line-strong);
    border-radius: 8px;
    padding: 12px 14px;
    color: var(--color-ink-soft);
    font-size: 11px;
    font-weight: 500;
    line-height: 1.45;
    text-align: center;
    text-transform: none;
    pointer-events: none;
    opacity: 0;
    box-shadow: 0 12px 36px var(--glass-shadow);
    transition: opacity 0.3s var(--easing-smooth), transform 0.3s var(--easing-smooth);
    z-index: 100;
  }

  .step-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--color-line-strong);
  }

  .pipeline-step:hover .step-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
    color: var(--color-ink);
  }

  .newsletter-row > * {
    position: relative;
    z-index: 1;
  }

  .newsletter-row span,
  .newsletter-row time,
  .newsletter-row em {
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .newsletter-row em {
    border: 1px solid var(--color-line);
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 800;
  }

  .newsletter-row strong {
    font-family: var(--font-serif);
    font-size: 1.85rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .newsletter-row small {
    color: var(--color-ink-soft);
    font-size: 14px;
    line-height: 1.5;
  }

  .row-arrow {
    width: 18px;
    height: 18px;
    color: var(--color-ink-muted);
    transition: color var(--motion-fast) ease, transform var(--motion-fast) ease;
  }

  .newsletter-row:hover .row-arrow {
    color: var(--color-accent);
    transform: translateX(3px);
  }

  .empty-ledger {
    padding: 32px 0;
  }

  .empty-ledger h2 {
    margin: 8px 0 10px;
    font-size: 2.2rem;
  }

  .empty-ledger p {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.65;
  }

  @media (max-width: 1180px) {
    .index-hero h1 {
      font-size: clamp(2.25rem, 6vw, 3rem);
    }
    .newsletter-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .index-hero h1 {
      font-size: clamp(1.95rem, 8vw, 2.45rem);
    }

    .newsletter-hero {
      gap: 22px;
    }

    .writings-ad-preview {
      width: 100%;
      min-height: 82px;
    }

    .pipeline-meter {
      grid-template-columns: 1fr;
    }

    .pipeline-meter .pipeline-step {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 10px;
      align-items: center;
      min-height: 68px;
      padding: 14px 16px;
    }

    .pipeline-meter .pipeline-step strong {
      align-self: center;
      font-size: 1.12rem;
    }

    .step-tooltip {
      display: none;
    }

    .pipeline-meter div {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .pipeline-meter div:last-child {
      border-bottom: 0;
    }
  }
</style>
