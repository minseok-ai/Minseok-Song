<!-- Dedicated PDF Document Modal Viewer for Profile Page -->
<div id="pdf-modal" class="pdf-modal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="pdf-modal-backdrop" id="pdf-modal-backdrop"></div>
  <div class="pdf-modal-container">
    <header class="pdf-modal-header">
      <div class="pdf-modal-title-wrap">
        <svg class="pdf-modal-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M8.21 13.89L7 22l5-3 5 3-1.21-8.11" fill="none" stroke="currentColor" stroke-width="2"/>
        </svg>
        <h3 id="pdf-modal-title">Verified Credential Viewer</h3>
      </div>
      <div class="pdf-modal-actions">
        <a id="pdf-modal-download" class="pdf-modal-action-btn" href="#" target="_blank" rel="noopener noreferrer" title="Open in new tab / Download">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6m4-3h6v6m-11 5L21 3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Open in New Tab</span>
        </a>
        <button id="pdf-modal-close" class="pdf-modal-action-btn pdf-close-btn" type="button" aria-label="Close">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </header>
    <div class="pdf-modal-body">
      <div id="pdf-modal-canvas-viewer" class="pdf-canvas-viewer" style="display: none;"></div>
      <iframe id="pdf-modal-iframe" src="" title="PDF Document Viewer" loading="lazy"></iframe>
      <video id="pdf-modal-video" src="" controls playsinline preload="metadata" style="display: none; width: 100%; height: 100%; object-fit: contain; background: #000;"></video>
    </div>
  </div>
</div>

<script is:inline>
  let pdfjsPromise = null;
  function loadPdfJs() {
    if (window.pdfjsLib) return Promise.resolve(window.pdfjsLib);
    if (pdfjsPromise) return pdfjsPromise;
    pdfjsPromise = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = '/vendor/pdfjs/pdf.min.js';
      script.onload = () => {
        if (window.pdfjsLib) {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = '/vendor/pdfjs/pdf.worker.min.js';
          resolve(window.pdfjsLib);
        } else {
          reject(new Error('PDF.js not available'));
        }
      };
      script.onerror = reject;
      document.head.appendChild(script);
    });
    return pdfjsPromise;
  }

  let currentPdfRenderToken = 0;
  async function renderPdfOnCanvas(src, container) {
    const renderToken = ++currentPdfRenderToken;
    container.innerHTML = '<div class="pdf-loading-spinner"><div class="spinner"></div><span>문서 로딩 중...</span></div>';
    
    try {
      const [pdfjs, fileRes] = await Promise.all([
        loadPdfJs(),
        fetch(src).then(r => {
          if (!r.ok) throw new Error(`HTTP error ${r.status}`);
          return r.arrayBuffer();
        })
      ]);
      if (renderToken !== currentPdfRenderToken) return;

      const loadingTask = pdfjs.getDocument({ data: fileRes });
      const pdf = await loadingTask.promise;
      if (renderToken !== currentPdfRenderToken) return;
      
      container.innerHTML = '';
      for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
        if (renderToken !== currentPdfRenderToken) return;
        const page = await pdf.getPage(pageNum);
        const unscaledViewport = page.getViewport({ scale: 1.0 });
        
        const containerWidth = Math.min(window.innerWidth - 32, 860);
        const scale = Math.max(1.0, Math.min(2.5, (containerWidth / unscaledViewport.width) * (window.devicePixelRatio || 1.2)));
        const viewport = page.getViewport({ scale });
        
        const pageWrap = document.createElement('div');
        pageWrap.className = 'pdf-page-canvas-wrap';
        
        const canvas = document.createElement('canvas');
        canvas.className = 'pdf-page-canvas';
        const ctx = canvas.getContext('2d');
        canvas.height = viewport.height;
        canvas.width = viewport.width;
        canvas.style.width = '100%';
        canvas.style.height = 'auto';
        
        const pageBadge = document.createElement('span');
        pageBadge.className = 'pdf-page-number-badge';
        pageBadge.textContent = `${pageNum} / ${pdf.numPages}`;
        
        pageWrap.appendChild(canvas);
        pageWrap.appendChild(pageBadge);
        container.appendChild(pageWrap);
        
        await page.render({
          canvasContext: ctx,
          viewport: viewport
        }).promise;
      }
    } catch (err) {
      console.warn('PDF.js mobile render error:', err);
      if (renderToken === currentPdfRenderToken) {
        container.innerHTML = `
          <div class="pdf-render-fallback">
            <p>모바일 인라인 뷰어를 로드하는 중 오류가 발생했습니다.</p>
            <a href="${src}" target="_blank" rel="noopener noreferrer" class="pdf-fallback-btn">새 탭에서 열기</a>
          </div>
        `;
      }
    }
  }

  function initPdfModal() {
    const modal = document.getElementById('pdf-modal');
    const backdrop = document.getElementById('pdf-modal-backdrop');
    const closeBtn = document.getElementById('pdf-modal-close');
    const iframe = document.getElementById('pdf-modal-iframe');
    const canvasViewer = document.getElementById('pdf-modal-canvas-viewer');
    const video = document.getElementById('pdf-modal-video');
    const titleEl = document.getElementById('pdf-modal-title');
    const downloadLink = document.getElementById('pdf-modal-download');
    
    if (!modal) return;

    function openPdf(src, title) {
      const isVideo = src.toLowerCase().endsWith('.mp4') || src.toLowerCase().endsWith('.webm');
      const isMobile = window.innerWidth <= 768;

      if (titleEl) titleEl.textContent = title || (isVideo ? "Video Demonstration" : "Verified Credential Viewer");
      if (downloadLink) {
        downloadLink.href = src;
        const linkSpan = downloadLink.querySelector('span');
        if (linkSpan) linkSpan.textContent = isVideo ? "Watch Original" : "Open in New Tab";
      }

      if (isVideo && video) {
        if (canvasViewer) { canvasViewer.style.display = 'none'; canvasViewer.innerHTML = ''; }
        if (iframe) { iframe.style.display = 'none'; iframe.src = ''; }
        video.style.display = 'block';
        video.src = src;
        video.load();
        video.currentTime = 0;
        video.play().catch((err) => {
          console.warn("Video playback:", err);
        });
      } else if (isMobile && canvasViewer) {
        if (video) { video.pause(); video.style.display = 'none'; video.src = ''; }
        if (iframe) { iframe.style.display = 'none'; iframe.src = ''; }
        canvasViewer.style.display = 'flex';
        renderPdfOnCanvas(src, canvasViewer);
      } else if (iframe) {
        if (video) { video.pause(); video.style.display = 'none'; video.src = ''; }
        if (canvasViewer) { canvasViewer.style.display = 'none'; canvasViewer.innerHTML = ''; }
        iframe.style.display = 'block';
        iframe.src = src;
      }

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closePdf() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      if (video) {
        video.pause();
        video.src = '';
      }
      if (iframe) {
        iframe.src = '';
      }
      if (canvasViewer) {
        currentPdfRenderToken++;
        canvasViewer.innerHTML = '';
        canvasViewer.style.display = 'none';
      }
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.card-pdf-link').forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const src = btn.dataset.pdfSrc;
        const title = btn.dataset.pdfTitle;
        if (src) openPdf(src, title);
      };
    });

    if (backdrop) backdrop.onclick = closePdf;
    if (closeBtn) closeBtn.onclick = closePdf;
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closePdf();
    });
  }

  initPdfModal();

  const identityFigure = document.querySelector('.identity-figure');
  if (identityFigure) {
    identityFigure.addEventListener('mousemove', (e) => {
      const rect = identityFigure.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -10;
      const rotateY = ((x - centerX) / centerX) * 10;
      
      identityFigure.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });
    
    identityFigure.addEventListener('mouseleave', () => {
      identityFigure.style.transform = 'rotateX(0) rotateY(0)';
      identityFigure.style.transition = 'transform var(--motion-slow) ease';
    });
    
  }

  const signalCards = document.querySelectorAll('.signal-strip div');
  signalCards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -5;
      const rotateY = ((x - centerX) / centerX) * 5;
      
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
    });
    
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
      card.style.transition = 'all 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    
    card.addEventListener('mouseenter', () => {
      card.style.transition = 'border-color 0.5s ease, box-shadow 0.5s ease'; // Remove transform from transition during hover
    });
  });

  // 3D True Perspective Engine for SVG
  const latticeWrapper = document.querySelector('.lattice-interaction-area');
  const svg3d = document.querySelector('.true-3d-lattice');
  
  if (latticeWrapper && svg3d) {
    const edgesGroup = svg3d.querySelector('.edges-group');
    const nodesGroup = svg3d.querySelector('.nodes-group');
    const particlesGroup = svg3d.querySelector('.particles-group');

    // Network Topology (Adjusted for perfect hexagons)
    const planeNodes = [
      {x: -280, y: 0},
      {x: -210, y: -40}, {x: -210, y: 40},
      {x: -140, y: 0},
      {x: -70, y: -40},  {x: -70, y: 40},
      {x: 0, y: 0},
      {x: 70, y: -40},   {x: 70, y: 40},
      {x: 140, y: 0},
      {x: 210, y: -40},  {x: 210, y: 40},
      {x: 280, y: 0}
    ];

    const planeEdges = [
      [0,1], [0,2], [1,3], [2,3],
      [3,4], [3,5], [4,6], [5,6],
      [6,7], [6,8], [7,9], [8,9],
      [9,10], [9,11], [10,12], [11,12],
      [1,5], [2,4], [4,8], [5,7], [7,11], [8,10]
    ];

    // Z-coordinates for L1 (Front), L2 (Middle), L3 (Back)
    const layersZ = [-150, 0, 150];
    const allNodes = [];
    const allEdges = [];

    // Construct 3D Nodes
    layersZ.forEach((z, lIdx) => {
      planeNodes.forEach(n => {
        allNodes.push({ x: n.x, y: n.y, z: z, layer: lIdx });
      });
    });

    const L_OFFSET = 13;
    layersZ.forEach((_, lIdx) => {
      // Intra-layer tight binding
      planeEdges.forEach(edge => {
        allEdges.push({ 
          from: edge[0] + lIdx * L_OFFSET, 
          to: edge[1] + lIdx * L_OFFSET,
          type: 'intra', layer: lIdx 
        });
      });
      // Inter-layer vertical hopping & synaptic connections for perceptron feel
      if (lIdx < 2) {
        // Fully Connected (Dense) layer connections
        for(let i=0; i<13; i++) {
          for(let j=0; j<13; j++) {
            if (i === j) {
              // 1. Direct vertical hopping
              allEdges.push({
                from: i + lIdx * L_OFFSET,
                to: j + (lIdx + 1) * L_OFFSET,
                type: 'inter'
              });
            } else {
              // 2. Dense perceptron connections (every node connects to every node in next layer)
              allEdges.push({
                from: i + lIdx * L_OFFSET,
                to: j + (lIdx + 1) * L_OFFSET,
                type: 'synapse'
              });
            }
          }
        }
      }
    });

    // SNN Hopping Particles State Machine
    const particles = [
      { path: [0, 1, 4, 6, 8, 11, 12], currentIndex: 0, state: 'CHARGING', charge: 0.1, chargeRate: 0.015, color: 'var(--color-accent)' },
      { path: [0, 14, 17, 32, 34, 37, 38], currentIndex: 0, state: 'CHARGING', charge: 0.4, chargeRate: 0.012, color: 'var(--color-accent-ink)' },
      { path: [26, 28, 18, 6, 7, 23, 25], currentIndex: 0, state: 'CHARGING', charge: 0.8, chargeRate: 0.018, color: 'var(--color-ink)' },
      { path: [5, 7, 9, 10, 12, 8, 6], currentIndex: 0, state: 'CHARGING', charge: 0.2, chargeRate: 0.014, color: 'var(--color-warm)' },
      { path: [2, 4, 6, 8, 10, 12, 11], currentIndex: 0, state: 'CHARGING', charge: 0.6, chargeRate: 0.02, color: 'var(--color-green)' }
    ];

    // DOM Generation
    const edgeEls = allEdges.map(e => {
      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
      if (e.type === 'inter') {
        line.setAttribute("stroke", "var(--color-warm)");
        line.setAttribute("stroke-opacity", "0.3");
        line.setAttribute("stroke-width", "1");
        line.setAttribute("stroke-dasharray", "2 4");
      } else if (e.type === 'synapse') {
        line.setAttribute("stroke", "var(--color-warm)");
        line.setAttribute("stroke-opacity", "0.15"); // Make it clearly visible
        line.setAttribute("stroke-width", "0.8"); // Slightly thicker to be seen easily
      } else {
        line.setAttribute("stroke", "var(--color-warm)");
        line.setAttribute("stroke-opacity", e.layer === 0 ? "0.5" : e.layer === 1 ? "0.2" : "0.1");
        line.setAttribute("stroke-width", "1.5");
      }
      edgesGroup.appendChild(line);
      return line;
    });

    const nodeEls = allNodes.map(n => {
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("class", "lattice-node");
      circle.setAttribute("stroke-width", "1.5");
      circle.setAttribute("opacity", n.layer === 0 ? "0.8" : n.layer === 1 ? "0.4" : "0.15");
      nodesGroup.appendChild(circle);
      return circle;
    });

    const particleEls = particles.map(p => {
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("class", "lattice-particle");
      circle.setAttribute("filter", "url(#neural-glow)");
      particlesGroup.appendChild(circle);
      return circle;
    });

    let targetRotX = 0, targetRotY = 0;
    let currentRotX = 0, currentRotY = 0;
    // Base angle with 0 yaw (RotY = 0) so the lattice aligns perfectly horizontally.
    const baseRotX = -0.6, baseRotY = 0;

    let isDragging = false;
    let lastMouseX = 0, lastMouseY = 0;
    let activePointerId = null;
    const maxRotX = 0.35, maxRotY = 0.5;

    latticeWrapper.style.cursor = 'grab';

    const startDrag = (e) => {
      isDragging = true;
      activePointerId = e.pointerId;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      latticeWrapper.style.cursor = 'grabbing';
      latticeWrapper.setPointerCapture?.(e.pointerId);
      e.preventDefault();
    };

    const moveDrag = (e) => {
      if (!isDragging) return;
      if (activePointerId !== null && e.pointerId !== activePointerId) return;
      
      const deltaX = e.clientX - lastMouseX;
      const deltaY = e.clientY - lastMouseY;
      
      // Update target rotations continuously relative to previous targets
      targetRotY += deltaX * 0.005;
      targetRotX += deltaY * 0.005;
      
      // Clamp to limits to avoid flipping the diagram over
      targetRotY = Math.max(-maxRotY, Math.min(maxRotY, targetRotY));
      targetRotX = Math.max(-maxRotX, Math.min(maxRotX, targetRotX));
      
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      e.preventDefault();
    };

    const endDrag = (e) => {
      if (activePointerId !== null && e.pointerId !== activePointerId) return;
      isDragging = false;
      activePointerId = null;
      latticeWrapper.style.cursor = 'grab';
      latticeWrapper.releasePointerCapture?.(e.pointerId);
    };

    latticeWrapper.addEventListener('pointerdown', startDrag);
    window.addEventListener('pointermove', moveDrag, { passive: false });
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    const FL = 800;
    function renderLoop() {
      currentRotX += (targetRotX - currentRotX) * 0.08;
      currentRotY += (targetRotY - currentRotY) * 0.08;

      const rx = baseRotX + currentRotX;
      const ry = baseRotY + currentRotY;

      const cosX = Math.cos(rx), sinX = Math.sin(rx);
      const cosY = Math.cos(ry), sinY = Math.sin(ry);

      const projNodes = allNodes.map(n => {
        const x1 = n.x * cosY - n.z * sinY;
        const z1 = n.z * cosY + n.x * sinY;
        const y2 = n.y * cosX - z1 * sinX;
        
        // Orthographic projection (scale = 1.0) ensures all Z-lines remain 
        // perfectly parallel, creating a clean, aligned architectural diagram look.
        return { x: x1 + 400, y: y2 + 220, scale: 1.0 };
      });

      allEdges.forEach((e, i) => {
        const p1 = projNodes[e.from], p2 = projNodes[e.to];
        edgeEls[i].setAttribute("x1", p1.x); edgeEls[i].setAttribute("y1", p1.y);
        edgeEls[i].setAttribute("x2", p2.x); edgeEls[i].setAttribute("y2", p2.y);
      });

      allNodes.forEach((n, i) => {
        const p = projNodes[i];
        nodeEls[i].setAttribute("cx", p.x); nodeEls[i].setAttribute("cy", p.y);
        nodeEls[i].setAttribute("r", (n.layer === 0 ? 3.5 : n.layer === 1 ? 2.5 : 1.5) * p.scale);
      });

      particles.forEach((p, i) => {
        const totalSegments = p.path.length - 1;
        const n1 = projNodes[p.path[p.currentIndex]];
        const n2 = projNodes[p.path[Math.min(p.currentIndex + 1, totalSegments)]];
        
        let cx = n1.x;
        let cy = n1.y;
        let r = 0;
        let opacity = 1;

        if (p.state === 'CHARGING') {
          p.charge += p.chargeRate;
          r = 2 + (p.charge * 3); // Swell up as potential increases
          opacity = 0.3 + (p.charge * 0.7);
          
          if (p.charge >= 1) {
            p.state = 'HOPPING';
            p.hopProgress = 0;
          }
        } else if (p.state === 'HOPPING') {
          p.hopProgress += 0.08; // Smooth and fast spike
          
          // Ease-in-out for a more polished transition along the straight edge
          const t = p.hopProgress < 0.5 
            ? 2 * p.hopProgress * p.hopProgress 
            : 1 - Math.pow(-2 * p.hopProgress + 2, 2) / 2;
          
          // Straight line interpolation (no arc)
          cx = n1.x + (n2.x - n1.x) * t;
          cy = n1.y + (n2.y - n1.y) * t;
          
          // Spiking visual (slight glow and size increase, no massive pump)
          r = 2.5 + Math.sin(t * Math.PI) * 2; 
          opacity = 1;
          
          if (p.hopProgress >= 1) {
            p.currentIndex++;
            if (p.currentIndex >= totalSegments) {
               p.currentIndex = 0; 
            }
            p.state = 'COOLING';
            p.coolTimer = 0;
          }
        } else if (p.state === 'COOLING') {
          p.coolTimer += 0.05;
          cx = n1.x; // Stay at the new node
          cy = n1.y;
          r = 1.5; 
          opacity = 0.15; 
          
          if (p.coolTimer >= 1) {
             p.state = 'CHARGING';
             p.charge = 0;
             // Add randomness to next charge rate to simulate asynchronous SNN firing
             p.chargeRate = 0.008 + Math.random() * 0.015;
          }
        }

        particleEls[i].setAttribute("cx", cx);
        particleEls[i].setAttribute("cy", cy);
        particleEls[i].setAttribute("r", r * ((n1.scale + n2.scale) / 2));
        particleEls[i].setAttribute("opacity", opacity);
      });

      requestAnimationFrame(renderLoop);
    }
    renderLoop();
  }

  // Synchronized Lenticular Caption Indicator
  const modeTextEl = document.getElementById('lenticular-mode-indicator');
  if (modeTextEl) {
    let showPortrait = true;
    setInterval(() => {
      showPortrait = !showPortrait;
      modeTextEl.style.opacity = '0';
      setTimeout(() => {
        modeTextEl.textContent = showPortrait ? 'Strategist Portrait' : 'Physics Cohort Archive';
        modeTextEl.style.opacity = '1';
      }, 400);
    }, 5000);
  }
</script>

