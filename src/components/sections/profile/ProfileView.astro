---
const { page, navItem, hero } = Astro.props;

const visibleBlocks = (page.blocks ?? []).filter((block) => !block.hidden);
const timelineBlock = visibleBlocks.find((block) => block.type === "timeline");
const leadBlock = visibleBlocks.find(
  (block) => block.type === "text" && block.variant === "lead"
);
const calloutBlock = visibleBlocks.find((block) => block.type === "callout");
const statBlock = visibleBlocks.find((block) => block.type === "stats");
---

<div class="page-kicker">
  <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
  <i></i>
  <strong>Self interview</strong>
</div>

<section class="about-hero">
  <figure class="identity-figure" aria-label="Minseok Song identity diagram">
    <div class="identity-orbit">
      <div class="profile-center" style="position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; overflow: hidden;">
        <div class="profile-bg" style="position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; background-image: url('/profile.jpg'); background-size: cover; background-position: center;"></div>
      </div>
      <div class="orbit-ring">
        <span class="orbit-node node-a"></span>
        <span class="orbit-node node-b"></span>
        <span class="orbit-node node-c"></span>
      </div>
    </div>
    <figcaption>
      <span>Fig. 00 — Self</span>
      <span>Strategy · AI · Operating Systems</span>
    </figcaption>
  </figure>

  <div class="about-statement">
    <svg viewBox="0 0 620 120" aria-hidden="true">
      <polyline
        points="18,84 108,46 188,70 274,42 370,68 470,36 600,54"
        fill="none"
        stroke="currentColor"
        stroke-dasharray="2 8"
      />
      {[18, 108, 188, 274, 370, 470, 600].map((x, index) => (
        <circle cx={x} cy={[84, 46, 70, 42, 68, 36, 54][index]} r={index === 0 || index === 6 ? 6 : 4} />
      ))}
    </svg>
    <blockquote>
      "{calloutBlock?.body ??
        "A1 Firms is organized around one practical question: how can ambiguous strategy work become clearer decisions, better tools, and repeatable operating habits?"}"
    </blockquote>
  </div>
</section>

<section class="about-thesis">
  <aside class="sticky-timeline">
    <span class="micro-label">Timeline / Sticky</span>
    <ol>
      {(timelineBlock?.events ?? [
        {
          date: "Now",
          title: "A1 Firms foundation",
          body: "Design, product, and operating systems are being composed into one public surface."
        }
      ]).map((event, index) => (
        <li class={index === 0 ? "is-current" : ""}>
          <span>{event.date}</span>
          <strong>{event.title}</strong>
          {event.body && <small>{event.body}</small>}
        </li>
      ))}
    </ol>
  </aside>

  <article class="thesis-copy">
    <p class="micro-label">§ 1 — The Operating Question</p>
    <h1>{hero.title}</h1>
    <p class="lead-copy">
      {leadBlock?.body ??
        "I build structured ways to turn ambiguous strategic questions into usable systems, product surfaces, and durable operating habits."}
    </p>
    <div class="essay-columns">
      <p>
        A1 is not framed as a portfolio of disconnected work. It is a
        public operating layer for strategy, software, research, and the
        habits that make those things repeatable.
      </p>
      <p>
        The site should therefore behave less like a brochure and more
        like a map: where the person, the firm, the product, the writing,
        and the contact surface each have a distinct role.
      </p>
    </div>
    {statBlock && (
      <dl class="signal-strip">
        {statBlock.stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
            {stat.description && <p>{stat.description}</p>}
          </div>
        ))}
      </dl>
    )}
  </article>
</section>

<script is:inline>
  const identityFigure = document.querySelector('.identity-figure');
  if (identityFigure) {
    identityFigure.addEventListener('mousemove', (e) => {
      const rect = identityFigure.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -10;
      const rotateY = ((x - centerX) / centerX) * 10;
      
      identityFigure.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });
    
    identityFigure.addEventListener('mouseleave', () => {
      identityFigure.style.transform = 'rotateX(0) rotateY(0)';
      identityFigure.style.transition = 'transform var(--motion-slow) ease';
    });
    
    identityFigure.addEventListener('mouseenter', () => {
      identityFigure.style.transition = 'none';
    });
  }
</script>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1.35fr);
    gap: 72px;
    align-items: end;
    min-height: 650px;
  }

  .identity-figure {
    display: grid;
    gap: 22px;
    margin: 0;
    perspective: 1000px;
    transform-style: preserve-3d;
    transition: transform var(--motion-slow) ease;
  }

  .identity-orbit {
    position: relative;
    display: grid;
    place-items: center;
    width: min(520px, 100%);
    aspect-ratio: 1;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    background:
      radial-gradient(circle at 48% 42%, rgba(248, 247, 242, 0.1), transparent 34%),
      #050505;
    outline: 1px solid var(--color-line);
    outline-offset: 12px;
  }

  .orbit-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: orbitSpin 24s linear infinite;
    pointer-events: none;
  }

  @keyframes orbitSpin {
    100% { transform: rotate(360deg); }
  }

  .orbit-node {
    position: absolute;
    width: 13px;
    height: 13px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-paper);
  }

  .node-a { top: 20%; right: 22%; }
  .node-b { bottom: 23%; left: 18%; }
  .node-c { right: 17%; bottom: 18%; background: var(--color-ink); }

  .identity-figure figcaption {
    display: grid;
    gap: 8px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .about-statement {
    display: grid;
    gap: 28px;
  }

  .about-statement svg {
    width: min(680px, 100%);
    height: auto;
    color: var(--color-ink-soft);
  }

  .about-statement polyline {
    animation: dashTicker 0.8s linear infinite;
  }

  @keyframes dashTicker {
    to { stroke-dashoffset: -10; }
  }

  .about-statement circle {
    fill: var(--color-paper);
    stroke: currentColor;
  }

  .about-statement blockquote {
    margin: 0;
    max-width: 820px;
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 760;
    line-height: 1.22;
  }

  .about-thesis {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 88px;
    align-items: start;
  }

  .sticky-timeline {
    position: sticky;
    top: calc(var(--header-height) + 32px);
  }

  .sticky-timeline ol {
    display: grid;
    gap: 0;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .sticky-timeline li {
    position: relative;
    display: grid;
    gap: 5px;
    padding: 0 0 28px 26px;
    color: var(--color-ink-muted);
  }

  .sticky-timeline li::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 0;
    width: 10px;
    height: 10px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--color-paper);
  }

  .sticky-timeline li::after {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 2px;
    left: 5px;
    width: 1px;
    background: var(--color-line);
  }

  .sticky-timeline li.is-current {
    color: var(--color-ink);
  }

  .sticky-timeline li.is-current::before {
    background: var(--color-ink);
  }

  .sticky-timeline span,
  .sticky-timeline strong,
  .sticky-timeline small {
    display: block;
  }

  .sticky-timeline span {
    font-size: 12px;
    font-weight: 800;
  }

  .sticky-timeline small {
    font-size: 12px;
    line-height: 1.45;
  }

  .thesis-copy {
    border-left: 1px solid var(--color-line-strong);
    padding-left: 32px;
  }

  .thesis-copy h1 {
    margin: 0;
    max-width: 960px;
    font-family: var(--font-serif);
    font-size: clamp(2.45rem, 3.65vw, 3.55rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .lead-copy {
    margin: 32px 0 0;
    max-width: 820px;
    font-size: clamp(1.35rem, 2.1vw, 1.8rem);
    font-weight: 700;
    line-height: 1.36;
  }

  .essay-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 42px;
    color: var(--color-ink-soft);
    font-size: 17px;
    line-height: 1.75;
  }

  .signal-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 44px 0 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .signal-strip div {
    padding: 22px;
    border-right: 1px solid var(--color-line);
  }

  .signal-strip div:last-child {
    border-right: 0;
  }

  .signal-strip dt {
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .signal-strip dd {
    margin: 8px 0 0;
    font-size: 2.6rem;
    font-weight: 900;
    line-height: 1;
  }

  .signal-strip p {
    margin: 8px 0 0;
    color: var(--color-ink-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  @media (max-width: 1180px) {
    .about-hero,
    .about-thesis {
      grid-template-columns: 1fr;
    }

    .thesis-copy h1 {
      font-size: clamp(2.25rem, 6vw, 3rem);
    }

    .sticky-timeline {
      position: static;
    }
  }

  @media (max-width: 760px) {
    .about-hero {
      min-height: auto;
      gap: 44px;
    }

    .about-statement blockquote {
      font-size: 2.05rem;
    }

    .thesis-copy {
      padding-left: 20px;
    }

    .thesis-copy h1 {
      font-size: clamp(1.95rem, 8vw, 2.45rem);
    }

    .lead-copy {
      font-size: 1.45rem;
    }

    .essay-columns,
    .signal-strip {
      grid-template-columns: 1fr;
    }

    .signal-strip div {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .signal-strip div:last-child {
      border-bottom: 0;
    }
  }
</style>
