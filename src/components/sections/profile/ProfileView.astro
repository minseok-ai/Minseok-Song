</section>

<section class="about-intro-section reveal-up stagger-1">
  <div class="intro-card card-view">
    <div class="intro-card-head">
      <span class="intro-tag">EXECUTION FIRST</span>
    </div>
    <p class="intro-text">
      {calloutBlock?.body ??
        "My strength is Proactive Execution—transforming complex technical challenges into valuable Deep Tech strategies."}
    </p>
  </div>
</section>

<section id="profile-thesis" class="about-thesis">
  <aside class="sticky-timeline">
    <div class="timeline-group">
      <span class="micro-label">Research Experience</span>
      <ol class="timeline-list">
        {timelineEvents.map((event, index) => (
          <li class={`reveal-in stagger-${(index % 5) + 1} ${index === 0 ? "is-current" : ""}`}>
            {(event.title.includes('NNFC') || event.title.includes('R&D') || event.body.includes('NNFC') || event.body.includes('Nanomaterials')) && <img src="/NNFC-logo.webp" alt="KAIST NNFC" class="timeline-logo" />}
            {(event.title.includes('KRISS') || event.body.includes('KRISS') || event.body.includes('Non-Destructive')) && <img src="/KRISS-logo.webp" alt="KRISS" class="timeline-logo" />}
            {(event.title.includes('CNU') || event.title.includes('Chungnam') || event.body.includes('IQS') || event.body.includes('Quantum') || event.body.includes('CNU')) && <img src="/CNU-logo.webp" alt="CNU" class="timeline-logo" />}
            
            <div class="timeline-content">
              <span>{event.date}</span>
              <strong>{event.title}</strong>
              {event.body && <small>{event.body}</small>}
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="timeline-divider"></div>

    <div class="timeline-group">
      <span class="micro-label">Education</span>
      <ol class="timeline-list">
        <li class="reveal-in stagger-4">
          <img src="/CNU-logo.webp" alt="Chungnam National University" class="timeline-logo" />
          <div class="timeline-content">
            <span>Mar 2017 - Feb 2026</span>
            <strong>Chungnam National University</strong>
            <small>B.S. in Physics (Semiconductor-Energy Convergence Science)</small>
          </div>
        </li>
      </ol>
    </div>
  </aside>

  <article class="thesis-copy">
    <p class="micro-label">01 / The Operating Question</p>
    <h1>{hero.title}</h1>
    <p class="lead-copy reveal-up">
      {leadBlock?.body ??
        "I build structured ways to turn ambiguous strategic questions into usable systems, product surfaces, and durable operating habits."}
    </p>
    <div class="essay-columns reveal-up stagger-1">
      {visibleBlocks
        .filter((block) => block.type === "text" && block.variant === "body")
        .map((block) => (
          <p>{block.body}</p>
        ))}
    </div>
    {statBlock && (
      <dl class="signal-strip reveal-up stagger-2">
        {statBlock.stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
            {stat.description && <p>{stat.description}</p>}
          </div>
