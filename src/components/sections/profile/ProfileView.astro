    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(138, 180, 248, 0.15);
  }

  .ra1-thm-chip:hover .chip-arrow {
    transform: translate(1px, -1px);
    color: var(--color-ink);
  }

  html[data-theme="light"] .ra1-thm-chip {
    background: rgba(26, 115, 232, 0.1);
    border-color: rgba(26, 115, 232, 0.15);
  }

  html[data-theme="light"] .ra1-thm-chip:hover {
    background: rgba(26, 115, 232, 0.15);
    border-color: rgba(26, 115, 232, 0.3);
    box-shadow: 0 4px 12px rgba(26, 115, 232, 0.15);
  }

  .lattice-interaction-area {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
  }

  .ra1-thm-chip .chip-dot {
    width: 6px;
    height: 6px;
    min-width: 6px;
    min-height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: var(--ra1-color);
    box-shadow: 0 0 10px var(--ra1-color), 0 0 4px rgba(255, 255, 255, 0.5);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    position: relative;
  }

  .ra1-thm-chip .chip-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--ra1-color);
    opacity: 0.4;
    animation: ra1DotPulse 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes ra1DotPulse {
    0% { transform: scale(0.8); opacity: 0.5; }
    50% { transform: scale(1.5); opacity: 0; }
    100% { transform: scale(0.8); opacity: 0; }
  }

  .ra1-thm-chip .chip-muted {
    color: var(--color-ink-muted); /* Theme-aware muted color */
    font-weight: 500;
  }

  .card-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent, #10b981);
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  .about-statement svg {
    width: 100%;
    max-width: 700px;
    height: auto;
    margin: 0 auto;
    color: var(--color-ink-soft);
    transform-style: preserve-3d;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
    filter: drop-shadow(0 10px 30px rgba(138, 180, 248, 0.1));
  }

  .about-statement polyline {
    animation: dashTicker 0.8s linear infinite;
  }

  @keyframes dashTicker {
    to { stroke-dashoffset: -10; }
  }

  /* Global styles for dynamically injected SVG elements */
  .true-3d-lattice :global(.lattice-node) {
    fill: var(--color-paper, #dfdbd2);
    stroke: #8b5cf6; /* RA1 Purple */
  }
  
  html[data-theme="light"] .true-3d-lattice :global(.lattice-node) {
    stroke: var(--color-warm, #a0a0a0);
  }

  .true-3d-lattice :global(.lattice-particle) {
    fill: #8b5cf6; /* RA1 Purple for moving particles */
  }

  html[data-theme="light"] .true-3d-lattice :global(.lattice-particle) {
    fill: var(--color-accent, #1a73e8);
  }

  /* Intro Card Section */
  .about-intro-section {
    margin-top: 0;
    margin-bottom: 0;
  }

  .intro-card.card-view {
    position: relative;
    padding: 34px 44px 32px;
    background: var(--color-panel);
    border: 1px solid var(--glass-border);
    border-left: 3px solid var(--color-warm, #e0a868);
    border-radius: 16px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .intro-card-head {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .intro-tag {
    font-family: var(--font-mono, monospace);
    font-size: 10.5px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .intro-card .intro-text {
    margin: 0;
    font-family: "Noto Serif KR", "Noto Serif", serif;
    font-size: clamp(1.08rem, 1.45vw, 1.25rem);
    font-weight: 400;
    font-style: normal;
    line-height: 1.65;
    color: var(--color-ink);
    text-wrap: balance;
  }

  @media (max-width: 768px) {
    .intro-card.card-view {
      padding: 24px 24px;
    }
  }

  @media (max-width: 768px) {
    .about-statement.card-view {
      padding: 34px 28px 38px;
    }

    .lattice-interaction-area {
      min-height: clamp(180px, 56vw, 230px);
      margin-inline: -10px;
    }

    .about-statement svg {
      width: min(112%, 360px);
      max-width: none;
    }

    .about-intro-section {
      margin-top: 18px;
    }

    .intro-card.card-view {
      padding: 32px 24px;
    }
  }

  .about-thesis {
    display: grid;
    grid-template-columns: 380px minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  /* Sticky Timeline with Restored Floating Logos - Vertically Centered on Scroll */
  .sticky-timeline {
    position: sticky;
    top: max(100px, calc(50vh - 210px));
    align-self: flex-start;
    padding-top: 4px;
    padding-left: 40px;
    transition: top 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @media (max-width: 1180px) {
    .sticky-timeline {
      position: static;
      padding-left: 0;
    }
  }

  .sticky-timeline ol {
    position: relative;
    display: grid;
    gap: 0;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .sticky-timeline li {
    position: relative;
    padding: 0 0 28px 28px;
    color: var(--color-ink-muted);
    transition: color var(--motion-fast) ease;
  }

  .sticky-timeline li:last-child {
    padding-bottom: 0;
  }

  .timeline-content {
    display: grid;
    gap: 4px;
    transition: transform var(--motion-fast) var(--easing-spring);
  }

  .sticky-timeline li:hover {
    color: var(--color-ink);
  }

  .sticky-timeline li:hover .timeline-content {
    transform: translateX(6px);
  }

  .sticky-timeline li::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 0;
    width: 10px;
    height: 10px;
    border: 1px solid rgba(var(--rgb-warm), 0.35);
    border-radius: 0;
    transform: rotate(45deg);
    background: var(--color-field);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
  }

  .sticky-timeline li.is-current::before {
    background: rgba(var(--rgb-warm), 0.95);
    border-color: rgba(var(--rgb-warm), 1);
    box-shadow: 0 0 10px rgba(var(--rgb-warm), 0.4);
  }

  .sticky-timeline li:hover::before {
    border-color: rgba(var(--rgb-warm), 0.85);
    background: rgba(var(--rgb-warm), 0.2);
    box-shadow: 0 0 12px rgba(var(--rgb-warm), 0.4);
    transform: rotate(135deg) scale(1.2);
  }

  .sticky-timeline li::after {
    content: "";
    position: absolute;
    top: 20px;
    bottom: 2px;
    left: 4.5px;
    width: 2px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.03));
  }

  [data-theme="light"] .sticky-timeline li::after {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.03));
  }

  .sticky-timeline li:last-child::after {
    display: none;
  }

  .timeline-logo {
    position: absolute;
    left: -42px;
    top: 3px;
    width: 28px;
    height: 28px;
    object-fit: contain;
    opacity: 0.45;
    filter: grayscale(0.8) contrast(0.85);
    transform: translateX(-6px);
    transition: opacity 0.4s ease, transform 0.4s var(--easing-spring), filter 0.4s ease;
    pointer-events: none;
    z-index: 10;
  }

  .sticky-timeline li.is-current .timeline-logo {
    opacity: 0.9;
    filter: grayscale(0.2) contrast(1);
    transform: translateX(0);
  }

  .sticky-timeline li:hover .timeline-logo {
    opacity: 1;
    filter: grayscale(0) contrast(1) drop-shadow(0 0 8px rgba(var(--rgb-warm), 0.35));
    transform: translateX(0) scale(1.08);
  }

  @media (max-width: 1180px) {
    .timeline-logo {
      left: auto;
      right: 0;
      top: -12px;
      transform: translateY(16px);
    }

    .sticky-timeline li.is-current .timeline-logo {
      transform: translateY(0);
    }

    .sticky-timeline li:hover .timeline-logo {
      transform: translateY(0) scale(1.08);
    }
  }

  .sticky-timeline span {
    font-size: 12px;
    font-weight: 800;
    color: var(--color-accent-ink);
  }

  .sticky-timeline strong {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.35;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .sticky-timeline small {
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--color-ink-muted);
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .timeline-group {
    position: relative;
  }

  .timeline-divider {
    height: 1px;
    margin: 28px 0 24px;
    background: linear-gradient(90deg, rgba(var(--rgb-warm), 0.3) 0%, rgba(255, 255, 255, 0.08) 50%, transparent 100%);
  }

  [data-theme="light"] .timeline-divider {
    background: linear-gradient(90deg, rgba(var(--rgb-warm), 0.4) 0%, rgba(0, 0, 0, 0.08) 50%, transparent 100%);
  }

  .thesis-copy {
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    padding-left: 42px;
    position: relative;
    padding-top: 4px;
  }
  
  .thesis-copy::before {
    content: '';
    position: absolute;
    top: 0;
    left: -1px;
