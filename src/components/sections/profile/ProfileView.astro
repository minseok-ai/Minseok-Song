    height: 60px;
    background: linear-gradient(to bottom, rgba(var(--rgb-warm), 0.6), transparent);
  }

  .thesis-copy h1 {
    margin: 0;
    max-width: 960px;
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 3.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .lead-copy {
    margin: 28px 0 0;
    max-width: 860px;
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.7vw, 1.55rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .essay-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 42px;
    color: var(--color-ink-soft);
    font-size: 17px;
    line-height: 1.75;
  }

  .essay-columns p {
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.055);
  }

  .signal-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 44px 0 0;
    border: none;
  }

  .signal-strip div {
    position: relative;
    padding: 28px 24px;
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-card);
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    box-shadow: 
      0 4px 20px var(--glass-shadow), 
      inset 0 1px 0 var(--color-line-strong);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .signal-strip div::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(140px circle at var(--mouse-x, 0) var(--mouse-y, 0), rgba(var(--rgb-warm), 0.08), transparent 80%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .signal-strip div::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 30px;
    height: 1px;
    background: rgba(var(--rgb-warm), 0.5);
    transition: width 0.4s ease;
  }

  .signal-strip div:hover::before {
    opacity: 1;
  }

  .signal-strip div:hover::after {
    width: 100%;
  }

  .signal-strip div:hover {
    transform: translateY(-4px);
    background: var(--color-panel-solid);
    border-color: var(--color-warm-glow);
    box-shadow: 
      0 16px 40px var(--glass-shadow), 
      inset 0 1px 0 var(--color-line-strong);
  }

  .signal-strip dt {
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .signal-strip dd {
    margin: 16px 0 0;
    font-family: var(--font-serif);
    font-size: 3.2rem;
    font-weight: 400;
    line-height: 1;
    color: var(--color-ink);
