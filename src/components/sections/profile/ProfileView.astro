          <!-- Lenticular Holographic Prism Sheen & Radar Scan Layers -->
          <div class="profile-lenticular-prism"></div>
          <div class="profile-scanner-line"></div>
          <div class="profile-grid-layer"></div>
          <div class="profile-vignette"></div>
        </div>

        <div class="orbit-ring">
          <span class="orbit-node node-a"></span>
          <span class="orbit-node node-b"></span>
          <span class="orbit-node node-c"></span>
        </div>
      </div>
    </div>

    <figcaption class="identity-caption">
      <div class="caption-header">
        <span class="caption-dot"></span>
        <span class="caption-index">Fig. 00 / Self</span>
        <span class="caption-sep">·</span>
        <span class="caption-mode" id="lenticular-mode-indicator">Strategist Portrait</span>
      </div>
      <span class="caption-role">Deep Tech & Semiconductor Technology Strategist</span>
    </figcaption>
  </figure>

  <div class="about-statement card-view">
    <div class="statement-header">
      <p class="micro-label">Core Philosophy</p>
      <a href="/projects#project-ra1" class="ra1-thm-chip" title="View RA1 Theorem Project" aria-label="View Project RA1">
        <span class="chip-dot"></span>
        <span>RA1 <span class="chip-muted">THM</span></span>
        <svg class="chip-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17L17 7M17 7H9M17 7V15"/>
        </svg>
      </a>
    </div>
    <div class="lattice-interaction-area">
      <svg viewBox="0 0 800 440" aria-hidden="true" class="true-3d-lattice" style="overflow: visible; margin-top: 10px;">
        <defs>
          <filter id="neural-glow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="3.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>

        <g filter="url(#neural-glow)">
          <g class="edges-group"></g>
          <g class="nodes-group"></g>
          <g class="particles-group"></g>
        </g>
      </svg>
