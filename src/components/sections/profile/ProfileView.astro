---
const { page, navItem, hero } = Astro.props;

const visibleBlocks = (page.blocks ?? []).filter((block) => !block.hidden);
const timelineBlock = visibleBlocks.find((block) => block.type === "timeline");
const leadBlock = visibleBlocks.find(
  (block) => block.type === "text" && block.variant === "lead"
);
const calloutBlock = visibleBlocks.find((block) => block.type === "callout");
const statBlock = visibleBlocks.find((block) => block.type === "stats");
---

<div class="page-kicker">
  <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
  <i></i>
  <strong>Self interview</strong>
</div>

<section class="about-hero">
  <figure class="identity-figure" aria-label="Minseok Song identity diagram">
    <div class="identity-orbit">
      <div class="profile-center" style="position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; overflow: hidden; border: 1px solid rgba(var(--rgb-warm), 0.3);">
        <div class="profile-bg" style="position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; background-image: url('/profile.jpg'); background-size: cover; background-position: center; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); filter: grayscale(20%) contrast(1.1);"></div>
        <div class="profile-scanner-line" style="position: absolute; left: 0; width: 100%; height: 1px; background: linear-gradient(90deg, transparent, rgba(var(--rgb-warm), 0.8), transparent); filter: drop-shadow(0 0 4px rgba(var(--rgb-warm), 0.4)); opacity: 0.6; pointer-events: none; animation: profileScanner 5s cubic-bezier(0.4, 0, 0.2, 1) infinite;"></div>
        <div class="profile-grid-layer" style="position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(rgba(var(--rgb-warm), 0.1) 1px, transparent 1px); background-size: 16px 16px; opacity: 0.5; border-radius: 50%;"></div>
        <div class="profile-vignette" style="position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.7); border-radius: 50%;"></div>
      </div>
      <div class="orbit-ring">
        <span class="orbit-node node-a"></span>
        <span class="orbit-node node-b"></span>
        <span class="orbit-node node-c"></span>
      </div>
    </div>
    <figcaption>
      <span>Fig. 00 — Self</span>
      <span>Strategy · AI · Operating Systems</span>
    </figcaption>
  </figure>

  <div class="about-statement">
    <svg viewBox="0 0 800 240" aria-hidden="true" class="true-3d-lattice" style="width: 100%; height: auto;">
      <defs>
        <filter id="neural-glow" x="-30%" y="-30%" width="160%" height="160%">
          <feGaussianBlur stdDeviation="3.5" result="blur" />
          <feMerge>
            <feMergeNode in="blur"/>
            <feMergeNode in="SourceGraphic"/>
          </feMerge>
        </filter>
      </defs>

      <g filter="url(#neural-glow)">
        <g class="edges-group"></g>
        <g class="nodes-group"></g>
        <g class="particles-group"></g>
      </g>
    </svg>
    <blockquote>
      "{calloutBlock?.body ??
        "A1 Firms is organized around one practical question: how can ambiguous strategy work become clearer decisions, better tools, and repeatable operating habits?"}"
    </blockquote>
  </div>
</section>

<section class="about-thesis">
  <aside class="sticky-timeline">
    <span class="micro-label">Timeline / Sticky</span>
    <ol>
      {(timelineBlock?.events ?? [
        {
          date: "Now",
          title: "A1 Firms foundation",
          body: "Design, product, and operating systems are being composed into one public surface."
        }
      ]).map((event, index) => (
        <li class={`reveal-in stagger-${(index % 5) + 1} ${index === 0 ? "is-current" : ""}`}>
          {event.title.includes('A1trategize') && <img src="/A1Firm-logo.webp" alt="A1trategize" class="timeline-logo" />}
          {event.title.includes('NNFC') && <img src="/NNFC-logo.webp" alt="KAIST NNFC" class="timeline-logo" />}
          {event.title.includes('KRISS') && <img src="/KRISS-logo.webp" alt="KRISS" class="timeline-logo" />}
          {event.title.includes('Chungnam National University') && <img src="/CNU-logo.webp" alt="CNU" class="timeline-logo" />}
          
          <div class="timeline-content">
            <span>{event.date}</span>
            <strong>{event.title}</strong>
            {event.body && <small>{event.body}</small>}
          </div>
        </li>
      ))}
    </ol>
  </aside>

  <article class="thesis-copy">
    <p class="micro-label">§ 1 — The Operating Question</p>
    <h1>{hero.title}</h1>
    <p class="lead-copy reveal-up">
      {leadBlock?.body ??
        "I build structured ways to turn ambiguous strategic questions into usable systems, product surfaces, and durable operating habits."}
    </p>
    <div class="essay-columns reveal-up stagger-1">
      {visibleBlocks
        .filter((block) => block.type === "text" && block.variant === "body")
        .map((block) => (
          <p>{block.body}</p>
        ))}
    </div>
    {statBlock && (
      <dl class="signal-strip reveal-up stagger-2">
        {statBlock.stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
            {stat.description && <p>{stat.description}</p>}
          </div>
        ))}
      </dl>
    )}
  </article>
</section>

<script is:inline>
  const identityFigure = document.querySelector('.identity-figure');
  if (identityFigure) {
    identityFigure.addEventListener('mousemove', (e) => {
      const rect = identityFigure.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -10;
      const rotateY = ((x - centerX) / centerX) * 10;
      
      identityFigure.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });
    
    identityFigure.addEventListener('mouseleave', () => {
      identityFigure.style.transform = 'rotateX(0) rotateY(0)';
      identityFigure.style.transition = 'transform var(--motion-slow) ease';
    });
    
  }

  const signalCards = document.querySelectorAll('.signal-strip div');
  signalCards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -5;
      const rotateY = ((x - centerX) / centerX) * 5;
      
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
    });
    
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
      card.style.transition = 'all 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    
    card.addEventListener('mouseenter', () => {
      card.style.transition = 'border-color 0.5s ease, box-shadow 0.5s ease'; // Remove transform from transition during hover
    });
  });

  // 3D True Perspective Engine for SVG
  const latticeWrapper = document.querySelector('.about-statement');
  const svg3d = document.querySelector('.true-3d-lattice');
  
  if (latticeWrapper && svg3d) {
    const edgesGroup = svg3d.querySelector('.edges-group');
    const nodesGroup = svg3d.querySelector('.nodes-group');
    const particlesGroup = svg3d.querySelector('.particles-group');

    // Network Topology (Adjusted for perfect hexagons)
    const planeNodes = [
      {x: -280, y: 0},
      {x: -210, y: -40}, {x: -210, y: 40},
      {x: -140, y: 0},
      {x: -70, y: -40},  {x: -70, y: 40},
      {x: 0, y: 0},
      {x: 70, y: -40},   {x: 70, y: 40},
      {x: 140, y: 0},
      {x: 210, y: -40},  {x: 210, y: 40},
      {x: 280, y: 0}
    ];

    const planeEdges = [
      [0,1], [0,2], [1,3], [2,3],
      [3,4], [3,5], [4,6], [5,6],
      [6,7], [6,8], [7,9], [8,9],
      [9,10], [9,11], [10,12], [11,12],
      [1,5], [2,4], [4,8], [5,7], [7,11], [8,10]
    ];

    // Z-coordinates for L1 (Front), L2 (Middle), L3 (Back)
    // Negative Z is closer to the camera in this projection formula.
    const layersZ = [-110, 0, 110];
    const allNodes = [];
    const allEdges = [];

    // Construct 3D Nodes
    layersZ.forEach((z, lIdx) => {
      planeNodes.forEach(n => {
        allNodes.push({ x: n.x, y: n.y, z: z, layer: lIdx });
      });
    });

    const L_OFFSET = 13;
    layersZ.forEach((_, lIdx) => {
      // Intra-layer tight binding
      planeEdges.forEach(edge => {
        allEdges.push({ 
          from: edge[0] + lIdx * L_OFFSET, 
          to: edge[1] + lIdx * L_OFFSET,
          type: 'intra', layer: lIdx 
        });
      });
      // Inter-layer vertical hopping
      if (lIdx < 2) {
        for(let i=0; i<13; i++) {
          allEdges.push({
            from: i + lIdx * L_OFFSET,
            to: i + (lIdx + 1) * L_OFFSET,
            type: 'inter'
          });
        }
      }
    });

    // SNN Hopping Particles
    const particles = [
      { path: [0, 1, 4, 6, 8, 11, 12], progress: 0, speed: 0.004, color: 'var(--color-accent)' },
      { path: [0, 14, 17, 32, 34, 37, 38], progress: 0.4, speed: 0.0035, color: '#a0c4ff' },
      { path: [26, 28, 18, 6, 7, 23, 25], progress: 0.8, speed: 0.0045, color: '#ffffff' }
    ];

    // DOM Generation
    const edgeEls = allEdges.map(e => {
      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
      if (e.type === 'inter') {
        line.setAttribute("stroke", "var(--color-warm)");
        line.setAttribute("stroke-opacity", "0.3");
        line.setAttribute("stroke-width", "1");
        line.setAttribute("stroke-dasharray", "2 4");
      } else {
        line.setAttribute("stroke", "var(--color-warm)");
        line.setAttribute("stroke-opacity", e.layer === 0 ? "0.5" : e.layer === 1 ? "0.2" : "0.1");
        line.setAttribute("stroke-width", "1.5");
      }
      edgesGroup.appendChild(line);
      return line;
    });

    const nodeEls = allNodes.map(n => {
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("fill", "var(--color-paper)");
      circle.setAttribute("stroke", "var(--color-warm)");
      circle.setAttribute("stroke-width", "1.5");
      circle.setAttribute("opacity", n.layer === 0 ? "0.8" : n.layer === 1 ? "0.4" : "0.15");
      nodesGroup.appendChild(circle);
      return circle;
    });

    const particleEls = particles.map(p => {
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("fill", p.color);
      particlesGroup.appendChild(circle);
      return circle;
    });

    let targetRotX = 0, targetRotY = 0;
    let currentRotX = 0, currentRotY = 0;
    // Base angle with 0 yaw (RotY = 0) so the lattice aligns perfectly horizontally.
    const baseRotX = -0.6, baseRotY = 0;

    latticeWrapper.addEventListener('mousemove', (e) => {
      const rect = latticeWrapper.getBoundingClientRect();
      const cx = rect.left + rect.width / 2;
      const cy = rect.top + rect.height / 2;
      
      // Multi-axis rotation kept within reasonable bounds
      targetRotY = ((e.clientX - cx) / window.innerWidth) * 0.35; 
      targetRotX = ((e.clientY - cy) / window.innerHeight) * -0.35;
    });

    latticeWrapper.addEventListener('mouseleave', () => {
      targetRotX = 0; targetRotY = 0;
    });

    const FL = 800;
    function renderLoop() {
      currentRotX += (targetRotX - currentRotX) * 0.08;
      currentRotY += (targetRotY - currentRotY) * 0.08;

      const rx = baseRotX + currentRotX;
      const ry = baseRotY + currentRotY;

      const cosX = Math.cos(rx), sinX = Math.sin(rx);
      const cosY = Math.cos(ry), sinY = Math.sin(ry);

      const projNodes = allNodes.map(n => {
        const x1 = n.x * cosY - n.z * sinY;
        const z1 = n.z * cosY + n.x * sinY;
        const y2 = n.y * cosX - z1 * sinX;
        
        // Orthographic projection (scale = 1.0) ensures all Z-lines remain 
        // perfectly parallel, creating a clean, aligned architectural diagram look.
        return { x: x1 + 400, y: y2 + 120, scale: 1.0 };
      });

      allEdges.forEach((e, i) => {
        const p1 = projNodes[e.from], p2 = projNodes[e.to];
        edgeEls[i].setAttribute("x1", p1.x); edgeEls[i].setAttribute("y1", p1.y);
        edgeEls[i].setAttribute("x2", p2.x); edgeEls[i].setAttribute("y2", p2.y);
      });

      allNodes.forEach((n, i) => {
        const p = projNodes[i];
        nodeEls[i].setAttribute("cx", p.x); nodeEls[i].setAttribute("cy", p.y);
        nodeEls[i].setAttribute("r", (n.layer === 0 ? 3.5 : n.layer === 1 ? 2.5 : 1.5) * p.scale);
      });

      particles.forEach((p, i) => {
        p.progress += p.speed;
        if (p.progress >= 1) p.progress = 0;

        const totalSegments = p.path.length - 1;
        const segmentFloat = p.progress * totalSegments;
        const segmentIndex = Math.floor(segmentFloat);
        const segmentProgress = segmentFloat - segmentIndex;

        const n1 = projNodes[p.path[segmentIndex]];
        const n2 = projNodes[p.path[Math.min(segmentIndex + 1, totalSegments)]];

        particleEls[i].setAttribute("cx", n1.x + (n2.x - n1.x) * segmentProgress);
        particleEls[i].setAttribute("cy", n1.y + (n2.y - n1.y) * segmentProgress);
        particleEls[i].setAttribute("r", 4 * ((n1.scale + n2.scale) / 2));
      });

      requestAnimationFrame(renderLoop);
    }
    renderLoop();
  }
</script>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1.35fr);
    gap: 72px;
    align-items: end;
    min-height: 650px;
  }

  .identity-figure {
    display: grid;
    gap: 22px;
    margin: 0;
    perspective: 1000px;
    transform-style: preserve-3d;
    transition: transform var(--motion-slow) ease;
  }

  .identity-orbit {
    position: relative;
    display: grid;
    place-items: center;
    width: min(520px, 100%);
    aspect-ratio: 1;
    border: 1px solid rgba(var(--rgb-warm), 0.2);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, rgba(var(--rgb-warm), 0.05), transparent 60%),
      radial-gradient(circle at 30% 70%, rgba(107, 156, 242, 0.03), transparent 50%),
      #030303;
    outline: 1px solid rgba(255, 255, 255, 0.04);
    outline-offset: 16px;
    box-shadow: 
      0 0 60px rgba(var(--rgb-warm), 0.1),
      inset 0 0 40px rgba(0, 0, 0, 0.5);
  }

  .profile-center {
    box-shadow: 0 0 50px rgba(var(--rgb-warm), 0.08), inset 0 0 20px rgba(0, 0, 0, 0.8);
    z-index: 2;
  }

  .orbit-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: orbitSpin 24s linear infinite;
    pointer-events: none;
  }

  @keyframes profileScanner {
    0% { top: 0%; opacity: 0; }
    15% { opacity: 0.85; }
    85% { opacity: 0.85; }
    100% { top: 100%; opacity: 0; }
  }

  @keyframes orbitSpin {
    100% { transform: rotate(360deg); }
  }

  .orbit-node {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid rgba(var(--rgb-warm), 0.7);
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 
      0 0 12px rgba(var(--rgb-warm), 0.3),
      0 0 24px rgba(var(--rgb-warm), 0.1);
    animation: pulseNode 4s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  @keyframes pulseNode {
    0% { transform: scale(1); box-shadow: 0 0 8px rgba(var(--rgb-warm), 0.2), 0 0 16px rgba(var(--rgb-warm), 0.1); }
    100% { transform: scale(1.2); box-shadow: 0 0 20px rgba(var(--rgb-warm), 0.6), 0 0 32px rgba(var(--rgb-warm), 0.2); }
  }

  .node-a { top: 20%; right: 22%; }
  .node-b { bottom: 23%; left: 18%; }
  .node-c { right: 17%; bottom: 18%; background: var(--color-ink); }

  .identity-figure figcaption {
    display: grid;
    gap: 8px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .about-statement {
    position: relative;
    display: grid;
    gap: 28px;
    perspective: 1400px;
  }

  .about-statement svg {
    width: min(800px, 100%);
    height: auto;
    color: var(--color-ink-soft);
    transform-style: preserve-3d;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    will-change: transform;
    filter: drop-shadow(0 15px 40px rgba(138, 180, 248, 0.15));
  }

  .about-statement polyline {
    animation: dashTicker 0.8s linear infinite;
  }

  @keyframes dashTicker {
    to { stroke-dashoffset: -10; }
  }

  .about-statement circle {
    fill: var(--color-paper);
    stroke: currentColor;
  }

  .about-statement blockquote {
    position: relative;
    margin: 0;
    max-width: 860px;
    font-family: "Noto Serif KR", "Noto Serif", serif;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.45;
    color: var(--color-ink);
    border-left: 0;
    padding-left: 48px;
    letter-spacing: -0.01em;
  }

  .about-statement blockquote::before {
    content: '“';
    position: absolute;
    top: -20px;
    left: -12px;
    font-family: var(--font-serif);
    font-size: 7rem;
    color: rgba(var(--rgb-warm), 0.25);
    line-height: 1;
    font-style: normal;
  }

  .about-statement blockquote::after {
    content: '”';
    position: absolute;
    bottom: -60px;
    right: 20px;
    font-family: var(--font-serif);
    font-size: 7rem;
    color: rgba(var(--rgb-warm), 0.1);
    line-height: 1;
    font-style: normal;
  }

  .about-thesis {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 88px;
    align-items: start;
  }

  .sticky-timeline {
    position: sticky;
    top: calc(var(--header-height) + 54px);
    padding-top: 4px;
  }

  @media (max-width: 1180px) {
    .sticky-timeline {
      position: static;
    }
  }

  .sticky-timeline ol {
    display: grid;
    gap: 0;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .sticky-timeline li {
    position: relative;
    padding: 0 0 28px 28px;
    color: var(--color-ink-muted);
    transition: color var(--motion-fast) ease;
  }

  .timeline-content {
    display: grid;
    gap: 5px;
    transition: transform var(--motion-fast) var(--easing-spring);
  }

  .sticky-timeline li:hover {
    color: var(--color-ink);
  }

  .sticky-timeline li:hover .timeline-content {
    transform: translateX(8px);
  }

  .sticky-timeline li::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 0;
    width: 10px;
    height: 10px;
    border: 1px solid rgba(var(--rgb-warm), 0.3);
    border-radius: 0;
    transform: rotate(45deg);
    background: var(--color-paper);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .sticky-timeline li:hover::before {
    border-color: rgba(var(--rgb-warm), 0.8);
    background: rgba(var(--rgb-warm), 0.15);
    box-shadow: 0 0 12px rgba(var(--rgb-warm), 0.4);
    transform: rotate(135deg) scale(1.2);
  }

  .sticky-timeline li::after {
    content: "";
    position: absolute;
    top: 22px;
    bottom: 2px;
    left: 5px;
    width: 2px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0.02));
  }

  .sticky-timeline li.is-current {
    color: var(--color-ink);
  }

  .timeline-logo {
    position: absolute;
    left: -44px;
    top: 6px;
    width: 32px;
    height: 32px;
    object-fit: contain;
    opacity: 0;
    transform: translateX(-16px);
    transition: opacity 0.4s ease, transform 0.4s var(--easing-spring), filter 0.4s ease;
    pointer-events: none;
    z-index: 10;
  }

  .sticky-timeline li:hover .timeline-logo {
    opacity: 1;
    transform: translateX(0);
    filter: drop-shadow(0 0 8px rgba(var(--rgb-warm), 0.4));
  }

  .sticky-timeline li.is-current::before {
    background: rgba(var(--rgb-warm), 0.8);
    border-color: rgba(var(--rgb-warm), 1);
    box-shadow: 0 0 10px rgba(var(--rgb-warm), 0.3);
  }

  .sticky-timeline span,
  .sticky-timeline strong,
  .sticky-timeline small {
    display: block;
  }

  .sticky-timeline span {
    font-size: 12px;
    font-weight: 800;
  }

  .sticky-timeline small {
    font-size: 12px;
    line-height: 1.45;
  }

  .thesis-copy {
    border-left: 1px solid rgba(255, 255, 255, 0.06);
    padding-left: 42px;
    position: relative;
    padding-top: 4px;
  }
  
  .thesis-copy::before {
    content: '';
    position: absolute;
    top: 0;
    left: -1px;
    width: 2px;
    height: 60px;
    background: linear-gradient(to bottom, rgba(var(--rgb-warm), 0.6), transparent);
  }

  .thesis-copy h1 {
    margin: 0;
    max-width: 960px;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 3.8vw, 3.8rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .lead-copy {
    margin: 36px 0 0;
    max-width: 820px;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.45;
    color: var(--color-ink-soft);
  }

  .essay-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 42px;
    color: var(--color-ink-soft);
    font-size: 17px;
    line-height: 1.75;
  }

  .essay-columns p {
    margin: 0;
    padding-top: 18px;
