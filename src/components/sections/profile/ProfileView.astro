---
const { page, navItem, hero } = Astro.props;

const visibleBlocks = (page.blocks ?? []).filter((block) => !block.hidden);
const experienceTimelineBlock =
  visibleBlocks.find((block) => block.type === "timeline" && block.id === "experience-timeline") ??
  visibleBlocks.find((block) => block.type === "timeline");
const leadBlock = visibleBlocks.find(
  (block) => block.type === "text" && block.variant === "lead"
);
const calloutBlock = visibleBlocks.find((block) => block.type === "callout");
const statBlock = visibleBlocks.find((block) => block.type === "stats");
const educationBlock = visibleBlocks.find((block) => block.type === "education" || block.id === "education-block") ?? {
  school: "Chungnam National University",
  degree: "B.S. in Physics",
  major: "Semiconductor-Energy Convergence Science",
  period: "Mar 2017 - Feb 2026",
  status: "Graduated"
};
const timelineEvents = experienceTimelineBlock
  ? experienceTimelineBlock.events
  : [];
const isCompanyFounderEvent = (event) =>
  event.title.includes("A1trategize") || event.title.includes("Minseok Song & Company");

const credentials = [
  {
    category: "AI & Generative Intelligence",
    issuer: "Google",
    icon: "google",
    badgeColor: "google",
    title: "Google AI Professional Certifications",
    grade: "Official Credential",
    description: "Verified foundational & enterprise generative AI mastery, prompt engineering architecture, and Gemini workflow orchestration.",
    items: [
      {
        name: "Google AI Essentials",
        label: "AI Foundation & Prompt Engineering",
        date: "2025.11",
        src: "/documents/credentials/google-ai-essentials.pdf",
        tag: "CERTIFIED"
      },
      {
        name: "Google Gemini Academy",
        label: "Enterprise GenAI Architecture",
        date: "2025.11",
        src: "/documents/credentials/google-gemini-academy.pdf",
        tag: "COMPLETED"
      }
    ]
  },
  {
    category: "Deep Learning & Neural Architectures",
    issuer: "NVIDIA DLI",
    icon: "nvidia",
    badgeColor: "nvidia",
    title: "NVIDIA Deep Learning Institute (DLI)",
    grade: "DLI Certified",
    description: "Hands-on GPU-accelerated neural network architecture training, CNN/RNN optimization, and transformer-based NLP engineering.",
    items: [
      {
        name: "Fundamentals of Deep Learning",
        label: "Neural Networks & Computer Vision",
        date: "2024.07",
        src: "/documents/credentials/nvidia-dli-fundamentals.pdf",
        tag: "DLI CERTIFIED"
      },
      {
        name: "Building Transformer-Based NLP Applications",
        label: "Transformer Models & Attention",
        date: "2024.07",
        src: "/documents/credentials/nvidia-dli-transformers-nlp.pdf",
        tag: "DLI CERTIFIED"
      }
    ]
  },
  {
    category: "Global Technical English",
    issuer: "ACTFL OPIc",
    icon: "lang-en",
    badgeColor: "opic",
    title: "OPIc English Competency",
    grade: "IH (Intermediate High)",
    description: "Demonstrated advanced fluency in technical discussions, cross-functional engineering debates, and structured presentation delivery.",
    items: [
      {
        name: "OPIc English Official Score Report",
        label: "Professional Engineering Communication",
        date: "2025.10",
        src: "/documents/credentials/opic-english.pdf",
        tag: "GRADE: IH"
      }
    ]
  },
  {
    category: "Global Japanese Communication",
    issuer: "ACTFL OPIc",
    icon: "lang-ja",
    badgeColor: "opic-ja",
    title: "OPIc Japanese Competency",
    grade: "IM2 (Intermediate Mid 2)",
    description: "Demonstrated conversational proficiency in Japanese and professional cross-border engineering collaboration.",
    items: [
      {
        name: "OPIc Japanese Official Score Report",
        label: "Cross-Border Technical Dialogue",
        date: "2026.04",
        src: "/documents/credentials/opic-japanese.pdf",
        tag: "GRADE: IM2"
      }
    ]
  }
];
---

<div class="page-kicker">
  <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
  <i></i>
  <strong>Self interview</strong>
</div>

<section id="profile-overview" class="about-hero">
  <figure class="identity-figure" aria-label="Minseok Song identity diagram">
    <div class="identity-orbit-wrap">
      <div class="identity-orbit">
        <div class="profile-center lenticular-lens">
          <!-- Layer 1: Strategist Portrait (단독 증명사진) -->
          <div class="profile-layer layer-portrait" style="background-image: url('/송민석_증명사진.jpg');"></div>
          <!-- Layer 2: Graduation Cohort (졸업 연구 단체사진) -->
