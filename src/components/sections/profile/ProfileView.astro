---
const { page, navItem, hero } = Astro.props;

const visibleBlocks = (page.blocks ?? []).filter((block) => !block.hidden);
const experienceTimelineBlock =
  visibleBlocks.find((block) => block.type === "timeline" && block.id === "experience-timeline") ??
  visibleBlocks.find((block) => block.type === "timeline");
const leadBlock = visibleBlocks.find(
  (block) => block.type === "text" && block.variant === "lead"
);
const calloutBlock = visibleBlocks.find((block) => block.type === "callout");
const statBlock = visibleBlocks.find((block) => block.type === "stats");
const timelineEvents = experienceTimelineBlock
  ? experienceTimelineBlock.events
  : [
      {
        date: "Now",
        title: "A1 Firms foundation",
        body: "Design, product, and operating systems are being composed into one public surface."
      }
    ];
---

<div class="page-kicker">
  <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
  <i></i>
  <strong>Self interview</strong>
</div>

<section id="profile-overview" class="about-hero">
  <figure class="identity-figure" aria-label="Minseok Song identity diagram">
    <div class="identity-orbit">
      <div class="profile-center">
        <div class="profile-bg"></div>
        <div class="profile-scanner-line"></div>
        <div class="profile-grid-layer"></div>
        <div class="profile-vignette"></div>
      </div>
      <div class="orbit-ring">
        <span class="orbit-node node-a"></span>
        <span class="orbit-node node-b"></span>
        <span class="orbit-node node-c"></span>
      </div>
    </div>
    <figcaption>
      <span>Fig. 00 / Self</span>
      <span>Strategy / AI / Operating Systems</span>
    </figcaption>
  </figure>

  <div class="about-statement card-view">
    <div class="statement-header">
      <p class="micro-label">Core Philosophy</p>
      <div class="ra1-thm-chip">
        <span class="chip-dot"></span>
        <span>RA1 <span class="chip-muted">THM</span></span>
      </div>
    </div>
    <div class="lattice-interaction-area">
      <svg viewBox="0 0 800 440" aria-hidden="true" class="true-3d-lattice" style="overflow: visible; margin-top: 10px;">
        <defs>
          <filter id="neural-glow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="3.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur"/>
              <feMergeNode in="SourceGraphic"/>
            </feMerge>
          </filter>
        </defs>

        <g filter="url(#neural-glow)">
          <g class="edges-group"></g>
          <g class="nodes-group"></g>
          <g class="particles-group"></g>
        </g>
      </svg>
    </div>
  </div>
</section>

<!-- Independent Intro Card directly below the hero section -->
<section class="about-intro-section">
  <div class="intro-card card-view">
    <p class="intro-text">
      {calloutBlock?.body ??
        "My strength is Proactive Execution—transforming complex technical challenges into valuable Deep Tech strategies. I want to be someone who values hands-on experience over just words."}
    </p>
  </div>
</section>

<section id="profile-thesis" class="about-thesis">
  <aside class="sticky-timeline">
    <span class="micro-label">Timeline / Sticky</span>
    <ol>
      {timelineEvents.map((event, index) => (
        <li class={`reveal-in stagger-${(index % 5) + 1} ${index === 0 ? "is-current" : ""}`}>
          {event.title.includes('A1trategize') && <><img src="/A1Firm-logo.webp" alt="A1trategize" class="timeline-logo logo-dark" /><img src="/A1Firm-logo_light.webp" alt="A1trategize" class="timeline-logo logo-light" /></>}
          {event.title.includes('NNFC') && <img src="/NNFC-logo.webp" alt="KAIST NNFC" class="timeline-logo" />}
          {event.title.includes('KRISS') && <img src="/KRISS-logo.webp" alt="KRISS" class="timeline-logo" />}
          {(event.title.includes('Chungnam National University') || event.title.includes('Semiconductor Sensor Lab')) && <img src="/CNU-logo.webp" alt="CNU" class="timeline-logo" />}
          
          <div class="timeline-content">
            <span>{event.date}</span>
            <strong>{event.title}</strong>
            {event.body && <small>{event.body}</small>}
          </div>
        </li>
      ))}
    </ol>
  </aside>

  <article class="thesis-copy">
    <p class="micro-label">01 / The Operating Question</p>
    <h1>{hero.title}</h1>
    <p class="lead-copy reveal-up">
      {leadBlock?.body ??
        "I build structured ways to turn ambiguous strategic questions into usable systems, product surfaces, and durable operating habits."}
    </p>
    <div class="essay-columns reveal-up stagger-1">
      {visibleBlocks
        .filter((block) => block.type === "text" && block.variant === "body")
        .map((block) => (
          <p>{block.body}</p>
        ))}
    </div>
    {statBlock && (
      <dl class="signal-strip reveal-up stagger-2">
        {statBlock.stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
            {stat.description && <p>{stat.description}</p>}
          </div>
        ))}
      </dl>
    )}
  </article>
</section>

<script is:inline>
  const identityFigure = document.querySelector('.identity-figure');
  if (identityFigure) {
    identityFigure.addEventListener('mousemove', (e) => {
      const rect = identityFigure.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -10;
      const rotateY = ((x - centerX) / centerX) * 10;
      
      identityFigure.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });
    
    identityFigure.addEventListener('mouseleave', () => {
      identityFigure.style.transform = 'rotateX(0) rotateY(0)';
      identityFigure.style.transition = 'transform var(--motion-slow) ease';
    });
    
  }

  const signalCards = document.querySelectorAll('.signal-strip div');
  signalCards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -5;
      const rotateY = ((x - centerX) / centerX) * 5;
      
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
      card.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
    });
    
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
      card.style.transition = 'all 0.5s cubic-bezier(0.16, 1, 0.3, 1)';
    });
    
    card.addEventListener('mouseenter', () => {
      card.style.transition = 'border-color 0.5s ease, box-shadow 0.5s ease'; // Remove transform from transition during hover
    });
  });

  // 3D True Perspective Engine for SVG
  const latticeWrapper = document.querySelector('.lattice-interaction-area');
  const svg3d = document.querySelector('.true-3d-lattice');
  
  if (latticeWrapper && svg3d) {
    const edgesGroup = svg3d.querySelector('.edges-group');
    const nodesGroup = svg3d.querySelector('.nodes-group');
    const particlesGroup = svg3d.querySelector('.particles-group');

    // Network Topology (Adjusted for perfect hexagons)
    const planeNodes = [
      {x: -280, y: 0},
      {x: -210, y: -40}, {x: -210, y: 40},
      {x: -140, y: 0},
      {x: -70, y: -40},  {x: -70, y: 40},
      {x: 0, y: 0},
      {x: 70, y: -40},   {x: 70, y: 40},
      {x: 140, y: 0},
      {x: 210, y: -40},  {x: 210, y: 40},
      {x: 280, y: 0}
    ];

    const planeEdges = [
      [0,1], [0,2], [1,3], [2,3],
      [3,4], [3,5], [4,6], [5,6],
      [6,7], [6,8], [7,9], [8,9],
      [9,10], [9,11], [10,12], [11,12],
      [1,5], [2,4], [4,8], [5,7], [7,11], [8,10]
    ];

    // Z-coordinates for L1 (Front), L2 (Middle), L3 (Back)
    const layersZ = [-150, 0, 150];
    const allNodes = [];
    const allEdges = [];

    // Construct 3D Nodes
    layersZ.forEach((z, lIdx) => {
      planeNodes.forEach(n => {
        allNodes.push({ x: n.x, y: n.y, z: z, layer: lIdx });
      });
    });

    const L_OFFSET = 13;
    layersZ.forEach((_, lIdx) => {
      // Intra-layer tight binding
      planeEdges.forEach(edge => {
        allEdges.push({ 
          from: edge[0] + lIdx * L_OFFSET, 
          to: edge[1] + lIdx * L_OFFSET,
          type: 'intra', layer: lIdx 
        });
      });
      // Inter-layer vertical hopping & synaptic connections for perceptron feel
      if (lIdx < 2) {
        // Fully Connected (Dense) layer connections
        for(let i=0; i<13; i++) {
          for(let j=0; j<13; j++) {
            if (i === j) {
              // 1. Direct vertical hopping
              allEdges.push({
                from: i + lIdx * L_OFFSET,
                to: j + (lIdx + 1) * L_OFFSET,
                type: 'inter'
              });
            } else {
              // 2. Dense perceptron connections (every node connects to every node in next layer)
              allEdges.push({
                from: i + lIdx * L_OFFSET,
                to: j + (lIdx + 1) * L_OFFSET,
                type: 'synapse'
              });
            }
          }
        }
      }
    });

    // SNN Hopping Particles State Machine
    const particles = [
      { path: [0, 1, 4, 6, 8, 11, 12], currentIndex: 0, state: 'CHARGING', charge: 0.1, chargeRate: 0.015, color: 'var(--color-accent)' },
      { path: [0, 14, 17, 32, 34, 37, 38], currentIndex: 0, state: 'CHARGING', charge: 0.4, chargeRate: 0.012, color: 'var(--color-accent-ink)' },
      { path: [26, 28, 18, 6, 7, 23, 25], currentIndex: 0, state: 'CHARGING', charge: 0.8, chargeRate: 0.018, color: 'var(--color-ink)' },
      { path: [5, 7, 9, 10, 12, 8, 6], currentIndex: 0, state: 'CHARGING', charge: 0.2, chargeRate: 0.014, color: 'var(--color-warm)' },
      { path: [2, 4, 6, 8, 10, 12, 11], currentIndex: 0, state: 'CHARGING', charge: 0.6, chargeRate: 0.02, color: 'var(--color-green)' }
    ];

    // DOM Generation
    const edgeEls = allEdges.map(e => {
      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
      if (e.type === 'inter') {
        line.setAttribute("stroke", "var(--color-warm)");
        line.setAttribute("stroke-opacity", "0.3");
        line.setAttribute("stroke-width", "1");
        line.setAttribute("stroke-dasharray", "2 4");
      } else if (e.type === 'synapse') {
        line.setAttribute("stroke", "var(--color-warm)");
        line.setAttribute("stroke-opacity", "0.15"); // Make it clearly visible
        line.setAttribute("stroke-width", "0.8"); // Slightly thicker to be seen easily
      } else {
        line.setAttribute("stroke", "var(--color-warm)");
        line.setAttribute("stroke-opacity", e.layer === 0 ? "0.5" : e.layer === 1 ? "0.2" : "0.1");
        line.setAttribute("stroke-width", "1.5");
      }
      edgesGroup.appendChild(line);
      return line;
    });

    const nodeEls = allNodes.map(n => {
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("class", "lattice-node");
      circle.setAttribute("stroke-width", "1.5");
      circle.setAttribute("opacity", n.layer === 0 ? "0.8" : n.layer === 1 ? "0.4" : "0.15");
      nodesGroup.appendChild(circle);
      return circle;
    });

    const particleEls = particles.map(p => {
      const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
      circle.setAttribute("class", "lattice-particle");
      circle.setAttribute("filter", "url(#neural-glow)");
      particlesGroup.appendChild(circle);
      return circle;
    });

    let targetRotX = 0, targetRotY = 0;
    let currentRotX = 0, currentRotY = 0;
    // Base angle with 0 yaw (RotY = 0) so the lattice aligns perfectly horizontally.
    const baseRotX = -0.6, baseRotY = 0;

    let isDragging = false;
    let lastMouseX = 0, lastMouseY = 0;
    let activePointerId = null;
    const maxRotX = 0.35, maxRotY = 0.5;

    latticeWrapper.style.cursor = 'grab';

    const startDrag = (e) => {
      isDragging = true;
      activePointerId = e.pointerId;
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      latticeWrapper.style.cursor = 'grabbing';
      latticeWrapper.setPointerCapture?.(e.pointerId);
      e.preventDefault();
    };

    const moveDrag = (e) => {
      if (!isDragging) return;
      if (activePointerId !== null && e.pointerId !== activePointerId) return;
      
      const deltaX = e.clientX - lastMouseX;
      const deltaY = e.clientY - lastMouseY;
      
      // Update target rotations continuously relative to previous targets
      targetRotY += deltaX * 0.005;
      targetRotX += deltaY * 0.005;
      
      // Clamp to limits to avoid flipping the diagram over
      targetRotY = Math.max(-maxRotY, Math.min(maxRotY, targetRotY));
      targetRotX = Math.max(-maxRotX, Math.min(maxRotX, targetRotX));
      
      lastMouseX = e.clientX;
      lastMouseY = e.clientY;
      e.preventDefault();
    };

    const endDrag = (e) => {
      if (activePointerId !== null && e.pointerId !== activePointerId) return;
      isDragging = false;
      activePointerId = null;
      latticeWrapper.style.cursor = 'grab';
      latticeWrapper.releasePointerCapture?.(e.pointerId);
    };

    latticeWrapper.addEventListener('pointerdown', startDrag);
    window.addEventListener('pointermove', moveDrag, { passive: false });
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    const FL = 800;
    function renderLoop() {
      currentRotX += (targetRotX - currentRotX) * 0.08;
      currentRotY += (targetRotY - currentRotY) * 0.08;

      const rx = baseRotX + currentRotX;
      const ry = baseRotY + currentRotY;

      const cosX = Math.cos(rx), sinX = Math.sin(rx);
      const cosY = Math.cos(ry), sinY = Math.sin(ry);

      const projNodes = allNodes.map(n => {
        const x1 = n.x * cosY - n.z * sinY;
        const z1 = n.z * cosY + n.x * sinY;
        const y2 = n.y * cosX - z1 * sinX;
        
        // Orthographic projection (scale = 1.0) ensures all Z-lines remain 
        // perfectly parallel, creating a clean, aligned architectural diagram look.
        return { x: x1 + 400, y: y2 + 220, scale: 1.0 };
      });

      allEdges.forEach((e, i) => {
        const p1 = projNodes[e.from], p2 = projNodes[e.to];
        edgeEls[i].setAttribute("x1", p1.x); edgeEls[i].setAttribute("y1", p1.y);
        edgeEls[i].setAttribute("x2", p2.x); edgeEls[i].setAttribute("y2", p2.y);
      });

      allNodes.forEach((n, i) => {
        const p = projNodes[i];
        nodeEls[i].setAttribute("cx", p.x); nodeEls[i].setAttribute("cy", p.y);
        nodeEls[i].setAttribute("r", (n.layer === 0 ? 3.5 : n.layer === 1 ? 2.5 : 1.5) * p.scale);
      });

      particles.forEach((p, i) => {
        const totalSegments = p.path.length - 1;
        const n1 = projNodes[p.path[p.currentIndex]];
        const n2 = projNodes[p.path[Math.min(p.currentIndex + 1, totalSegments)]];
        
        let cx = n1.x;
        let cy = n1.y;
        let r = 0;
        let opacity = 1;

        if (p.state === 'CHARGING') {
          p.charge += p.chargeRate;
          r = 2 + (p.charge * 3); // Swell up as potential increases
          opacity = 0.3 + (p.charge * 0.7);
          
          if (p.charge >= 1) {
            p.state = 'HOPPING';
            p.hopProgress = 0;
          }
        } else if (p.state === 'HOPPING') {
          p.hopProgress += 0.08; // Smooth and fast spike
          
          // Ease-in-out for a more polished transition along the straight edge
          const t = p.hopProgress < 0.5 
            ? 2 * p.hopProgress * p.hopProgress 
            : 1 - Math.pow(-2 * p.hopProgress + 2, 2) / 2;
          
          // Straight line interpolation (no arc)
          cx = n1.x + (n2.x - n1.x) * t;
          cy = n1.y + (n2.y - n1.y) * t;
          
          // Spiking visual (slight glow and size increase, no massive pump)
          r = 2.5 + Math.sin(t * Math.PI) * 2; 
          opacity = 1;
          
          if (p.hopProgress >= 1) {
            p.currentIndex++;
            if (p.currentIndex >= totalSegments) {
               p.currentIndex = 0; 
            }
            p.state = 'COOLING';
            p.coolTimer = 0;
          }
        } else if (p.state === 'COOLING') {
          p.coolTimer += 0.05;
          cx = n1.x; // Stay at the new node
          cy = n1.y;
          r = 1.5; 
          opacity = 0.15; 
          
          if (p.coolTimer >= 1) {
             p.state = 'CHARGING';
             p.charge = 0;
             // Add randomness to next charge rate to simulate asynchronous SNN firing
             p.chargeRate = 0.008 + Math.random() * 0.015;
          }
        }

        particleEls[i].setAttribute("cx", cx);
        particleEls[i].setAttribute("cy", cy);
        particleEls[i].setAttribute("r", r * ((n1.scale + n2.scale) / 2));
        particleEls[i].setAttribute("opacity", opacity);
      });

      requestAnimationFrame(renderLoop);
    }
    renderLoop();
  }
</script>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1.35fr);
    gap: 72px;
    align-items: flex-start;
    padding-top: 16px;
    min-height: 650px;
  }

  .identity-figure {
    display: grid;
    gap: 22px;
    margin: 0;
    perspective: 1000px;
    transform-style: preserve-3d;
    transition: transform var(--motion-slow) ease;
  }

  .identity-orbit {
    position: relative;
    display: grid;
    place-items: center;
    width: min(520px, 100%);
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgba(var(--rgb-warm), 0.2);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, rgba(var(--rgb-warm), 0.05), transparent 60%),
      radial-gradient(circle at 30% 70%, rgba(var(--rgb-warm), 0.03), transparent 50%),
      #030303;
    outline: 1px solid rgba(255, 255, 255, 0.04);
    outline-offset: 16px;
    box-shadow: 
      0 0 60px rgba(var(--rgb-warm), 0.1),
      inset 0 0 40px rgba(0, 0, 0, 0.5);
  }

  .profile-center {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(var(--rgb-warm), 0.3);
    border-radius: 50%;
    background-color: var(--color-panel, #dfdbd2);
    box-shadow: 0 0 50px rgba(var(--rgb-warm), 0.08), inset 0 0 40px rgba(0, 0, 0, 0.5);
  }

  .profile-bg,
  .profile-grid-layer,
  .profile-vignette {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
  }

  .profile-bg {
    background-image: url("/profile.jpg");
    background-position: center;
    background-size: cover;
    /* Editorial monochrome filter to blend the casual group photo into the warm theme */
    filter: grayscale(1) sepia(0.15) contrast(1.1) brightness(0.9);
    mix-blend-mode: luminosity;
    opacity: 0.85;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .profile-scanner-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(var(--rgb-warm), 0.8), transparent);
    filter: drop-shadow(0 0 4px rgba(var(--rgb-warm), 0.4));
    opacity: 0.15;
    pointer-events: none;
    animation: profileScanner 5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .profile-grid-layer {
    background-image: radial-gradient(rgba(var(--rgb-warm), 0.1) 1px, transparent 1px);
    background-size: 16px 16px;
    opacity: 0.5;
    pointer-events: none;
  }

  .profile-vignette {
    box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.7);
    pointer-events: none;
  }

  .orbit-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: orbitSpin 24s linear infinite;
    pointer-events: none;
  }

  @keyframes profileScanner {
    0% { top: 0%; opacity: 0; }
    15% { opacity: 0.85; }
    85% { opacity: 0.85; }
    100% { top: 100%; opacity: 0; }
  }

  @keyframes orbitSpin {
    100% { transform: rotate(360deg); }
  }

  .orbit-node {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid rgba(var(--rgb-warm), 0.7);
    border-radius: 50%;
    background: var(--color-paper);
    box-shadow: 
      0 0 12px rgba(var(--rgb-warm), 0.3),
      0 0 24px rgba(var(--rgb-warm), 0.1);
    animation: pulseNode 4s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
  }

  @keyframes pulseNode {
    0% { transform: scale(1); box-shadow: 0 0 8px rgba(var(--rgb-warm), 0.2), 0 0 16px rgba(var(--rgb-warm), 0.1); }
    100% { transform: scale(1.2); box-shadow: 0 0 20px rgba(var(--rgb-warm), 0.6), 0 0 32px rgba(var(--rgb-warm), 0.2); }
  }

  .node-a { top: 20%; right: 22%; }
  .node-b { bottom: 23%; left: 18%; }
  .node-c { right: 17%; bottom: 18%; background: var(--color-ink); }

  .identity-figure figcaption {
    display: grid;
    gap: 8px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .about-statement.card-view {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    perspective: 1400px;
    padding: 42px 48px;
    border-radius: 24px;
    margin-top: 0;
    background: var(--color-panel);
    border: 1px solid var(--glass-border);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }

  .statement-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(var(--rgb-warm), 0.15);
    padding-bottom: 16px;
    margin-bottom: 8px;
    position: relative;
    z-index: 10;
  }

  .statement-header .micro-label {
    margin: 0;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--color-ink-muted);
    text-transform: uppercase;
  }

  .ra1-thm-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgba(138, 180, 248, 0.12);
    border: 1px solid rgba(138, 180, 248, 0.05);
    font-family: var(--font-mono, monospace);
    font-size: 10px;
