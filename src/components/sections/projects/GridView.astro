<script is:inline>
  let pdfjsPromise = null;
  function loadPdfJs() {
    if (window.pdfjsLib) return Promise.resolve(window.pdfjsLib);
    if (pdfjsPromise) return pdfjsPromise;
    pdfjsPromise = new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
      script.onload = async () => {
        try {
          const workerRes = await fetch('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js');
          const workerBlob = await workerRes.blob();
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = URL.createObjectURL(workerBlob);
        } catch (e) {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        }
        resolve(window.pdfjsLib);
      };
      script.onerror = reject;
      document.head.appendChild(script);
    });
    return pdfjsPromise;
  }

  let currentPdfRenderToken = 0;
  async function renderPdfOnCanvas(src, container) {
    const renderToken = ++currentPdfRenderToken;
    container.innerHTML = '<div class="pdf-loading-spinner"><div class="spinner"></div><span>문서 로딩 중...</span></div>';
    
    try {
      const [pdfjs, fileRes] = await Promise.all([
        loadPdfJs(),
        fetch(src).then(r => r.arrayBuffer())
      ]);
      if (renderToken !== currentPdfRenderToken) return;

      const loadingTask = pdfjs.getDocument({ data: fileRes });
      const pdf = await loadingTask.promise;
      if (renderToken !== currentPdfRenderToken) return;
      
      container.innerHTML = '';
      for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
        if (renderToken !== currentPdfRenderToken) return;
        const page = await pdf.getPage(pageNum);
        const unscaledViewport = page.getViewport({ scale: 1.0 });
        
        const containerWidth = Math.min(window.innerWidth - 32, 860);
        const scale = Math.max(1.0, Math.min(2.5, (containerWidth / unscaledViewport.width) * (window.devicePixelRatio || 1.2)));
        const viewport = page.getViewport({ scale });
        
        const pageWrap = document.createElement('div');
        pageWrap.className = 'pdf-page-canvas-wrap';
        
        const canvas = document.createElement('canvas');
        canvas.className = 'pdf-page-canvas';
        const ctx = canvas.getContext('2d');
        canvas.height = viewport.height;
        canvas.width = viewport.width;
        canvas.style.width = '100%';
        canvas.style.height = 'auto';
        
        const pageBadge = document.createElement('span');
        pageBadge.className = 'pdf-page-number-badge';
        pageBadge.textContent = `${pageNum} / ${pdf.numPages}`;
        
        pageWrap.appendChild(canvas);
        pageWrap.appendChild(pageBadge);
        container.appendChild(pageWrap);
        
        await page.render({
          canvasContext: ctx,
          viewport: viewport
        }).promise;
      }
    } catch (err) {
      console.warn('PDF.js mobile render error:', err);
      if (renderToken === currentPdfRenderToken) {
        container.innerHTML = `
          <div class="pdf-render-fallback">
            <p>모바일 인라인 뷰어를 로드하는 중 오류가 발생했습니다.</p>
            <a href="${src}" target="_blank" rel="noopener noreferrer" class="pdf-fallback-btn">새 탭에서 열기</a>
          </div>
        `;
      }
    }
  }

  function fitAppPreviewFrames() {
    document.querySelectorAll('.app-preview-shell').forEach(shell => {
      const sourceWidth = Number(shell.dataset.sourceWidth || 1440);
      const shellWidth = Math.max(1, shell.clientWidth);
      const shellHeight = Math.max(1, shell.clientHeight);
      // Add a 3px scale calculation buffer to ensure subpixel overlap on the edges
      const scale = Math.min(1, (shellWidth + 3) / sourceWidth);
      shell.style.setProperty('--app-preview-scale', String(scale));
      shell.style.setProperty('--app-preview-width', `${sourceWidth}px`);
      shell.style.setProperty('--app-preview-height', `${Math.ceil(shellHeight / scale) + 2}px`);
    });
  }

  function initProjectCards() {
    const projectCards = document.querySelectorAll('.project-card');
    projectCards.forEach(card => {
      // Remove old listeners to prevent duplicates if astro:page-load fires multiple times
      const interactiveCard = card.cloneNode(true);
      if (card.parentNode) {
        card.parentNode.replaceChild(interactiveCard, card);
      }

      if (interactiveCard.classList.contains('has-app-preview')) {
        return;
      }
      
      interactiveCard.addEventListener('mousemove', (e) => {
        const rect = interactiveCard.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        interactiveCard.style.setProperty('--mouse-x', `${x}px`);
        interactiveCard.style.setProperty('--mouse-y', `${y}px`);
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        const rotateX = ((y - centerY) / centerY) * -3;
        const rotateY = ((x - centerX) / centerX) * 3;
        
        interactiveCard.style.transform = `perspective(1000px) scale3d(1.02, 1.02, 1.02) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      });

      interactiveCard.addEventListener('mouseenter', () => {
        interactiveCard.style.transition = 'transform 0.1s ease-out, box-shadow 0.3s ease, border-color 0.3s ease';
      });

      interactiveCard.addEventListener('mouseleave', () => {
        interactiveCard.style.transition = 'transform 0.6s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.6s ease, border-color 0.6s ease, background 0.6s ease';
        interactiveCard.style.transform = `perspective(1000px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg)`;
      });
    });

    fitAppPreviewFrames();
    initIframeThemeSync();
    initPdfModal();
  }

  function initPdfModal() {
    const modal = document.getElementById('pdf-modal');
    const backdrop = document.getElementById('pdf-modal-backdrop');
    const closeBtn = document.getElementById('pdf-modal-close');
    const iframe = document.getElementById('pdf-modal-iframe');
    const canvasViewer = document.getElementById('pdf-modal-canvas-viewer');
    const video = document.getElementById('pdf-modal-video');
    const titleEl = document.getElementById('pdf-modal-title');
    const downloadLink = document.getElementById('pdf-modal-download');
    
    if (!modal) return;

    function openPdf(src, title) {
      const isVideo = src.toLowerCase().endsWith('.mp4') || src.toLowerCase().endsWith('.webm');
      const isMobile = window.innerWidth <= 768;

      if (titleEl) titleEl.textContent = title || (isVideo ? "Video Demonstration" : "Document Viewer");
      if (downloadLink) {
        downloadLink.href = src;
        const linkSpan = downloadLink.querySelector('span');
        if (linkSpan) linkSpan.textContent = isVideo ? "Watch Original" : "Open in New Tab";
      }

      if (isVideo && video) {
        if (canvasViewer) { canvasViewer.style.display = 'none'; canvasViewer.innerHTML = ''; }
        if (iframe) { iframe.style.display = 'none'; iframe.src = ''; }
        video.style.display = 'block';
        video.src = src;
        video.load();
        video.currentTime = 0;
        video.play().catch((err) => {
          console.warn("Video playback:", err);
        });
      } else if (isMobile && canvasViewer) {
        if (video) { video.pause(); video.style.display = 'none'; video.src = ''; }
        if (iframe) { iframe.style.display = 'none'; iframe.src = ''; }
        canvasViewer.style.display = 'flex';
        renderPdfOnCanvas(src, canvasViewer);
      } else if (iframe) {
        if (video) { video.pause(); video.style.display = 'none'; video.src = ''; }
        if (canvasViewer) { canvasViewer.style.display = 'none'; canvasViewer.innerHTML = ''; }
        iframe.style.display = 'block';
        iframe.src = src;
      }

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closePdf() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      if (video) {
        video.pause();
        video.src = '';
      }
      if (iframe) {
        iframe.src = '';
      }
      if (canvasViewer) {
        currentPdfRenderToken++;
        canvasViewer.innerHTML = '';
        canvasViewer.style.display = 'none';
      }
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.card-pdf-link').forEach(btn => {
      btn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        const src = btn.dataset.pdfSrc;
        const title = btn.dataset.pdfTitle;
        if (src) openPdf(src, title);
      };
    });

    if (backdrop) backdrop.onclick = closePdf;
    if (closeBtn) closeBtn.onclick = closePdf;
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('is-open')) closePdf();
    });
  }

  let syncRetries = 0;
  function syncIframeTheme() {
    const iframe = document.querySelector('.app-preview-shell iframe');
    if (!iframe) return;
    try {
      if (iframe.contentWindow) {
        if (typeof iframe.contentWindow.switchThemeUI === 'function') {
          syncRetries = 0;
          const parentTheme =
            (typeof window.__getResolvedSiteTheme === 'function' && window.__getResolvedSiteTheme()) ||
            document.documentElement.dataset.resolvedTheme ||
            document.documentElement.getAttribute('data-theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const targetTheme = parentTheme === 'light' ? 'nnfc' : 'mckinsey';
          iframe.contentWindow.switchThemeUI(targetTheme);
        } else if (syncRetries < 10) {
          syncRetries++;
          setTimeout(syncIframeTheme, 50);
        }
      }
    } catch (e) {
      console.warn("Iframe 테마 동기화 실패:", e);
    }
  }

  function initIframeThemeSync() {
    const iframe = document.querySelector('.app-preview-shell iframe');
    if (!iframe) return;

    iframe.addEventListener('load', () => {
      syncRetries = 0;
      syncIframeTheme();
    });
    syncIframeTheme();

    if (window.__iframeThemeObserver) {
      window.__iframeThemeObserver.disconnect();
    }
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'data-theme' || mutation.attributeName === 'data-resolved-theme') {
          syncIframeTheme();
        }
      });
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme', 'data-resolved-theme'] });
    window.__iframeThemeObserver = observer;

    if (!window.__projectPreviewThemeEventBound) {
      window.addEventListener('site-theme-change', syncIframeTheme);
      window.__projectPreviewThemeEventBound = true;
    }
  }

  initProjectCards();
  if (!window.__projectPreviewResizeBound) {
    window.addEventListener('resize', fitAppPreviewFrames);
    window.__projectPreviewResizeBound = true;
  }
  document.addEventListener('astro:page-load', initProjectCards);
</script>

