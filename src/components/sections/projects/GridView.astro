    height: 14px;
  }

  .pdf-modal-action-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
    background: var(--color-panel);
  }

  .pdf-close-btn {
    padding: 0 8px;
  }

  .pdf-modal-body {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    width: 100%;
    height: calc(100% - 50px);
    background: #525659;
    overflow: hidden;
  }

  .pdf-modal-body iframe,
  .pdf-modal-body video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #525659;
  }

  .pdf-canvas-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    padding: 14px 10px 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    background: #1e2024;
  }

  .pdf-page-canvas-wrap {
    position: relative;
    width: 100%;
    max-width: 860px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
    border-radius: 6px;
    overflow: hidden;
    background: #ffffff;
  }

  .pdf-page-canvas {
    display: block;
    width: 100%;
    height: auto;
  }

  .pdf-page-number-badge {
    position: absolute;
    bottom: 8px;
    right: 8px;
    background: rgba(0, 0, 0, 0.7);
    color: #ffffff;
    font-size: 10px;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 999px;
    backdrop-filter: blur(4px);
  }

  .pdf-loading-spinner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    height: 280px;
    color: var(--color-ink-muted, #9aa0a6);
    font-size: 13px;
    font-weight: 600;
  }

  .pdf-loading-spinner .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba(255, 255, 255, 0.15);
    border-top-color: var(--color-accent, #3b82f6);
    border-radius: 50%;
    animation: pdfSpin 0.8s linear infinite;
  }

  @keyframes pdfSpin {
    to { transform: rotate(360deg); }
  }

  .pdf-render-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 60px 20px;
    color: #d1d5db;
    text-align: center;
  }

  .pdf-fallback-btn {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    background: var(--color-accent, #3b82f6);
    color: #ffffff;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }

  .project-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.38fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: end;
  }

  .project-hero-copy {
    display: grid;
    gap: 20px;
    max-width: 1040px;
  }

  .project-hero h1 {
    margin: 0;
    font-family: "Outfit", var(--font-serif);
    font-size: 6rem;
    font-weight: 850;
    line-height: 0.92;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .project-hero p:not(.micro-label) {
    max-width: 720px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 18px;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .project-signal-panel {
    display: grid;
    border-top: 1px solid var(--color-line-strong);
  }

  .project-signal-panel div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 24px;
    align-items: baseline;
    min-height: 74px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .project-signal-panel span,
  .card-meta span {
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 850;
    text-transform: uppercase;
  }

  .project-signal-panel strong {
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 850;
    color: var(--color-ink);
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag-row span {
    min-height: 28px;
    padding: 7px 10px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-muted);
    background: rgba(255, 255, 255, 0.03);
    font-size: 11px;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .project-grid-section {
    display: grid;
    gap: 24px;
  }

  .research-grid-section {
    margin-top: 64px;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    width: fit-content;
    padding: 0 18px;
    border: 1px solid var(--color-ink);
    border-radius: 8px;
    color: var(--color-paper-deep);
    background: var(--color-ink);
    font-size: 13px;
    font-weight: 850;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      border-color var(--motion-fast) ease,
      background var(--motion-fast) ease,
      transform var(--motion-fast) ease;
  }

  .card-link:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    transform: translateY(-1px);
  }

  @keyframes scanline {
    0% { background-position: 0% 0%; }
    100% { background-position: 100% 100%; }
  }

  .card-link.is-pending {
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgba(255, 255, 255, 0.03) 10px,
      rgba(255, 255, 255, 0.03) 20px
    );
    background-size: 200% 200%;
    animation: scanline 20s linear infinite;
    border-color: var(--color-line);
    color: var(--color-ink-muted);
    cursor: default;
    pointer-events: none;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.2);
  }

  .project-grid-head {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--color-line-strong);
  }

  .project-grid-head h2 {
    max-width: 660px;
    margin: 0;
    color: var(--color-ink);
    font-family: "Outfit", var(--font-serif);
    font-size: 1.35rem;
    font-weight: 760;
    line-height: 1.28;
    text-align: right;
    text-wrap: balance;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 26px;
  }

  .bento-hero {
    grid-column: span 2;
    grid-row: span 2;
  }

  .bento-hero .card-visual {
    height: 280px;
  }

  .bento-hero h3 {
    font-size: 3.05rem;
    max-width: 760px;
  }

  .hero-top-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 32px;
    align-items: center;
  }

  @media (max-width: 960px) {
    .hero-top-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .hero-text-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }

  .card-mini-video-preview {
    position: relative;
    width: clamp(280px, 28vw, 420px);
    aspect-ratio: 16 / 9;
    border-radius: calc(var(--radius-card) - 2px);
    border: 1px solid var(--glass-border);
    background: #030407;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.08);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.35s ease;
    flex-shrink: 0;
  }

  .card-mini-video-preview:hover {
    transform: translateY(-3px) scale(1.02);
    border-color: var(--color-accent);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.6), 0 0 24px var(--color-accent-glow);
  }

  .mini-preview-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    background: #000;
  }

  .mini-video-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding: 10px 14px;
    background: linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.8) 100%);
    pointer-events: none;
    transition: background 0.3s ease;
  }

  .card-mini-video-preview:hover .mini-video-overlay {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.88) 100%);
  }

  .mini-video-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 6px;
    background: rgba(10, 14, 23, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    color: var(--color-ink);
    font-size: 11px;
    font-weight: 750;
    font-family: var(--font-mono);
  }

  .mini-play-icon {
    width: 10px;
    height: 10px;
    fill: var(--color-accent);
  }

  .mini-expand-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: rgba(10, 14, 23, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    color: var(--color-ink);
    transition: all 0.2s ease;
  }

  .mini-expand-badge svg {
    width: 14px;
    height: 14px;
  }

  .card-mini-video-preview:hover .mini-expand-badge {
    background: var(--color-accent);
    color: var(--color-paper-deep);
    border-color: var(--color-accent);
    transform: scale(1.12);
  }

  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-height: 480px;
    padding: 30px;
    border: 1px solid var(--glass-border);
    border-radius: calc(var(--radius-card) + 8px);
    background: linear-gradient(145deg, rgba(255,255,255,0.02) 0%, transparent 100%), var(--glass-bg);
    backdrop-filter: var(--glass-blur);
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    overflow: hidden;
    will-change: transform;
    transition:
      border-color 0.6s ease,
      background 0.6s ease,
      transform 0.6s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.6s ease;
  }

  .project-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    pointer-events: none;
    opacity: 0.55;
  }

  .project-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(800px circle at var(--mouse-x, 20%) var(--mouse-y, 0%), rgba(107, 156, 242, 0.12), transparent 44%);
    opacity: 0;
    transition: opacity var(--motion-base) ease;
    pointer-events: none;
  }

  .project-card[data-tone="warm"]::before,
  .project-card[data-tone="paper"]::before {
    background: radial-gradient(800px circle at var(--mouse-x, 20%) var(--mouse-y, 0%), rgba(var(--rgb-warm), 0.12), transparent 44%);
  }

  .project-card[data-tone="green"]::before {
    background: radial-gradient(800px circle at var(--mouse-x, 20%) var(--mouse-y, 0%), rgba(108, 163, 125, 0.13), transparent 44%);
  }

  .project-card:hover {
    border-color: var(--color-line-strong);
    background: var(--color-panel-solid);
    box-shadow: 0 18px 48px var(--glass-shadow), 0 0 0 1px var(--color-green-soft);
    transform: translateY(-4px);
  }

  .project-card:target {
    border-color: var(--color-accent);
    box-shadow: 0 18px 48px var(--glass-shadow), 0 0 0 2px var(--color-accent-soft);
    scroll-margin-top: 110px;
  }

  .project-card.has-app-preview:hover {
    transform: none;
  }

  .project-card:hover::before {
    opacity: 1;
  }

  .project-card.is-locked-project {
    border-color: color-mix(in srgb, var(--color-accent) 38%, var(--color-line));
    border-style: dashed;
    background:
      linear-gradient(145deg, color-mix(in srgb, var(--color-panel-solid) 76%, transparent), transparent 120%),
      repeating-conic-gradient(
        from 45deg,
        color-mix(in srgb, var(--color-ink) 7%, transparent) 0 25%,
        transparent 0 50%
      ) 0 0 / 16px 16px,
      var(--glass-bg);
  }

  .project-card.is-locked-project:hover {
    transform: translateY(-2px);
  }

  .project-card.is-locked-project .card-visual {
    background:
      repeating-conic-gradient(
        from 45deg,
        color-mix(in srgb, var(--color-ink) 14%, transparent) 0 25%,
        color-mix(in srgb, var(--color-accent) 18%, transparent) 0 50%
      ) 0 0 / 18px 18px,
      linear-gradient(135deg, var(--color-field), color-mix(in srgb, var(--color-panel-solid) 72%, transparent));
  }

  .project-card.is-locked-project .radar-chart {
    filter: blur(6px);
    opacity: 0.28;
    transform: scale(1.06);
  }

  .pending-lock-visual {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    gap: 10px;
    align-content: center;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--color-panel-solid) 22%, transparent), color-mix(in srgb, var(--color-field) 72%, transparent)),
      repeating-linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-ink) 10%, transparent) 0 8px,
        transparent 8px 16px
      );
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .pending-lock-icon {
    width: 58px;
    height: 58px;
    fill: color-mix(in srgb, var(--color-panel-solid) 72%, transparent);
    stroke: var(--color-ink);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 12px 24px var(--glass-shadow));
  }

  .pending-meta-badge {
    border-color: color-mix(in srgb, var(--color-accent) 56%, var(--color-line)) !important;
    color: var(--color-accent-ink) !important;
    background: var(--color-accent-soft) !important;
  }

  .pending-mosaic-copy {
    display: grid;
    gap: 9px;
    padding: 3px 0;
  }

  .pending-mosaic-copy span {
    display: block;
    height: 14px;
    border: 1px solid var(--color-line);
    border-radius: 3px;
    background:
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-ink-soft) 34%, transparent) 0 10px,
        color-mix(in srgb, var(--color-accent) 18%, transparent) 10px 20px,
        transparent 20px 30px
      );
    opacity: 0.62;
  }

  .pending-mosaic-copy span:nth-child(2) {
    width: 86%;
  }

  .pending-mosaic-copy span:nth-child(3) {
    width: 62%;
  }

  .pending-tag-row span {
    border-color: color-mix(in srgb, var(--color-accent) 36%, var(--color-line)) !important;
    color: var(--color-accent-ink) !important;
    background: color-mix(in srgb, var(--color-accent-soft) 70%, transparent) !important;
  }

  .pending-lock-link {
    gap: 8px;
  }

  .pending-lock-mini {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @keyframes meshFlow {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .card-visual {
    position: relative;
    display: block;
    height: 160px;
    margin: -8px -8px 8px;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: calc(var(--radius-card) - 2px);
    overflow: hidden;
    background: radial-gradient(circle at top left, rgba(var(--rgb-warm), 0.14), transparent 70%),
                radial-gradient(circle at bottom right, rgba(var(--rgb-warm), 0.06), transparent 70%),
                var(--color-field);
    background-size: 200% 200%;
    animation: meshFlow 15s ease-in-out infinite;
    box-shadow: inset 0 0 16px rgba(0, 0, 0, 0.03);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.35s ease;
  }

  [data-theme="dark"] .card-visual {
    border-color: rgba(255, 255, 255, 0.06);
    background: radial-gradient(circle at top left, rgba(107, 156, 242, 0.16), transparent 70%),
                radial-gradient(circle at bottom right, rgba(179, 154, 251, 0.08), transparent 70%),
                var(--color-field);
    box-shadow: inset 0 0 24px rgba(0, 0, 0, 0.35);
  }

  .card-visual-interactive {
    cursor: pointer;
  }

  .card-visual-interactive:hover {
    transform: translateY(-2px) scale(1.015);
    border-color: var(--color-accent);
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.05), 0 10px 24px rgba(0, 0, 0, 0.08), 0 0 16px var(--color-accent-glow);
  }

  [data-theme="dark"] .card-visual-interactive:hover {
    box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.15), 0 12px 28px rgba(0, 0, 0, 0.35), 0 0 20px var(--color-accent-glow);
  }

  .card-artifacts-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--color-line);
    width: 100%;
  }

  .card-artifacts-row > .artifact-minimal-btn:only-child {
    grid-column: span 2;
  }

  .card-artifacts-row > .artifact-minimal-btn:nth-child(3):last-child {
    grid-column: span 2;
  }

  .artifact-minimal-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 28px;
    width: 100%;
    padding: 0 8px;
    border-radius: 6px;
    border: 1px solid var(--color-line);
    background: rgba(255, 255, 255, 0.02);
    color: var(--color-ink-muted);
    font-size: 10px;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    line-height: 1;
    transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .artifact-minimal-btn:hover {
    transform: translateY(-1.5px);
  }

  .artifact-minimal-btn .art-icon {
    width: 11px;
    height: 11px;
    stroke: currentColor;
    flex-shrink: 0;
    opacity: 0.9;
  }

  .artifact-minimal-btn .art-arrow {
    width: 8px;
    height: 8px;
    stroke: currentColor;
    flex-shrink: 0;
    opacity: 0.6;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .artifact-minimal-btn:hover .art-arrow {
    opacity: 1;
    transform: translate(1px, -1px);
  }

  /* 1. AWARD Minimal Styling (Warm Amber / Gold) */
  .artifact-minimal-btn.is-award {
    background: rgba(245, 158, 11, 0.08);
    border-color: rgba(245, 158, 11, 0.3);
    color: #d97706;
  }
  .artifact-minimal-btn.is-award .award-trophy {
    stroke: #f59e0b;
  }
  .artifact-minimal-btn.is-award:hover {
    background: #f59e0b;
    border-color: #f59e0b;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
  }
  .artifact-minimal-btn.is-award:hover .award-trophy {
    stroke: #ffffff;
  }
  [data-theme="dark"] .artifact-minimal-btn.is-award {
    background: rgba(251, 191, 36, 0.08);
    border-color: rgba(251, 191, 36, 0.35);
    color: #fbbf24;
  }
  [data-theme="dark"] .artifact-minimal-btn.is-award .award-trophy {
    stroke: #fbbf24;
  }
  [data-theme="dark"] .artifact-minimal-btn.is-award:hover {
    background: #fbbf24;
    border-color: #fbbf24;
    color: #0b0f17;
    box-shadow: 0 4px 14px rgba(251, 191, 36, 0.4);
  }
  [data-theme="dark"] .artifact-minimal-btn.is-award:hover .award-trophy {
    stroke: #0b0f17;
  }

  /* 2. CERTIFICATE Minimal Styling (Mint / Emerald) */
  .artifact-minimal-btn.is-cert {
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.3);
    color: #059669;
  }
  .artifact-minimal-btn.is-cert .cert-seal {
    stroke: #10b981;
  }
  .artifact-minimal-btn.is-cert:hover {
    background: #10b981;
    border-color: #10b981;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.35);
  }
  .artifact-minimal-btn.is-cert:hover .cert-seal {
    stroke: #ffffff;
  }
  [data-theme="dark"] .artifact-minimal-btn.is-cert {
    background: rgba(52, 211, 153, 0.08);
    border-color: rgba(52, 211, 153, 0.35);
    color: #34d399;
  }
  [data-theme="dark"] .artifact-minimal-btn.is-cert .cert-seal {
    stroke: #34d399;
  }
  [data-theme="dark"] .artifact-minimal-btn.is-cert:hover {
    background: #10b981;
    border-color: #10b981;
    color: #0b0f17;
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4);
  }
  [data-theme="dark"] .artifact-minimal-btn.is-cert:hover .cert-seal {
