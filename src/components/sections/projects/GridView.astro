---
const { navItem, hero, projects = [] } = Astro.props;

const projectNotes = projects
  .filter((entry) => !entry.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);

const projectVisualLabels = {
  console: "System",
  graph: "Map",
  paper: "Note",
  deck: "Deck",
  blank: "Draft"
};
---

<div class="page-kicker">
  <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
  <i></i>
  <strong>Portfolio journal</strong>
</div>

<section class="index-hero portfolio-hero">
  <h1>{hero.title}</h1>
  <p>
    {hero.subtitle ??
      "Selected projects, build logs, decks, and research notes collected as a portfolio blog."}
  </p>
</section>

<section class="portfolio-console">
  <div class="portfolio-toolbar">
    <span>{String(projectNotes.length).padStart(2, "0")} entries</span>
    <strong>Project / writing / artifact</strong>
  </div>

  <div class="portfolio-grid">
    {projectNotes.length > 0 ? (
      projectNotes.map((project, index) => (
        <article class={`portfolio-card visual-${project.data.visual}`}>
          <a href={project.data.links[0]?.href ?? "#"}>
            <figure class="portfolio-cover">
              {project.data.cover?.src ? (
                <img
                  src={project.data.cover.src}
                  alt={project.data.cover.alt ?? project.data.title}
                  loading="lazy"
                />
              ) : (
                <div class="cover-visual" aria-hidden="true">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{projectVisualLabels[project.data.visual]}</strong>
                </div>
              )}
            </figure>
            <small>{project.data.year ?? "Draft"} · {project.data.status}</small>
            <h2>{project.data.title}</h2>
            <p>{project.data.summary}</p>
            <div class="tag-column">
              {project.data.tags.map((tag) => <span>{tag}</span>)}
            </div>
          </a>
        </article>
      ))
    ) : (
      <article class="empty-ledger">
        <span class="micro-label">No project notes yet</span>
        <h2>Project notes are pending.</h2>
        <p>
          Add project essays to <code>src/content/projects</code> when the
          writing layer is connected.
        </p>
      </article>
    )}
  </div>
</section>

<script is:inline>
  // 3D Tilt for Portfolio Cards
  const cards = document.querySelectorAll('.portfolio-card a');
  cards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -4;
      const rotateY = ((x - centerX) / centerX) * 4;
      
      card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });
    
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'rotateX(0) rotateY(0)';
      card.style.transition = 'transform 0.4s ease';
    });
    
    card.addEventListener('mouseenter', () => {
      card.style.transition = 'none';
    });
  });
</script>

<style>
  .index-hero {
    display: grid;
    gap: 28px;
  }

  .portfolio-hero {
    max-width: 900px;
  }

  .index-hero h1 {
    margin: 0;
    max-width: 960px;
    font-family: var(--font-serif);
    font-size: clamp(2.45rem, 3.65vw, 3.55rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .index-hero p {
    margin: 0;
    max-width: 640px;
    color: var(--color-ink-soft);
    font-size: 18px;
    line-height: 1.65;
  }

  .portfolio-console {
    display: grid;
    gap: 28px;
  }

  .portfolio-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--color-line-strong);
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .portfolio-toolbar strong {
    color: var(--color-ink-soft);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 54px) clamp(18px, 2vw, 26px);
  }

  .portfolio-card {
    min-width: 0;
    perspective: 1200px;
  }

  .portfolio-card a {
    display: grid;
    gap: 14px;
    color: inherit;
    text-decoration: none;
    transform-style: preserve-3d;
    transition: transform var(--motion-slow) ease;
  }

  .portfolio-cover {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-card);
    background: var(--color-panel);
    transition: box-shadow var(--motion-slow) ease, border-color var(--motion-slow) ease;
    transform: translateZ(20px);
  }

  .portfolio-card:hover .portfolio-cover {
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(255, 255, 255, 0.02);
  }

  .portfolio-cover img,
  .cover-visual {
    width: 100%;
    height: 100%;
  }

  .portfolio-cover img {
    display: block;
    object-fit: cover;
  }

  .cover-visual {
    position: relative;
    display: grid;
    align-content: space-between;
    padding: 18px;
    background:
      linear-gradient(135deg, rgba(248, 247, 242, 0.06), transparent 46%),
      linear-gradient(90deg, rgba(248, 247, 242, 0.03) 1px, transparent 1px),
      linear-gradient(180deg, rgba(248, 247, 242, 0.03) 1px, transparent 1px),
      var(--color-panel);
    background-size: auto, 54px 100%, 100% 54px, auto;
    transition: background-position var(--motion-slow) linear;
  }

  .portfolio-card:hover .cover-visual {
    background-position: 0 0, -10px -10px, -10px -10px, 0 0;
  }

  .cover-visual::after {
    content: "";
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 34%;
    height: 40%;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    opacity: 0.2;
    transform: skewY(-8deg);
  }

  .visual-console .cover-visual { background-color: #0d1117; }
  .visual-graph .cover-visual { background-color: #11170f; }
  .visual-paper .cover-visual {
    color: #161616;
    background:
      linear-gradient(135deg, rgba(126, 167, 216, 0.26), transparent 42%),
      #e8e4d9;
  }
  .visual-deck .cover-visual { background-color: #152238; }

  .cover-visual span {
    color: currentColor;
    font-size: 11px;
    font-weight: 800;
    opacity: 0.55;
  }

  .cover-visual strong {
    align-self: end;
    max-width: 78%;
    font-family: var(--font-serif);
    font-size: clamp(3.15rem, 5.2vw, 4.35rem);
    font-weight: 600;
    line-height: 0.95;
    opacity: 0.98;
  }

  .portfolio-card small {
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .portfolio-card h2 {
    display: -webkit-box;
    min-height: 3em;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 1.78vw, 1.9rem);
    font-weight: 600;
    line-height: 1.12;
  }

  .portfolio-card p {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    color: var(--color-ink-soft);
    font-size: 14px;
    line-height: 1.62;
  }

  .tag-column {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tag-column span {
    border: 1px solid var(--color-line);
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .empty-ledger {
    padding: 32px 0;
  }

  .empty-ledger h2 {
    margin: 8px 0 10px;
    font-size: 2.2rem;
  }

  .empty-ledger p {
    margin: 0;
    color: var(--color-ink-soft);
    line-height: 1.65;
  }

  @media (max-width: 1180px) {
    .index-hero h1 {
      font-size: clamp(2.25rem, 6vw, 3rem);
    }
    .portfolio-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .index-hero h1 {
      font-size: clamp(1.95rem, 8vw, 2.45rem);
    }
    .portfolio-toolbar {
      display: grid;
    }
    .portfolio-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
