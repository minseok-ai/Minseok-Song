---
const { page, navItem, hero, projects = [] } = Astro.props;

const visibleProjects = projects
  .filter((entry) => !entry.data.hidden && entry.data.status === "published")
  .sort((a, b) => a.data.order - b.data.order);

const productProjects = visibleProjects.filter((p) => p.data.order <= 9);
const researchProjects = visibleProjects.filter((p) => p.data.order >= 10);


const visualMeta = {
  graph: {
    label: "System graph",
    tone: "green"
  },
  deck: {
    label: "Deck surface",
    tone: "warm"
  },
  console: {
    label: "Console flow",
    tone: "blue"
  },
  paper: {
    label: "Research memo",
    tone: "paper"
  },
  blank: {
    label: "Open artifact",
    tone: "neutral"
  }
};

const externalHref = (href = "") => /^https?:\/\//.test(href);
const configuredA1PreviewHref = import.meta.env.A1TRATEGIZE_PREVIEW_URL ?? "";
const a1PreviewHref = configuredA1PreviewHref || "/a1trategize-preview/index.html";
const projectCode = (order) => `PX-${String(order ?? 0).padStart(2, "0")}`;
const isA1trategizeProject = (entry) =>
  entry.id === "a1trategize" || entry.data.title.toLowerCase().includes("a1trategize");
const isPendingLockedProject = (entry) => false;

const degToRad = (deg) => (deg * Math.PI) / 180;
const createCapabilityRadarChart = (scores) => {
  const normalizedScores = scores || [20, 20, 20, 20, 20];
  const radiusScale = 32;
  
  const aiPoint = { x: 50 + (normalizedScores[0]/100)*radiusScale * Math.cos(degToRad(-90)), y: 54 + (normalizedScores[0]/100)*radiusScale * Math.sin(degToRad(-90)) };
  const semiconductorPoint = { x: 50 + (normalizedScores[1]/100)*radiusScale * Math.cos(degToRad(-18)), y: 54 + (normalizedScores[1]/100)*radiusScale * Math.sin(degToRad(-18)) };
  const researchPoint = { x: 50 + (normalizedScores[2]/100)*radiusScale * Math.cos(degToRad(54)), y: 54 + (normalizedScores[2]/100)*radiusScale * Math.sin(degToRad(54)) };
  const productPoint = { x: 50 + (normalizedScores[3]/100)*radiusScale * Math.cos(degToRad(126)), y: 54 + (normalizedScores[3]/100)*radiusScale * Math.sin(degToRad(126)) };
  const marketPoint = { x: 50 + (normalizedScores[4]/100)*radiusScale * Math.cos(degToRad(198)), y: 54 + (normalizedScores[4]/100)*radiusScale * Math.sin(degToRad(198)) };
  
  return {
    polygon: `${aiPoint.x},${aiPoint.y} ${semiconductorPoint.x},${semiconductorPoint.y} ${researchPoint.x},${researchPoint.y} ${productPoint.x},${productPoint.y} ${marketPoint.x},${marketPoint.y}`,
    points: [aiPoint, semiconductorPoint, researchPoint, productPoint, marketPoint],
    scores: normalizedScores
  };
};
---

<div class="page-kicker">
  <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
  <i></i>
  <strong>Project ledger</strong>
</div>

<section id="project-overview" class="project-hero" aria-label="Projects overview">
  <div class="project-hero-copy">
    <p class="micro-label">Projects / Operating artifacts</p>
    <h1>{hero.title}</h1>
    <p>{hero.subtitle || page.description}</p>
  </div>

  <aside class="project-signal-panel" aria-label="Project status summary">
    <div>
      <span>Published</span>
      <strong>{String(visibleProjects.length).padStart(2, "0")}</strong>
    </div>
    <div>
      <span>Operating track</span>
      <strong>Dual Focus</strong>
    </div>
    <div>
      <span>Archive state</span>
      <strong>Curated</strong>
    </div>
  </aside>
</section>

{visibleProjects.length === 0 && (
  <section class="empty-projects">
    <span class="micro-label">Projects pending</span>
    <h2>Published project artifacts will appear here.</h2>
    <p>Draft entries stay out of the public index until they are marked published.</p>
  </section>
)}

{productProjects.length > 0 && (
  <section id="product-projects" class="project-grid-section" aria-label="Product & Venture Projects">
    <div class="project-grid-head">
      <p class="micro-label">Product, Venture & Systems</p>
      <h2>Patented Systems, Interactive Software, and Venture Innovations.</h2>
    </div>

    <div class="project-grid">
      {productProjects.map((project, index) => {
        const visual = visualMeta[project.data.visual] ?? visualMeta.blank;
        const primaryLink = project.data.links[0];
        const capabilityChart = createCapabilityRadarChart(project.data.capabilityScores);
        const showAppPreview = isA1trategizeProject(project) && Boolean(a1PreviewHref);
        const isHero = index === 0;
        const hasDoc = Boolean(project.data.pdf?.src);
        const docSrc = project.data.pdf?.src;
        const docTitle = project.data.title;
        const docLabel = project.data.pdf?.label || (docSrc?.endsWith('.mp4') ? "시연 영상 열람" : docSrc?.endsWith('index.html') ? "3D 게임 플레이" : "문서 열람");

        const hasPoster = Boolean(project.data.poster?.src);
        const posterSrc = project.data.poster?.src;
        const posterTitle = project.data.poster?.title || `${project.data.title} (Poster)`;

        const hasAward = Boolean(project.data.award?.src);
        const awardSrc = project.data.award?.src;
        const awardTitle = project.data.award?.title || `${project.data.title} (Award)`;

        const hasCert = Boolean(project.data.certificate?.src);
        const certSrc = project.data.certificate?.src;
        const certTitle = project.data.certificate?.title || `${project.data.title} (Certificate)`;
        const isPatent = certSrc?.includes('patent');
        const isAbstract = certSrc?.includes('abstract');
        const isPortfolio = certSrc?.includes('portfolio') || certSrc?.includes('deck') || certSrc?.includes('dossier');
        const certBtnText = isPatent ? "PATENT" : isAbstract ? "ABSTRACT" : isPortfolio ? "PORTFOLIO" : "CERTIFICATE";
        const certBtnClass = isPatent ? "is-patent" : isAbstract ? "is-abstract" : isPortfolio ? "is-portfolio" : "is-cert";

        const primaryVisualSrc = docSrc || posterSrc || awardSrc || certSrc;
        const primaryVisualTitle = project.data.title;
        const hasVisualLink = Boolean(primaryVisualSrc) && !isHero;

        const validPrimaryLink = primaryLink && primaryLink.href && primaryLink.href !== "#" ? primaryLink : null;
        const docKind = project.data.pdf?.kind;
        const docBtnText = docSrc?.endsWith('.mp4')
          ? "VIDEO DEMO"
          : docSrc?.endsWith('index.html')
            ? "PLAY GAME"
            : docKind === 'report' || project.id === 'nearly-free-electron'
              ? "REPORT"
              : "PRESENTATION";
        const docBtnClass = docSrc?.endsWith('.mp4')
          ? "is-video"
          : docSrc?.endsWith('index.html')
            ? "is-game"
            : docKind === 'report' || project.id === 'nearly-free-electron'
              ? "is-report"
              : "is-presentation";

        const hasAnyArtifact = hasDoc || hasPoster || hasAward || hasCert || Boolean(validPrimaryLink);

        return (
          <article id={`project-${project.id}`} class={`project-card reveal-up ${isHero ? 'bento-hero' : ''} ${showAppPreview ? 'has-app-preview' : ''}`} data-tone={visual.tone} data-project-id={project.id}>
            <div
              class={`card-visual ${hasVisualLink ? 'card-visual-interactive card-pdf-link' : ''}`}
              data-pdf-src={hasVisualLink ? primaryVisualSrc : undefined}
              data-pdf-title={hasVisualLink ? primaryVisualTitle : undefined}
              role={hasVisualLink ? "button" : undefined}
              tabindex={hasVisualLink ? "0" : undefined}
              title={hasVisualLink ? `${project.data.title} (Click to view)` : undefined}
              aria-label={hasVisualLink ? `View ${project.data.title}` : undefined}
            >
              <svg class="radar-chart" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
                <circle cx="50" cy="54" r="32" class="radar-grid-circle" />
                <circle cx="50" cy="54" r="16" class="radar-grid-circle" />
                
                <g class="radar-rotating-group">
                  <line x1="50" y1="54" x2="50" y2="22" class="radar-axis-line" />
                  <line x1="50" y1="54" x2="80.43" y2="44.11" class="radar-axis-line" />
                  <line x1="50" y1="54" x2="68.81" y2="79.89" class="radar-axis-line" />
                  <line x1="50" y1="54" x2="31.19" y2="79.89" class="radar-axis-line" />
                  <line x1="50" y1="54" x2="19.57" y2="44.11" class="radar-axis-line" />
                  
                  <polygon points={capabilityChart.polygon} class="radar-polygon-core" />
                  {capabilityChart.points.map((point) => <circle cx={point.x} cy={point.y} r="1.5" class="radar-vertex" />)}
                  
                  <text x="50" y="14" class="radar-label" text-anchor="middle">AI/SW {capabilityChart.scores[0]}</text>
                  <text x="88" y="42" class="radar-label" text-anchor="middle">NANO/HW {capabilityChart.scores[1]}</text>
                  <text x="74" y="88" class="radar-label" text-anchor="middle">R&D {capabilityChart.scores[2]}</text>
                  <text x="26" y="88" class="radar-label" text-anchor="middle">PM {capabilityChart.scores[3]}</text>
                  <text x="12" y="42" class="radar-label" text-anchor="middle">GTM {capabilityChart.scores[4]}</text>
                </g>
              </svg>
            </div>

            {isHero ? (
              <div class="hero-top-grid">
                <div class="hero-text-content">
                  <div class="card-meta">
                    <span>{projectCode(project.data.order)}</span>
                    <span>{project.data.year ?? "Now"} / {visual.label}</span>
                  </div>
                  <h3><span>{project.data.title}</span></h3>
                  <p>{project.data.summary}</p>
                  <div class="tag-row compact">
                    {project.data.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                </div>
                {project.data.pdf?.src && (project.data.pdf.src.endsWith('.mp4') || project.data.pdf.src.endsWith('.webm')) && (
                  <div
                    class="card-mini-video-preview card-pdf-link"
                    data-pdf-src={project.data.pdf.src}
                    data-pdf-title={project.data.pdf.title || project.data.title}
                    title="Click to view Demo Video"
                    role="button"
                    tabindex="0"
                  >
                    <video
                      src={project.data.pdf.src}
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="auto"
                      class="mini-preview-video"
                    ></video>
                    <div class="mini-video-overlay">
                      <span class="mini-video-badge">
                        <svg class="mini-play-icon" viewBox="0 0 24 24" fill="currentColor">
                          <polygon points="6 4 20 12 6 20 6 4"></polygon>
                        </svg>
                        <span>DEMO VIDEO</span>
                      </span>
                      <span class="mini-expand-badge" title="Click to view Demo Video">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="15 3 21 3 21 9"/>
                          <polyline points="9 21 3 21 3 15"/>
                          <line x1="21" y1="3" x2="14" y2="10"/>
                          <line x1="3" y1="21" x2="10" y2="14"/>
                        </svg>
                      </span>
                    </div>
                  </div>
                )}
              </div>
            ) : (
              <>
                <div class="card-meta">
                  <span>{projectCode(project.data.order)}</span>
                  <span>{project.data.year ?? "Now"} / {visual.label}</span>
                </div>
                <h3><span>{project.data.title}</span></h3>
                <p>{project.data.summary}</p>
                <div class="tag-row compact">
                  {project.data.tags.map((tag) => <span>{tag}</span>)}
                </div>
              </>
            )}

            {showAppPreview && (
              <div class="app-preview-panel" aria-label="A1trategize interactive frontend preview">
                <div class="app-preview-shell" data-source-width="1440">
                  <iframe
                    src={a1PreviewHref}
                    title="A1trategize interactive frontend preview"
                    loading="lazy"
                    referrerpolicy="no-referrer"
                  ></iframe>
                </div>
              </div>
            )}

            {hasAnyArtifact && (
              <div class="card-artifacts-row">
                {hasAward && (
                  <button
                    type="button"
                    class="artifact-minimal-btn is-award card-pdf-link"
                    data-pdf-src={awardSrc}
                    data-pdf-title={awardTitle}
                    title="공식 수상 상장/표창장 열람"
                    aria-label={`View Award for ${project.data.title}`}
                  >
                    <svg class="art-icon award-trophy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M6 9H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h2"/>
                      <path d="M18 9h2a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2h-2"/>
                      <path d="M4 22h16"/>
                      <path d="M10 14.66V17c0 .55-.45 1-1 1H7v4h10v-4h-2c-.55 0-1-.45-1-1v-2.34"/>
                      <path d="M6 3h12v7a6 6 0 0 1-12 0V3z"/>
                    </svg>
                    <span>AWARD</span>
                    <svg class="art-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 17L17 7M17 7H9M17 7V15"/>
                    </svg>
                  </button>
                )}
                {hasCert && (
                  <button
                    type="button"
                    class={`artifact-minimal-btn ${certBtnClass} card-pdf-link`}
                    data-pdf-src={certSrc}
                    data-pdf-title={certTitle}
                    title="공식 인증서/증명원 열람"
                    aria-label={`View ${certBtnText} for ${project.data.title}`}
                  >
                    <svg class="art-icon cert-seal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      {isPatent ? (
                        <>
                          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                          <path d="m9 12 2 2 4-4"/>
                        </>
                      ) : isAbstract ? (
                        <>
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                          <polyline points="14 2 14 8 20 8"/>
                          <line x1="16" y1="13" x2="8" y2="13"/>
                          <line x1="16" y1="17" x2="8" y2="17"/>
                        </>
                      ) : (
                        <>
                          <circle cx="12" cy="8" r="6"/>
                          <path d="M8.21 13.89L7 22l5-3 5 3-1.21-8.11"/>
                        </>
                      )}
                    </svg>
                    <span>{certBtnText}</span>
                    <svg class="art-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 17L17 7M17 7H9M17 7V15"/>
                    </svg>
                  </button>
                )}
                {hasDoc && (
                  <button
                    type="button"
                    class={`artifact-minimal-btn ${docBtnClass} card-pdf-link`}
                    data-pdf-src={docSrc}
                    data-pdf-title={docTitle}
                    title={docSrc?.endsWith('.mp4') ? "시연 영상 열람" : docSrc?.endsWith('index.html') ? "3D 게임 플레이" : docSrc?.includes('presentation') ? "구두발표 슬라이드 열람" : "프로젝트 문서 열람"}
                    aria-label={`View Project Artifact for ${project.data.title}`}
                  >
                    <svg class="art-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      {docSrc?.endsWith('.mp4') ? (
                        <polygon points="5 3 19 12 5 21 5 3" fill="currentColor"></polygon>
                      ) : docSrc?.endsWith('index.html') ? (
                        <polygon points="6 3 20 12 6 21 6 3" fill="currentColor"></polygon>
                      ) : (
                        <>
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                          <polyline points="14 2 14 8 20 8"/>
                        </>
                      )}
                    </svg>
                    <span>{docBtnText}</span>
                    <svg class="art-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 17L17 7M17 7H9M17 7V15"/>
                    </svg>
                  </button>
                )}
                {hasPoster && (
                  <button
                    type="button"
                    class="artifact-minimal-btn is-poster card-pdf-link"
                    data-pdf-src={posterSrc}
                    data-pdf-title={posterTitle}
                    title="학회 포스터 발표 자료 열람"
                    aria-label={`View Poster for ${project.data.title}`}
                  >
                    <svg class="art-icon poster-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="m21 15-5-5L5 21"/>
                    </svg>
                    <span>POSTER</span>
                    <svg class="art-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 17L17 7M17 7H9M17 7V15"/>
                    </svg>
                  </button>
                )}
                {validPrimaryLink && (
                  <a
                    class="artifact-minimal-btn is-link"
                    href={validPrimaryLink.href}
                    target={externalHref(validPrimaryLink.href) ? "_blank" : undefined}
                    rel={externalHref(validPrimaryLink.href) ? "noopener noreferrer" : undefined}
                  >
                    <span>{validPrimaryLink.label}</span>
                    <svg class="art-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M7 17L17 7M17 7H9M17 7V15"/>
                    </svg>
                  </a>
                )}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </section>
)}

{researchProjects.length > 0 && (
  <section id="research-projects" class="project-grid-section research-grid-section" aria-label="Deep Tech & Scientific R&D">
    <div class="project-grid-head">
      <p class="micro-label">Deep Tech & Scientific R&D</p>
      <h2>NNFC Nanofabrication, KRISS Metrology, and Applied AI Models.</h2>
    </div>

    <div class="project-grid">
      {researchProjects.map((project, index) => {
        const visual = visualMeta[project.data.visual] ?? visualMeta.blank;
        const primaryLink = project.data.links[0];
        const capabilityChart = createCapabilityRadarChart(project.data.capabilityScores);
        const isPendingLocked = isPendingLockedProject(project);
        const hasDoc = Boolean(project.data.pdf?.src);
        const docSrc = project.data.pdf?.src;
        const docTitle = project.data.title;
        const docLabel = project.data.pdf?.label || (docSrc?.endsWith('.mp4') ? "시연 영상 열람" : docSrc?.endsWith('index.html') ? "3D 게임 플레이" : "문서 열람");

        const hasPoster = Boolean(project.data.poster?.src);
        const posterSrc = project.data.poster?.src;
        const posterTitle = project.data.poster?.title || `${project.data.title} (Poster)`;

        const hasAward = Boolean(project.data.award?.src);
        const awardSrc = project.data.award?.src;
        const awardTitle = project.data.award?.title || `${project.data.title} (Award)`;

        const hasCert = Boolean(project.data.certificate?.src);
        const certSrc = project.data.certificate?.src;
        const certTitle = project.data.certificate?.title || `${project.data.title} (Certificate)`;
        const isPatent = certSrc?.includes('patent');
        const isAbstract = certSrc?.includes('abstract');
        const isPortfolio = certSrc?.includes('portfolio') || certSrc?.includes('deck') || certSrc?.includes('dossier');
        const certBtnText = isPatent ? "PATENT" : isAbstract ? "ABSTRACT" : isPortfolio ? "PORTFOLIO" : "CERTIFICATE";
        const certBtnClass = isPatent ? "is-patent" : isAbstract ? "is-abstract" : isPortfolio ? "is-portfolio" : "is-cert";

        const primaryVisualSrc = docSrc || posterSrc || awardSrc || certSrc;
        const primaryVisualTitle = project.data.title;
        const hasVisualLink = Boolean(primaryVisualSrc) && !isPendingLocked;

        const validPrimaryLink = primaryLink && primaryLink.href && primaryLink.href !== "#" ? primaryLink : null;
        const docKind = project.data.pdf?.kind;
        const docBtnText = docSrc?.endsWith('.mp4')
          ? "VIDEO DEMO"
          : docSrc?.endsWith('index.html')
            ? "PLAY GAME"
            : docKind === 'report' || project.id === 'nearly-free-electron'
              ? "REPORT"
              : "PRESENTATION";
        const docBtnClass = docSrc?.endsWith('.mp4')
          ? "is-video"
          : docSrc?.endsWith('index.html')
            ? "is-game"
            : docKind === 'report' || project.id === 'nearly-free-electron'
              ? "is-report"
              : "is-presentation";

        const hasAnyArtifact = !isPendingLocked && (hasDoc || hasPoster || hasAward || hasCert || Boolean(validPrimaryLink));

        return (
          <article
            id={`project-${project.id}`}
            class={`project-card reveal-up ${isPendingLocked ? 'is-locked-project' : ''}`}
            data-tone={visual.tone}
            data-project-id={project.id}
            data-lock-state={isPendingLocked ? "pending" : undefined}
            aria-label={isPendingLocked ? `${project.data.title} pending locked project` : undefined}
          >
            <div
              class={`card-visual ${hasVisualLink ? 'card-visual-interactive card-pdf-link' : ''}`}
              data-pdf-src={hasVisualLink ? primaryVisualSrc : undefined}
              data-pdf-title={hasVisualLink ? primaryVisualTitle : undefined}
              role={hasVisualLink ? "button" : undefined}
              tabindex={hasVisualLink ? "0" : undefined}
              title={hasVisualLink ? `${project.data.title} (Click to view)` : undefined}
              aria-label={hasVisualLink ? `View ${project.data.title}` : undefined}
            >
              {!isPendingLocked && (
                <svg class="radar-chart" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid meet">
                  <circle cx="50" cy="54" r="32" class="radar-grid-circle" />
                  <circle cx="50" cy="54" r="16" class="radar-grid-circle" />
                  
                  <g class="radar-rotating-group">
                    <line x1="50" y1="54" x2="50" y2="22" class="radar-axis-line" />
                    <line x1="50" y1="54" x2="80.43" y2="44.11" class="radar-axis-line" />
                    <line x1="50" y1="54" x2="68.81" y2="79.89" class="radar-axis-line" />
                    <line x1="50" y1="54" x2="31.19" y2="79.89" class="radar-axis-line" />
                    <line x1="50" y1="54" x2="19.57" y2="44.11" class="radar-axis-line" />
                    
                    <polygon points={capabilityChart.polygon} class="radar-polygon-core" />
                    {capabilityChart.points.map((point) => <circle cx={point.x} cy={point.y} r="1.5" class="radar-vertex" />)}
                    
                    <text x="50" y="14" class="radar-label" text-anchor="middle">AI/SW {capabilityChart.scores[0]}</text>
                    <text x="88" y="42" class="radar-label" text-anchor="middle">NANO/HW {capabilityChart.scores[1]}</text>
                    <text x="74" y="88" class="radar-label" text-anchor="middle">R&D {capabilityChart.scores[2]}</text>
                    <text x="26" y="88" class="radar-label" text-anchor="middle">PM {capabilityChart.scores[3]}</text>
                    <text x="12" y="42" class="radar-label" text-anchor="middle">GTM {capabilityChart.scores[4]}</text>
                  </g>
                </svg>
              )}
              {isPendingLocked && (
                <div class="pending-lock-visual">
                  <svg class="pending-lock-icon" viewBox="0 0 48 48" aria-hidden="true">
                    <path d="M15 21v-5.5C15 10.3 18.9 6 24 6s9 4.3 9 9.5V21" />
                    <rect x="9" y="21" width="30" height="21" rx="4" />
                    <circle cx="24" cy="31.5" r="2.5" />
                    <path d="M24 34v4" />
                  </svg>
