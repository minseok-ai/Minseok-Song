---
import ContactGraph from "../../ui/ContactGraph.astro";

const { navItem, hero, contactEntries = [] } = Astro.props;

const visibleChannels = contactEntries.flatMap((entry) =>
  entry.data.channels.filter((channel) => channel.visible)
);

const contactNodePositions = [
  { x: 50, y: 16 }, // Top
  { x: 80, y: 66 }, // Bottom Right
  { x: 20, y: 66 }, // Bottom Left
  { x: 84, y: 34 },
  { x: 16, y: 34 },
  { x: 50, y: 90 }
];

const contactNodes = visibleChannels.map((channel, index) => ({
  ...channel,
  ...(contactNodePositions[index % contactNodePositions.length] ?? contactNodePositions[0])
}));
---

<div class="page-kicker">
  <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
  <i></i>
  <strong>Open node</strong>
</div>

<div class="availability-strip reveal-in" aria-hidden="true">
  <div class="marquee-track">
    <span><span class="live-dot"></span> Available for · Strategy · AI Product · Research · Collaboration ·</span>
    <span><span class="live-dot"></span> Available for · Strategy · AI Product · Research · Collaboration ·</span>
    <span><span class="live-dot"></span> Available for · Strategy · AI Product · Research · Collaboration ·</span>
    <span><span class="live-dot"></span> Available for · Strategy · AI Product · Research · Collaboration ·</span>
  </div>
</div>

<div class="reveal-up stagger-1">
  <ContactGraph contactNodes={contactNodes} visibleChannels={visibleChannels} />
</div>

<style>
  .availability-strip {
    overflow: hidden;
    padding: 16px 0;
    border-top: 1px solid var(--color-line-strong);
    border-bottom: 1px solid var(--color-line-strong);
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    white-space: nowrap;
    background: var(--glass-bg);
    backdrop-filter: var(--glass-blur);
  }

  .live-dot {
    display: inline-block;
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    aspect-ratio: 1;
    background-color: var(--color-green);
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: middle;
    box-shadow: 0 0 8px var(--color-green-glow);
    animation: livePulse 1.8s infinite alternate;
  }

  @keyframes livePulse {
    0% { transform: scale(0.95); opacity: 0.7; box-shadow: 0 0 6px var(--color-green-glow); }
    100% { transform: scale(1.25); opacity: 1; box-shadow: 0 0 14px var(--color-green-glow); }
  }

  .marquee-track {
    display: inline-flex;
    align-items: center;
    animation: marquee 30s linear infinite;
  }

  .marquee-track > span {
    padding-right: 48px;
    display: inline-flex;
    align-items: center;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .availability-strip:hover .marquee-track {
    animation-play-state: paused;
  }
</style>
