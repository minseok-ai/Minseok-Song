---
import BlockRenderer from "../../BlockRenderer.astro";

const { page } = Astro.props;
const visibleBlocks = (page.blocks ?? []).filter((block) => !block.hidden);
---

<div class="block-stack">
  {visibleBlocks.map((block) => <BlockRenderer block={block} />)}
</div>

<style>
  .block-stack {
    display: grid;
    gap: 32px;
  }
  
  .block-stack :global(.text) {
    padding: 32px 0;
    border-bottom: 1px solid var(--color-line);
  }
  
  .block-stack :global(.text:last-child) {
    border-bottom: none;
  }
  
  .block-stack :global(.callout) {
    padding: 36px;
    border-radius: var(--radius-card);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(20, 20, 20, 0.5) 100%);
    border: 1px solid var(--color-line-strong);
    backdrop-filter: blur(16px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }
</style>
