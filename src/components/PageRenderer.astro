---
import ProfileView from "./sections/profile/ProfileView.astro";
import GridView from "./sections/projects/GridView.astro";
import ContactsView from "./sections/contacts/ContactsView.astro";

const {
  page,
  navItem,
  projects = [],
  contactEntries = []
} = Astro.props;

const hero = page.hero ?? {
  eyebrow: `${navItem.num} / ${navItem.label}`,
  title: page.title,
  subtitle: page.description
};
---

<section class={`page-frame section-page page-${page.layoutType}`}>
  {page.layoutType === "profile" && (
    <ProfileView page={page} navItem={navItem} hero={hero} />
  )}

  {page.layoutType === "projectIndex" && (
    <GridView page={page} navItem={navItem} hero={hero} projects={projects} />
  )}

  {page.layoutType === "contact" && (
    <ContactsView page={page} navItem={navItem} hero={hero} contactEntries={contactEntries} />
  )}
</section>

<script is:inline>
  const markCopied = (trigger) => {
    trigger.setAttribute("data-copied", "true");
    window.setTimeout(() => trigger.removeAttribute("data-copied"), 1400);
  };

  const copyTriggerValue = async (trigger) => {
    if (!trigger) return;

    const value = trigger.getAttribute("data-copy");
    if (!value) return;

    try {
      await navigator.clipboard.writeText(value);
      markCopied(trigger);
    } catch {
      trigger.removeAttribute("data-copied");
    }
  };

  document.addEventListener("click", async (event) => {
    const trigger = event.target.closest("[data-copy]");
    if (!trigger) return;

    event.preventDefault();
    await copyTriggerValue(trigger);
  });

  document.addEventListener("keydown", async (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;

    const trigger = event.target.closest("[data-copy]");
    if (!trigger) return;

    event.preventDefault();
    await copyTriggerValue(trigger);
  });
</script>

<style>
  .section-page {
    display: grid;
    gap: 72px;
  }

  /* 
    Shared global typography for page kickers and rows 
    These could be moved to global CSS, but are kept here for backward compatibility
  */
  :global(.page-kicker) {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  :global(.page-kicker i) {
    display: block;
    width: 32px;
    height: 1px;
    background: var(--color-line-strong);
  }

  :global(.page-kicker strong) {
    color: var(--color-ink);
  }

  :global(.micro-label) {
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .section-page {
      gap: 52px;
    }
  }
</style>
