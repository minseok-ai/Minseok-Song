---
import BlockRenderer from "./BlockRenderer.astro";
import ContactGraph from "./ui/ContactGraph.astro";

const {
  page,
  navItem,
  projects = [],
  writings = [],
  contactEntries = []
} = Astro.props;

const hero = page.hero ?? {
  eyebrow: `${navItem.num} / ${navItem.label}`,
  title: page.title,
  subtitle: page.description
};

const visibleBlocks = (page.blocks ?? []).filter((block) => !block.hidden);
const timelineBlock = visibleBlocks.find((block) => block.type === "timeline");
const leadBlock = visibleBlocks.find(
  (block) => block.type === "text" && block.variant === "lead"
);
const calloutBlock = visibleBlocks.find((block) => block.type === "callout");
const statBlock = visibleBlocks.find((block) => block.type === "stats");

const projectNotes = projects
  .filter((entry) => !entry.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);

const newsletterEntries = writings
  .filter((entry) => !entry.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);

const visibleChannels = contactEntries.flatMap((entry) =>
  entry.data.channels.filter((channel) => channel.visible)
);

const contactNodePositions = [
  { x: 50, y: 16 }, // Top
  { x: 80, y: 66 }, // Bottom Right
  { x: 20, y: 66 }, // Bottom Left
  { x: 84, y: 34 },
  { x: 16, y: 34 },
  { x: 50, y: 90 }
];

const contactNodes = visibleChannels.map((channel, index) => ({
  ...channel,
  ...(contactNodePositions[index % contactNodePositions.length] ?? contactNodePositions[0])
}));

const articleTags = ["Source", "Crawl", "Review", "Publish"];

const projectVisualLabels = {
  console: "System",
  graph: "Map",
  paper: "Note",
  deck: "Deck",
  blank: "Draft"
};
---

<section class={`page-frame section-page page-${page.layoutType}`}>
  {page.layoutType === "profile" && (
    <>
      <div class="page-kicker">
        <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
        <i></i>
        <strong>Self interview</strong>
      </div>

      <section class="about-hero">
        <figure class="identity-figure" aria-label="Minseok Song identity diagram">
          <div class="identity-orbit">
            <div class="profile-center" style="position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; overflow: hidden;">
              <div class="profile-bg" style="position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; background-image: url('/profile.jpg'); background-size: cover; background-position: center;"></div>
            </div>
            <div class="orbit-ring">
              <span class="orbit-node node-a"></span>
              <span class="orbit-node node-b"></span>
              <span class="orbit-node node-c"></span>
            </div>
          </div>
          <figcaption>
            <span>Fig. 00 — Self</span>
            <span>Strategy · AI · Operating Systems</span>
          </figcaption>
        </figure>

        <div class="about-statement">
          <svg viewBox="0 0 620 120" aria-hidden="true">
            <polyline
              points="18,84 108,46 188,70 274,42 370,68 470,36 600,54"
              fill="none"
              stroke="currentColor"
              stroke-dasharray="2 8"
            />
            {[18, 108, 188, 274, 370, 470, 600].map((x, index) => (
              <circle cx={x} cy={[84, 46, 70, 42, 68, 36, 54][index]} r={index === 0 || index === 6 ? 6 : 4} />
            ))}
          </svg>
          <blockquote>
            "{calloutBlock?.body ??
              "A1 Firms is organized around one practical question: how can ambiguous strategy work become clearer decisions, better tools, and repeatable operating habits?"}"
          </blockquote>
        </div>
      </section>

      <section class="about-thesis">
        <aside class="sticky-timeline">
          <span class="micro-label">Timeline / Sticky</span>
          <ol>
            {(timelineBlock?.events ?? [
              {
                date: "Now",
                title: "A1 Firms foundation",
                body: "Design, product, and operating systems are being composed into one public surface."
              }
            ]).map((event, index) => (
              <li class={index === 0 ? "is-current" : ""}>
                <span>{event.date}</span>
                <strong>{event.title}</strong>
                {event.body && <small>{event.body}</small>}
              </li>
            ))}
          </ol>
        </aside>

        <article class="thesis-copy">
          <p class="micro-label">§ 1 — The Operating Question</p>
          <h1>{hero.title}</h1>
          <p class="lead-copy">
            {leadBlock?.body ??
              "I build structured ways to turn ambiguous strategic questions into usable systems, product surfaces, and durable operating habits."}
          </p>
          <div class="essay-columns">
            <p>
              A1 is not framed as a portfolio of disconnected work. It is a
              public operating layer for strategy, software, research, and the
              habits that make those things repeatable.
            </p>
            <p>
              The site should therefore behave less like a brochure and more
              like a map: where the person, the firm, the product, the writing,
              and the contact surface each have a distinct role.
            </p>
          </div>
          {statBlock && (
            <dl class="signal-strip">
              {statBlock.stats.map((stat) => (
                <div>
                  <dt>{stat.label}</dt>
                  <dd>{stat.value}</dd>
                  {stat.description && <p>{stat.description}</p>}
                </div>
              ))}
            </dl>
          )}
        </article>
      </section>
    </>
  )}

  {page.layoutType === "projectIndex" && (
    <>
      <div class="page-kicker">
        <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
        <i></i>
        <strong>Portfolio journal</strong>
      </div>

      <section class="index-hero portfolio-hero">
        <h1>{hero.title}</h1>
        <p>
          {hero.subtitle ??
            "Selected projects, build logs, decks, and research notes collected as a portfolio blog."}
        </p>
      </section>

      <section class="portfolio-console">
        <div class="portfolio-toolbar">
          <span>{String(projectNotes.length).padStart(2, "0")} entries</span>
          <strong>Project / writing / artifact</strong>
        </div>

        <div class="portfolio-grid">
          {projectNotes.length > 0 ? (
            projectNotes.map((project, index) => (
              <article class={`portfolio-card visual-${project.data.visual}`}>
                <a href={project.data.links[0]?.href ?? "#"}>
                  <figure class="portfolio-cover">
                    {project.data.cover?.src ? (
                      <img
                        src={project.data.cover.src}
                        alt={project.data.cover.alt ?? project.data.title}
                        loading="lazy"
                      />
                    ) : (
                      <div class="cover-visual" aria-hidden="true">
                        <span>{String(index + 1).padStart(2, "0")}</span>
                        <strong>{projectVisualLabels[project.data.visual]}</strong>
                      </div>
                    )}
                  </figure>
                  <small>{project.data.year ?? "Draft"} · {project.data.status}</small>
                  <h2>{project.data.title}</h2>
                  <p>{project.data.summary}</p>
                  <div class="tag-column">
                    {project.data.tags.map((tag) => <span>{tag}</span>)}
                  </div>
                </a>
              </article>
            ))
          ) : (
            <article class="empty-ledger">
              <span class="micro-label">No project notes yet</span>
              <h2>Project notes are pending.</h2>
              <p>
                Add project essays to <code>src/content/projects</code> when the
                writing layer is connected.
              </p>
            </article>
          )}
        </div>
      </section>
    </>
  )}

  {page.layoutType === "writingIndex" && (
    <>
      <div class="page-kicker">
        <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
        <i></i>
        <strong>Newsletter desk</strong>
      </div>

      <section class="index-hero newsletter-hero">
        <h1>Reviewed articles, crawled sources, and short editorial signals.</h1>
        <p>
          Writings is not a loose essay shelf. It is the newsletter surface:
          find a worthwhile article, crawl the full text, review the argument,
          then publish a concise Korean note with source trace intact.
        </p>
        <a class="admin-entry-link" href="/admin/writings">Open writing desk</a>
      </section>

      <section class="newsletter-instrument">
        <div class="pipeline-meter">
          {articleTags.map((tag, index) => (
            <div>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{tag}</strong>
            </div>
          ))}
        </div>
        <div class="newsletter-list">
          {newsletterEntries.length > 0 ? (
            newsletterEntries.map((writing, index) => (
              <a class="newsletter-row" href={`/writings/${writing.id}`}>
                <span>{String(index + 1).padStart(3, "0")}</span>
                <time>{writing.data.date ?? "Draft"}</time>
                <strong>{writing.data.title}</strong>
                <em>{writing.data.tags[0] ?? "Review"}</em>
                <small>{writing.data.summary}</small>
                <b aria-hidden="true">→</b>
              </a>
            ))
          ) : (
            <div class="empty-ledger">
              <span class="micro-label">Newsletter pending</span>
              <h2>Connect crawler output to publish reviewed briefs here.</h2>
              <p>Each issue should keep source, crawl, review, and final note separate.</p>
            </div>
          )}
        </div>
      </section>
    </>
  )}

  {page.layoutType === "contact" && (
    <>
      <div class="page-kicker">
        <span>{hero.eyebrow ?? `${navItem.num} / ${navItem.label}`}</span>
        <i></i>
        <strong>Open node</strong>
      </div>

      <div class="availability-strip" aria-hidden="true">
        <span>Available for · Strategy · AI Product · Research · Collaboration ·</span>
        <span>Available for · Strategy · AI Product · Research · Collaboration ·</span>
      </div>

      <ContactGraph contactNodes={contactNodes} visibleChannels={visibleChannels} />
    </>
  )}

  {page.layoutType === "product" && (
    <div class="block-stack">
      {visibleBlocks.map((block) => <BlockRenderer block={block} />)}
    </div>
  )}
</section>

<script is:inline>
  document.addEventListener("click", async (event) => {
    const trigger = event.target.closest("[data-copy]");
    if (!trigger) return;

    const value = trigger.getAttribute("data-copy");
    if (!value) return;

    event.preventDefault();

    try {
      await navigator.clipboard.writeText(value);
      trigger.setAttribute("data-copied", "true");
      window.setTimeout(() => trigger.removeAttribute("data-copied"), 1400);
    } catch {
      trigger.removeAttribute("data-copied");
    }
  });

  // 3D Tilt for Portfolio Cards
  const cards = document.querySelectorAll('.portfolio-card a');
  cards.forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -4;
      const rotateY = ((x - centerX) / centerX) * 4;
      
      card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });
    
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'rotateX(0) rotateY(0)';
      card.style.transition = 'transform 0.4s ease';
    });
    
    card.addEventListener('mouseenter', () => {
      card.style.transition = 'none';
    });
  });

  // Spotlight hover for Newsletter Rows
  const rows = document.querySelectorAll('.newsletter-row');
  rows.forEach(row => {
    row.addEventListener('mousemove', (e) => {
      const rect = row.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      row.style.setProperty('--mouse-x', `${x}px`);
      row.style.setProperty('--mouse-y', `${y}px`);
    });
  });

  // 3D Tilt for Identity Figure
  const identityFigure = document.querySelector('.identity-figure');
  if (identityFigure) {
    identityFigure.addEventListener('mousemove', (e) => {
      const rect = identityFigure.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -10;
      const rotateY = ((x - centerX) / centerX) * 10;
      
      identityFigure.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    });
    
    identityFigure.addEventListener('mouseleave', () => {
      identityFigure.style.transform = 'rotateX(0) rotateY(0)';
      identityFigure.style.transition = 'transform var(--motion-slow) ease';
    });
    
    identityFigure.addEventListener('mouseenter', () => {
      identityFigure.style.transition = 'none';
    });
  }
</script>

<style>
  .section-page {
    display: grid;
    gap: 72px;
  }

  .page-kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .page-kicker i {
    display: block;
    width: 32px;
    height: 1px;
    background: var(--color-line-strong);
  }

  .page-kicker strong {
    color: var(--color-ink);
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(300px, 0.85fr) minmax(0, 1.35fr);
    gap: 72px;
    align-items: end;
    min-height: 650px;
  }

  .identity-figure {
    display: grid;
    gap: 22px;
    margin: 0;
    perspective: 1000px;
    transform-style: preserve-3d;
    transition: transform var(--motion-slow) ease;
  }

  .identity-orbit {
    position: relative;
    display: grid;
    place-items: center;
    width: min(520px, 100%);
    aspect-ratio: 1;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    background:
      radial-gradient(circle at 48% 42%, rgba(248, 247, 242, 0.1), transparent 34%),
      #050505;
    outline: 1px solid var(--color-line);
    outline-offset: 12px;
  }

  .profile-center {
    position: relative;
    display: grid;
    place-items: center;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 40px rgba(0,0,0,0.8);
    border: 1px solid var(--color-line-strong);
    background: #000;
    transform: translateZ(0); /* force stacking context and fix Safari clipping */
    -webkit-mask-image: -webkit-radial-gradient(white, black);
  }

  .profile-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0.45;
    mix-blend-mode: luminosity;
    transition: opacity var(--motion-slow) ease, mix-blend-mode var(--motion-slow) ease, transform var(--motion-slow) ease;
  }

  .identity-figure:hover .profile-bg {
    opacity: 0.85;
    mix-blend-mode: normal;
    transform: scale(1.05);
  }

  .identity-orbit strong {
    position: relative;
    z-index: 1;
    font-size: 6rem;
    font-weight: 900;
    line-height: 1;
    text-shadow: 0 4px 20px rgba(0,0,0,1);
  }

  .identity-orbit small {
    margin-top: 86px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 800;
    position: absolute;
    text-transform: uppercase;
  }

  .orbit-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    animation: orbitSpin 24s linear infinite;
    pointer-events: none;
  }

  @keyframes orbitSpin {
    100% { transform: rotate(360deg); }
  }

  .orbit-node {
    position: absolute;
    width: 13px;
    height: 13px;
    border: 1px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-paper);
  }

  .node-a {
    top: 20%;
    right: 22%;
  }

  .node-b {
    bottom: 23%;
    left: 18%;
  }

  .node-c {
    right: 17%;
    bottom: 18%;
    background: var(--color-ink);
  }

  .identity-figure figcaption {
    display: grid;
    gap: 8px;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .about-statement {
    display: grid;
    gap: 28px;
  }

  .about-statement svg {
    width: min(680px, 100%);
    height: auto;
    color: var(--color-ink-soft);
  }

  .about-statement polyline {
    animation: dashTicker 0.8s linear infinite;
  }

  @keyframes dashTicker {
    to { stroke-dashoffset: -10; }
  }

  .about-statement circle {
    fill: var(--color-paper);
    stroke: currentColor;
  }

  .about-statement blockquote {
    margin: 0;
    max-width: 820px;
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 760;
    line-height: 1.22;
  }

  .about-thesis {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 88px;
    align-items: start;
  }

  .sticky-timeline {
    position: sticky;
    top: calc(var(--header-height) + 32px);
  }

  .sticky-timeline ol {
    display: grid;
    gap: 0;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .sticky-timeline li {
    position: relative;
    display: grid;
    gap: 5px;
    padding: 0 0 28px 26px;
    color: var(--color-ink-muted);
  }

  .sticky-timeline li::before {
    content: "";
    position: absolute;
    top: 6px;
    left: 0;
    width: 10px;
    height: 10px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--color-paper);
  }

  .sticky-timeline li::after {
    content: "";
    position: absolute;
    top: 18px;
    bottom: 2px;
    left: 5px;
    width: 1px;
    background: var(--color-line);
  }

  .sticky-timeline li.is-current {
    color: var(--color-ink);
  }

  .sticky-timeline li.is-current::before {
    background: var(--color-ink);
  }

  .sticky-timeline span,
  .sticky-timeline strong,
  .sticky-timeline small {
    display: block;
  }

  .sticky-timeline span {
    font-size: 12px;
    font-weight: 800;
  }

  .sticky-timeline small {
    font-size: 12px;
    line-height: 1.45;
  }

  .thesis-copy {
    border-left: 1px solid var(--color-line-strong);
    padding-left: 32px;
  }

  .thesis-copy h1,
  .index-hero h1,
  .contact-copy h1 {
    margin: 0;
    max-width: 960px;
    font-family: var(--font-serif);
    font-size: clamp(2.45rem, 3.65vw, 3.55rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .contact-copy h1 {
    max-width: 640px;
    font-size: clamp(2.35rem, 3.35vw, 3.3rem);
  }

  .lead-copy {
    margin: 32px 0 0;
    max-width: 820px;
    font-size: clamp(1.35rem, 2.1vw, 1.8rem);
    font-weight: 700;
    line-height: 1.36;
  }

  .essay-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
    margin-top: 42px;
    color: var(--color-ink-soft);
    font-size: 17px;
    line-height: 1.75;
  }

  .signal-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 44px 0 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .signal-strip div {
    padding: 22px;
    border-right: 1px solid var(--color-line);
  }

  .signal-strip div:last-child {
    border-right: 0;
  }

  .signal-strip dt {
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .signal-strip dd {
    margin: 8px 0 0;
    font-size: 2.6rem;
    font-weight: 900;
    line-height: 1;
  }

  .signal-strip p {
    margin: 8px 0 0;
    color: var(--color-ink-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .index-hero {
    display: grid;
    gap: 28px;
  }

  .split-hero {
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.64fr);
    align-items: end;
  }

  .index-hero p,
  .contact-copy p {
    margin: 0;
    max-width: 640px;
    color: var(--color-ink-soft);
    font-size: 18px;
    line-height: 1.65;
  }

  .project-console {
    display: grid;
    gap: 28px;
  }

  .portfolio-hero {
    max-width: 900px;
  }

  .portfolio-console {
    display: grid;
    gap: 28px;
  }

  .portfolio-toolbar {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--color-line-strong);
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .portfolio-toolbar strong {
    color: var(--color-ink-soft);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 54px) clamp(18px, 2vw, 26px);
  }

  .portfolio-card {
    min-width: 0;
    perspective: 1200px;
  }

  .portfolio-card a {
    display: grid;
    gap: 14px;
    color: inherit;
    text-decoration: none;
    transform-style: preserve-3d;
    transition: transform var(--motion-slow) ease;
  }

  .portfolio-cover {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-card);
    background: var(--color-panel);
    transition: box-shadow var(--motion-slow) ease, border-color var(--motion-slow) ease;
    transform: translateZ(20px);
  }

  .portfolio-card:hover .portfolio-cover {
    border-color: rgba(255, 255, 255, 0.2);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), inset 0 0 20px rgba(255, 255, 255, 0.02);
  }

  .portfolio-cover img,
  .cover-visual {
    width: 100%;
    height: 100%;
  }

  .portfolio-cover img {
    display: block;
    object-fit: cover;
  }

  .cover-visual {
    position: relative;
    display: grid;
    align-content: space-between;
    padding: 18px;
    background:
      linear-gradient(135deg, rgba(248, 247, 242, 0.06), transparent 46%),
      linear-gradient(90deg, rgba(248, 247, 242, 0.03) 1px, transparent 1px),
      linear-gradient(180deg, rgba(248, 247, 242, 0.03) 1px, transparent 1px),
      var(--color-panel);
    background-size: auto, 54px 100%, 100% 54px, auto;
    transition: background-position var(--motion-slow) linear;
  }

  .portfolio-card:hover .cover-visual {
    background-position: 0 0, -10px -10px, -10px -10px, 0 0;
  }

  .cover-visual::after {
    content: "";
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 34%;
    height: 40%;
    border-top: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    opacity: 0.2;
