---
const { sectionCards } = Astro.props;
---

<section id="surfaces" class="surface-index fade-in-up" aria-label="Site index">
  <div class="section-head">
    <p class="micro-label">Surfaces</p>
    <h2>Five public surfaces around one working product.</h2>
  </div>

  <div class="surface-grid">
    {sectionCards.map((item, index) => (
      <a
        class={`surface-card surface-step-${(index % 5) + 1}`}
        href={item.path}
        data-surface={item.id}
      >
        <span class="shimmer-sweep"></span>
        <span class="surface-num">{item.num}</span>
        <span class="surface-glyph">{item.meta.glyph}</span>
        <div class="surface-content">
          <div class="surface-category">
            <span class="pulse-dot"></span>
            <small>{item.meta.line}</small>
          </div>
          <h3>{item.label}</h3>
          <p>{item.page?.description ?? item.layoutType}</p>
        </div>
        <span class="surface-command">
          {item.id === "a1-firms" ? "Launch product" : "Open section"}
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    ))}
  </div>
</section>

<script is:inline>
  const initSurfaceCards = () => {
    const cards = document.querySelectorAll('.surface-card');
    cards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        // Dynamic tilt calculation (max ~4.5 degrees)
        const rotateX = ((y - centerY) / centerY) * -4.5;
        const rotateY = ((x - centerX) / centerX) * 4.5;
        
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-6px)`;
      });
      
      card.addEventListener('mouseleave', () => {
        card.style.transform = '';
        card.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease, background-color 0.6s ease, border-color 0.6s ease';
      });
      
      card.addEventListener('mouseenter', () => {
        card.style.transition = 'box-shadow 0.6s ease, background-color 0.6s ease, border-color 0.6s ease';
      });
    });
  };

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSurfaceCards);
  } else {
    initSurfaceCards();
  }
</script>

<style>
  .surface-index {
    display: grid;
    gap: 32px;
    padding-top: 104px;
    padding-bottom: 92px;
    border-top: 1px solid var(--color-line);
    width: min(100%, var(--max-site));
    margin: 0 auto;
    padding-right: var(--space-page);
    padding-left: var(--space-page);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: end;
    border-bottom: 1px solid var(--color-line-strong);
    padding-bottom: 24px;
  }

  .section-head h2 {
    max-width: 620px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: right;
  }

  .surface-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  .surface-card {
    position: relative;
    display: grid;
    align-content: space-between;
    min-height: 360px;
    padding: 36px;
    border-radius: 8px;
    overflow: hidden;
    color: var(--color-ink);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--color-line), var(--glass-shadow);
    backdrop-filter: var(--glass-blur);
    text-decoration: none;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
    will-change: transform;
    
    animation: fadeInUp 0.6s var(--easing-smooth) both;
  }

  .surface-step-1 { animation-delay: 0ms; }
  .surface-step-2 { animation-delay: 100ms; }
  .surface-step-3 { animation-delay: 200ms; }
  .surface-step-4 { animation-delay: 300ms; }
  .surface-step-5 { animation-delay: 400ms; }

  /* Map accents and RGB counterparts for gradient opacities */
  .surface-card[data-surface="about"] { 
    --accent: var(--color-blue); 
    --rgb-accent: 107, 156, 242; 
  }
  .surface-card[data-surface="a1-firms"] { 
    --accent: var(--color-warm); 
    --rgb-accent: var(--rgb-warm); 
  }
  .surface-card[data-surface="projects"] { 
    --accent: var(--color-green); 
    --rgb-accent: 108, 163, 125; 
  }
  .surface-card[data-surface="writings"] { 
    --accent: var(--color-coral); 
    --rgb-accent: 239, 182, 141; 
  }
  .surface-card[data-surface="contacts"] { 
    --accent: var(--color-purple); 
    --rgb-accent: 179, 154, 251; 
  }

  /* Spotlight Background Glow */
  .surface-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(var(--rgb-accent), 0.08),
      transparent 80%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 0;
  }

  [data-theme="light"] .surface-card::before {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(var(--rgb-accent), 0.12),
      transparent 80%
    );
  }

  /* Spotlight Border Glow using CSS mask */
  .surface-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, var(--color-line-strong) 0%, transparent 40%, transparent 60%, var(--color-line) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.5;
    transition: opacity 0.5s ease, background-image 0.5s ease;
    pointer-events: none;
    z-index: 1;
  }

  .shimmer-sweep {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 0%,
      transparent 35%,
      var(--color-line) 45%,
      var(--color-line-strong) 50%,
      var(--color-line) 55%,
      transparent 65%,
      transparent 100%
    );
    transform: translateX(-100%) skewX(-15deg);
    transition: none;
    z-index: 2;
    pointer-events: none;
  }

  .surface-card:nth-child(1),
  .surface-card:nth-child(2) {
    grid-column: span 3;
  }

  .surface-card:nth-child(n + 3) {
    grid-column: span 2;
  }

  /* Upgraded background floating glyph */
  .surface-glyph {
    position: absolute;
    top: 32px;
    right: 36px;
    font-size: 72px;
    font-weight: 950;
    line-height: 1;
    font-family: var(--font-sans);
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, var(--accent) 0%, rgba(var(--rgb-accent), 0.15) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0.08;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
    user-select: none;
    pointer-events: none;
  }

  [data-theme="light"] .surface-glyph {
    opacity: 0.12;
  }

  .surface-num {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink-muted);
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
    z-index: 1;
  }

  .surface-content {
    position: relative;
    z-index: 2;
    transform: translateZ(20px); /* slightly lifts text on 3D tilt */
  }

  .surface-category {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  /* Pulsing dot indicator */
  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    position: relative;
    display: inline-block;
  }

  .pulse-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    opacity: 0.8;
    animation: dotPulse 2.2s infinite cubic-bezier(0.25, 0, 0, 1);
  }

  @keyframes dotPulse {
    0% {
      transform: scale(0.6);
      opacity: 0.8;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .surface-card small {
    color: var(--accent);
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    opacity: 0.95;
  }

  .surface-card h3 {
    margin: 10px 0 16px;
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .surface-card p {
    max-width: 470px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 15px;
    line-height: 1.65;
    transition: color 0.3s ease;
  }

  /* Pill-button styling for commands */
  .surface-command {
    position: relative;
    z-index: 2;
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.01);
    width: fit-content;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateZ(15px);
  }

  .surface-command svg {
    display: block;
    width: 14px;
    height: 14px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Card Hover Styles */
  .surface-card:hover {
    box-shadow: 
      inset 0 1px 0 var(--color-line-strong), 
      0 24px 60px var(--glass-shadow),
      0 0 50px -10px rgba(var(--rgb-accent), 0.12);
    background: var(--color-panel-solid);
    border-color: rgba(var(--rgb-accent), 0.25);
  }

  [data-theme="light"] .surface-card:hover {
    box-shadow: 
      inset 0 1px 0 var(--color-line-strong), 
      0 24px 60px var(--glass-shadow),
      0 0 50px -10px rgba(var(--rgb-accent), 0.16);
    background: var(--color-panel-solid);
    border-color: rgba(var(--rgb-accent), 0.3);
  }

  .surface-card:hover::before {
    opacity: 1;
  }

  .surface-card:hover::after {
    opacity: 1;
    background: 
      radial-gradient(
        250px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(var(--rgb-accent), 0.48),
        transparent 70%
      ),
      linear-gradient(135deg, var(--color-line-strong) 0%, transparent 40%, transparent 60%, var(--color-line) 100%);
  }

  [data-theme="light"] .surface-card:hover::after {
    background: 
      radial-gradient(
        250px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(var(--rgb-accent), 0.6),
        transparent 70%
      ),
      linear-gradient(135deg, var(--color-line-strong) 0%, transparent 40%, transparent 60%, var(--color-line) 100%);
  }

  .surface-card:hover .shimmer-sweep {
    transform: translateX(100%) skewX(-15deg);
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .surface-card:hover .surface-glyph {
    transform: scale(1.15) translateY(-4px) rotate(4deg);
    opacity: 0.25;
    filter: drop-shadow(0 8px 16px rgba(var(--rgb-accent), 0.2));
  }

  [data-theme="light"] .surface-card:hover .surface-glyph {
    opacity: 0.3;
  }

  .surface-card:hover h3 {
    transform: translateY(-2px);
  }

  .surface-card:hover p {
    color: var(--color-ink-soft);
  }

  .surface-card:hover .surface-command {
    color: var(--color-ink);
    border-color: rgba(var(--rgb-accent), 0.4);
    background: rgba(var(--rgb-accent), 0.08);
    box-shadow: 0 4px 12px rgba(var(--rgb-accent), 0.1);
  }

  .surface-card:hover .surface-command svg {
    transform: translateX(4px);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 820px) {
    .surface-grid {
      grid-template-columns: 1fr;
    }

    .surface-card:nth-child(1),
    .surface-card:nth-child(2),
    .surface-card:nth-child(n + 3) {
      grid-column: auto;
    }

    .section-head {
      display: grid;
      align-items: start;
    }

    .section-head h2 {
      text-align: left;
    }
  }
</style>
