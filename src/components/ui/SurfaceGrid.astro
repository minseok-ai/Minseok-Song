---
const { sectionCards } = Astro.props;
---

<section id="surfaces" class="surface-index fade-in-up" aria-label="Site index">
  <div class="section-head">
    <p class="micro-label">Surfaces</p>
    <h2>Four public surfaces around one working product.</h2>
  </div>

  <div class="surface-grid">
    {sectionCards.map((item, index) => (
      <a
        class={`surface-card surface-step-${(index % 4) + 1}`}
        href={item.path}
        data-surface={item.id}
      >
        <span class="shimmer-sweep"></span>
        <div class="surface-top">
          <span class="surface-num">{item.num}</span>
          <span class="surface-glyph">{item.meta.glyph}</span>
        </div>
        
        <div class="surface-content">
          <div class="surface-category">
            <span class="pulse-dot"></span>
            <small>{item.meta.line}</small>
          </div>
          <h3>{item.label}</h3>
          <p>{item.page?.description ?? item.layoutType}</p>
        </div>

        <div class="surface-bottom">
          <span class="surface-command">
            <span>{item.id === "a1-firms" ? "Launch product" : "Open section"}</span>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" style="width: 14px; height: 14px; min-width: 14px; max-width: 14px; flex-shrink: 0;">
              <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </div>
      </a>
    ))}
  </div>
</section>

<script is:inline>
  const initSurfaceCards = () => {
    const cards = document.querySelectorAll('.surface-card');
    cards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        // Dynamic tilt calculation (max ~4.5 degrees)
        const rotateX = ((y - centerY) / centerY) * -4.5;
        const rotateY = ((x - centerX) / centerX) * 4.5;
        
        card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-6px)`;
      });
      
      card.addEventListener('mouseleave', () => {
        card.style.transform = '';
        card.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease, background-color 0.6s ease, border-color 0.6s ease';
      });
      
      card.addEventListener('mouseenter', () => {
        card.style.transition = 'box-shadow 0.6s ease, background-color 0.6s ease, border-color 0.6s ease';
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSurfaceCards);
  } else {
    initSurfaceCards();
  }
</script>

<style>
  .surface-index {
    display: grid;
    gap: 32px;
    padding-top: 104px;
    padding-bottom: 92px;
    border-top: 1px solid var(--color-line);
    width: min(100%, var(--max-site));
    margin: 0 auto;
    padding-right: var(--space-page);
    padding-left: var(--space-page);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: end;
    border-bottom: 1px solid var(--color-line-strong);
    padding-bottom: 24px;
  }

  .section-head h2 {
    max-width: 620px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: right;
  }

  .surface-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .surface-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 330px;
    padding: 34px 38px 30px;
    border-radius: 16px;
    overflow: hidden;
    color: var(--color-ink);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--color-line), var(--glass-shadow);
    backdrop-filter: var(--glass-blur);
    text-decoration: none;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
    will-change: transform;
    animation: fadeInUp 0.6s var(--easing-smooth) both;
  }

  .surface-step-1 { animation-delay: 0ms; }
  .surface-step-2 { animation-delay: 100ms; }
  .surface-step-3 { animation-delay: 200ms; }
  .surface-step-4 { animation-delay: 300ms; }

  /* Map accents and RGB counterparts for gradient opacities */
  .surface-card[data-surface="about"] { 
    --accent: var(--color-blue); 
    --rgb-accent: 107, 156, 242; 
  }
  .surface-card[data-surface="a1-firms"] { 
    --accent: var(--color-warm); 
    --rgb-accent: var(--rgb-warm); 
  }
  .surface-card[data-surface="projects"] { 
    --accent: var(--color-green); 
    --rgb-accent: 108, 163, 125; 
  }
  .surface-card[data-surface="contacts"] { 
    --accent: var(--color-purple); 
    --rgb-accent: 179, 154, 251; 
  }

  /* Spotlight Background Glow */
  .surface-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(var(--rgb-accent), 0.08),
      transparent 80%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 0;
  }

  :global(html:global(html[data-theme="light"])) .surface-card::before {
    background: radial-gradient(
      350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(var(--rgb-accent), 0.12),
      transparent 80%
    );
  }

  /* Spotlight Border Glow using CSS mask */
  .surface-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, var(--color-line-strong) 0%, transparent 40%, transparent 60%, var(--color-line) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.5;
    transition: opacity 0.5s ease, background-image 0.5s ease;
    pointer-events: none;
    z-index: 1;
  }

  :global(html:global(html[data-theme="light"])) .surface-card::after {
    background: 
      radial-gradient(
        250px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(var(--rgb-accent), 0.6),
        transparent 70%
      ),
      linear-gradient(135deg, var(--color-line-strong) 0%, transparent 40%, transparent 60%, var(--color-line) 100%);
  }

  .shimmer-sweep {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 0%,
      transparent 35%,
      var(--color-line) 45%,
      var(--color-line-strong) 50%,
      var(--color-line) 55%,
      transparent 65%,
      transparent 100%
    );
    transform: translateX(-100%) skewX(-15deg);
    transition: none;
    z-index: 2;
    pointer-events: none;
  }

  .surface-top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    width: 100%;
    z-index: 1;
  }

  .surface-glyph {
    position: absolute;
    top: -12px;
    right: 0;
    font-size: 74px;
    font-weight: 950;
    line-height: 1;
    font-family: var(--font-sans);
    letter-spacing: -0.04em;
    background: linear-gradient(135deg, var(--accent) 0%, rgba(var(--rgb-accent), 0.15) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0.12;
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    user-select: none;
    pointer-events: none;
  }

  :global(html:global(html[data-theme="light"])) .surface-glyph {
    opacity: 0.18;
  }

  .surface-num {
    font-size: 13px;
    font-weight: 800;
    color: var(--color-ink-muted);
    letter-spacing: 0.08em;
    font-family: var(--font-mono);
  }

  .surface-content {
    position: relative;
    z-index: 2;
    margin-top: 20px;
    margin-bottom: 24px;
    transform: translateZ(15px);
  }

  .surface-category {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    position: relative;
    display: inline-block;
  }

  .pulse-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    opacity: 0.8;
    animation: dotPulse 2.2s infinite cubic-bezier(0.25, 0, 0, 1);
  }

  @keyframes dotPulse {
    0% {
      transform: scale(0.6);
      opacity: 0.8;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .surface-card small {
    color: var(--accent);
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    opacity: 0.95;
  }

  .surface-card h3 {
    margin: 0 0 12px;
    font-size: clamp(2.1rem, 2.7vw, 2.75rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .surface-card p {
    max-width: 480px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 14.5px;
    line-height: 1.65;
    transition: color 0.3s ease;
  }

  .surface-bottom {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
  }

  .surface-command {
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: rgba(255, 255, 255, 0.01);
    width: fit-content;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform: translateZ(15px);
  }

  .surface-command svg {
    display: block;
    width: 14px !important;
    height: 14px !important;
    min-width: 14px !important;
    max-width: 14px !important;
    flex-shrink: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .surface-card:hover {
    box-shadow: 
      inset 0 1px 0 var(--color-line-strong), 
      0 24px 60px var(--glass-shadow),
      0 0 50px -10px rgba(var(--rgb-accent), 0.12);
    background: var(--color-panel-solid);
    border-color: rgba(var(--rgb-accent), 0.25);
  }

  :global(html:global(html[data-theme="light"])) .surface-card:hover {
    box-shadow: 
      inset 0 1px 0 var(--color-line-strong), 
      0 24px 60px var(--glass-shadow),
      0 0 50px -10px rgba(var(--rgb-accent), 0.16);
    background: var(--color-panel-solid);
    border-color: rgba(var(--rgb-accent), 0.3);
  }

  .surface-card:hover::before {
    opacity: 1;
  }

  .surface-card:hover::after {
    opacity: 1;
    background: 
      radial-gradient(
        250px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(var(--rgb-accent), 0.48),
        transparent 70%
      ),
      linear-gradient(135deg, var(--color-line-strong) 0%, transparent 40%, transparent 60%, var(--color-line) 100%);
  }

  .surface-card:hover .shimmer-sweep {
    transform: translateX(100%) skewX(-15deg);
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .surface-card:hover .surface-glyph {
    transform: scale(1.12) translateY(-4px) rotate(4deg);
    opacity: 0.25;
    filter: drop-shadow(0 8px 16px rgba(var(--rgb-accent), 0.2));
  }

  :global(html:global(html[data-theme="light"])) .surface-card:hover .surface-glyph {
    opacity: 0.3;
  }

  .surface-card:hover h3 {
    transform: translateY(-2px);
  }

  .surface-card:hover p {
    color: var(--color-ink-soft);
  }

  .surface-card:hover .surface-command {
    color: var(--color-ink);
    border-color: rgba(var(--rgb-accent), 0.4);
    background: rgba(var(--rgb-accent), 0.08);
    box-shadow: 0 4px 12px rgba(var(--rgb-accent), 0.1);
  }

  .surface-card:hover .surface-command svg {
    transform: translateX(4px);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 820px) {
    .surface-grid {
      grid-template-columns: 1fr;
    }

    .section-head {
      display: grid;
      align-items: start;
    }

    .section-head h2 {
      text-align: left;
    }
  }
</style>
