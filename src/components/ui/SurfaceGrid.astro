---
const { sectionCards } = Astro.props;
---

<section id="surfaces" class="surface-index fade-in-up" aria-label="Site index">
  <div class="section-head">
    <p class="micro-label">Surfaces</p>
    <h2>Five public surfaces around one working product.</h2>
  </div>

  <div class="surface-grid">
    {sectionCards.map((item, index) => (
      <a
        class="surface-card"
        href={item.path}
        style={`--accent: ${item.meta.accent}; --animation-order: ${index};`}
      >
        <span class="shimmer-sweep"></span>
        <span class="surface-num">{item.num}</span>
        <span class="surface-glyph">{item.meta.glyph}</span>
        <div class="surface-content">
          <small>{item.meta.line}</small>
          <h3>{item.label}</h3>
          <p>{item.page?.description ?? item.layoutType}</p>
        </div>
        <span class="surface-command">
          {item.id === "a1-firms" ? "Launch product" : "Open section"} <b aria-hidden="true">→</b>
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .surface-index {
    display: grid;
    gap: 32px;
    padding-top: 104px;
    padding-bottom: 92px;
    border-top: 1px solid var(--color-line);
    width: min(100%, var(--max-site));
    margin: 0 auto;
    padding-right: var(--space-page);
    padding-left: var(--space-page);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: end;
    border-bottom: 1px solid var(--color-line-strong);
    padding-bottom: 24px;
  }

  .section-head h2 {
    max-width: 620px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: right;
  }

  .surface-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 16px;
  }

  .surface-card {
    position: relative;
    display: grid;
    align-content: space-between;
    min-height: 360px;
    padding: 36px;
    border-radius: 8px;
    overflow: hidden;
    color: var(--color-ink);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--color-line), var(--glass-shadow);
    backdrop-filter: var(--glass-blur);
    text-decoration: none;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    
    /* Scroll reveal simulation */
    animation: fadeInUp 0.6s var(--easing-smooth) both;
    animation-delay: calc(var(--animation-order) * 100ms);
  }

  .surface-card::before {
    content: '';
    position: absolute;
    top: -40px;
    right: -40px;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, var(--accent), transparent 70%);
    opacity: 0.04;
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }

  .surface-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, var(--color-line-strong) 0%, transparent 40%, transparent 60%, var(--color-line) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.5;
    transition: opacity 0.5s ease, background-image 0.5s ease;
    pointer-events: none;
  }

  .shimmer-sweep {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      115deg,
      transparent 0%,
      transparent 35%,
      var(--color-line) 45%,
      var(--color-line-strong) 50%,
      var(--color-line) 55%,
      transparent 65%,
      transparent 100%
    );
    transform: translateX(-100%) skewX(-15deg);
    transition: none;
    z-index: 2;
    pointer-events: none;
  }

  .surface-card:nth-child(1),
  .surface-card:nth-child(2) {
    grid-column: span 3;
  }

  .surface-card:nth-child(n + 3) {
    grid-column: span 2;
  }

  .surface-glyph {
    position: absolute;
    top: 36px;
    right: 36px;
    color: var(--accent);
    font-size: 56px;
    font-weight: 900;
    line-height: 1;
    opacity: 0.5;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .surface-num {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink-muted);
    letter-spacing: 0.05em;
    font-family: var(--font-mono);
  }

  .surface-content {
    position: relative;
    z-index: 1;
  }

  .surface-card small {
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    opacity: 0.9;
  }

  .surface-card h3 {
    margin: 14px 0 16px;
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .surface-card p {
    max-width: 470px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 15px;
    line-height: 1.65;
    transition: color 0.3s ease;
  }

  .surface-command {
    position: relative;
    z-index: 1;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .surface-command b {
    font-weight: 900;
    transition: transform var(--motion-fast) ease;
  }

  .surface-card:hover {
    transform: translateY(-6px);
    box-shadow: inset 0 1px 0 var(--color-line-strong), 0 24px 60px var(--glass-shadow);
    background: var(--color-panel-solid);
    border-color: var(--color-line-strong);
  }

  .surface-card:hover::before {
    opacity: 0.18;
    transform: scale(1.15);
  }

  .surface-card:hover::after {
    opacity: 1;
    background: linear-gradient(135deg, var(--accent) 0%, transparent 50%, rgba(255, 255, 255, 0.15) 100%);
  }

  .surface-card:hover .shimmer-sweep {
    transform: translateX(100%) skewX(-15deg);
    transition: transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .surface-card:hover .surface-glyph {
    transform: scale(1.1) rotate(5deg);
    opacity: 0.65;
  }

  .surface-card:hover p,
  .surface-card:hover .surface-command {
    color: var(--color-ink-soft);
  }

  .surface-card:hover .surface-command b {
    transform: translateX(4px);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 820px) {
    .surface-grid {
      grid-template-columns: 1fr;
    }

    .surface-card:nth-child(1),
    .surface-card:nth-child(2),
    .surface-card:nth-child(n + 3) {
      grid-column: auto;
    }

    .section-head {
      display: grid;
      align-items: start;
    }

    .section-head h2 {
      text-align: left;
    }
  }
</style>
