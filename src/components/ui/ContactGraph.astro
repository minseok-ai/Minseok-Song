---
const { contactNodes, visibleChannels } = Astro.props;
---

<div class="contact-module fade-in-up">
  <section class="contact-hero">
    <div class="contact-copy">
      <h1>Open to specific, serious product conversations.</h1>
      <p>
        Send a short note with context, the decision you are trying to make,
        and the artifact you want to build. Short, concrete messages get
        answered fastest.
      </p>
      <small>Response mode · Korean or English · project-first</small>
    </div>

    <div class="channel-graph-container">
      <div class="channel-graph">
        <span class="micro-label">Channel graph</span>
        <svg viewBox="0 0 100 100" aria-hidden="true" class="graph-svg">
          {contactNodes.map((node) => (
            <g class="graph-edge">
              <line class="edge-line" x1="50" y1="52" x2={node.x} y2={node.y} />
              <circle cx={node.x} cy={node.y} r="1.6" class="node-point" />
              <circle class="signal-dot" r="0.6">
                <animateMotion 
                  dur={`${1.5 + Math.random()}s`} 
                  repeatCount="indefinite" 
                  path={`M50 52 L${node.x} ${node.y}`} 
                />
              </circle>
            </g>
          ))}
          <circle class="core-ring" cx="50" cy="52" r="2.3" />
          <circle class="core-node" cx="50" cy="52" r="2.3" />
        </svg>
        <div class="graph-labels">
          {contactNodes.map((node) => {
            const Tag = node.copyable ? "button" : "a";
            return (
              <Tag
                type={node.copyable ? "button" : undefined}
                href={node.copyable ? undefined : (node.href ?? "#")}
                target={node.copyable ? undefined : "_blank"}
                rel={node.copyable ? undefined : "noopener noreferrer"}
                class="node-label-btn"
                data-copy={node.copyable ? node.value : undefined}
                style={`left: ${node.x}%; top: ${node.y}%;`}
              >
                {node.label}
                <span class="tooltip">{node.copyable ? "Click to copy" : "Click to open"}</span>
              </Tag>
            );
          })}
        </div>
        <small class="graph-hint">Click a copyable node or open the channel below.</small>
      </div>
    </div>
  </section>

  <section class="contact-ledger">
    {visibleChannels.map((channel) => (
      <a class="ledger-row" href={channel.href ?? "#"} target={channel.copyable ? undefined : "_blank"} rel={channel.copyable ? undefined : "noopener noreferrer"} data-copy={channel.copyable ? channel.value : undefined}>
        <span class="channel-label">{channel.label}</span>
        <strong class="channel-value">{channel.value}</strong>
        <small class="channel-action">{channel.copyable ? "click to copy" : "click to open"}</small>
        <b aria-hidden="true" class="arrow">→</b>
      </a>
    ))}
  </section>
</div>

<script>
  const graphContainer = document.querySelector('.channel-graph-container');
  const graph = document.querySelector('.channel-graph');
  
  if (graphContainer && graph) {
    graphContainer.addEventListener('mousemove', (e) => {
      const rect = graphContainer.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      
      const rotateX = (y / rect.height) * -8;
      const rotateY = (x / rect.width) * 8;
      
      graph.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
      graph.style.transition = 'none';
    });

    graphContainer.addEventListener('mouseleave', () => {
      graph.style.transform = 'rotateX(0) rotateY(0)';
      graph.style.transition = 'transform var(--motion-slow) var(--easing-smooth), box-shadow var(--motion-slow) var(--easing-smooth)';
    });
  }

  const labels = document.querySelectorAll('.node-label-btn');
  const edges = document.querySelectorAll('.graph-edge');
  
  labels.forEach((label, i) => {
    label.addEventListener('mouseenter', () => {
      if (edges[i]) edges[i].classList.add('is-active');
    });
    label.addEventListener('mouseleave', () => {
      if (edges[i]) edges[i].classList.remove('is-active');
    });
  });
</script>

<style>
  .contact-module {
    display: grid;
    gap: 72px;
  }

  .contact-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px;
    align-items: center;
  }

  .contact-copy h1 {
    margin: 0;
    max-width: 640px;
    font-size: clamp(2.35rem, 3.35vw, 3.3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .contact-copy p {
    margin: 24px 0 32px;
    max-width: 640px;
    color: var(--color-ink-soft);
    font-size: 18px;
    line-height: 1.65;
  }

  .contact-copy small {
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .channel-graph-container {
    perspective: 1000px;
  }

  .channel-graph {
    position: relative;
    min-height: 560px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 28px;
    overflow: hidden;
    background: var(--color-panel);
    transition: transform var(--motion-slow) var(--easing-smooth), box-shadow var(--motion-slow) var(--easing-smooth);
    box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.5);
  }

  .channel-graph:hover {
    transform: rotateX(2deg) rotateY(-2deg);
    box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.5), 0 24px 48px rgba(0, 0, 0, 0.3);
    border-color: var(--color-line-strong);
  }

  .channel-graph::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(107, 156, 242, 0.1), transparent 70%);
    pointer-events: none;
  }

  .micro-label {
    position: relative;
    z-index: 2;
    color: var(--color-ink-muted);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .graph-svg {
    position: absolute;
    inset: 80px 36px 72px;
    width: calc(100% - 72px);
    height: calc(100% - 152px);
    overflow: visible;
    pointer-events: none;
  }

  .graph-edge line {
    stroke: var(--color-line-strong);
    stroke-width: 0.3;
    transition: stroke var(--motion-fast) ease;
  }

  .graph-edge:hover line,
  .graph-edge.is-active line {
    stroke: var(--color-accent);
  }

  .node-point {
    fill: var(--color-paper);
    stroke: var(--color-ink);
    stroke-width: 0.5;
    transition: all var(--motion-fast) ease;
    transform-origin: center;
  }

  .graph-edge:hover .node-point,
  .graph-edge.is-active .node-point {
    fill: var(--color-accent);
    stroke: var(--color-accent);
    transform: scale(1.5);
    filter: drop-shadow(0 0 8px var(--color-accent));
  }

  .core-node {
    fill: var(--color-ink);
    filter: drop-shadow(0 0 12px rgba(242, 245, 249, 0.5));
  }

  .core-ring {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 0.5;
    transform-origin: 50px 52px;
    animation: corePulse 3s infinite ease-out;
  }

  @keyframes corePulse {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(4); opacity: 0; }
  }

  .signal-dot {
    fill: var(--color-accent);
    filter: drop-shadow(0 0 4px var(--color-accent));
    opacity: 0.7;
  }

  .graph-labels {
    position: absolute;
    inset: 80px 36px 72px;
    pointer-events: none;
  }

  .node-label-btn {
    position: absolute;
    border: 0;
    background: transparent;
    color: var(--color-ink-soft);
    font-size: 13px;
    font-weight: 700;
    transform: translate(-50%, -150%);
    transform-origin: bottom center;
    cursor: pointer;
    pointer-events: auto;
    text-decoration: none;
    padding-bottom: 24px;
    margin-bottom: -24px;
    transition: color var(--motion-fast) ease, transform var(--motion-fast) var(--easing-spring);
  }

  .node-label-btn:hover {
    color: var(--color-ink);
    transform: translate(-50%, -150%) scale(1.15);
  }

  .tooltip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: var(--color-ink);
    color: var(--color-paper-deep);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 800;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: all var(--motion-fast) var(--easing-spring);
  }

  .node-label-btn:hover .tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(-5px);
  }

  .node-label-btn[data-copied="true"]::after,
  .ledger-row[data-copied="true"]::after {
    content: "Copied";
    margin-left: 8px;
    color: var(--color-green);
    font-size: 11px;
    font-weight: 800;
  }

  .graph-hint {
    position: absolute;
    bottom: 28px;
    left: 28px;
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-ledger {
    border-top: 1px solid var(--color-line);
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) 140px 24px;
    gap: 24px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    color: var(--color-ink);
    transition: background var(--motion-fast) ease, padding-left var(--motion-fast) ease;
  }

  .ledger-row:hover {
    background: rgba(255, 255, 255, 0.02);
    padding-left: 16px;
  }

  .channel-label {
    color: var(--color-ink-muted);
    font-size: 13px;
    font-weight: 700;
  }

  .channel-value {
    font-size: 1.4rem;
    font-weight: 600;
    overflow-wrap: anywhere;
    transition: color var(--motion-fast) ease;
  }

  .ledger-row:hover .channel-value {
    color: var(--color-accent);
  }

  .channel-action {
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    transition: color var(--motion-fast) ease;
  }

  .ledger-row:hover .channel-action {
    color: var(--color-ink);
  }

  .arrow {
    color: var(--color-ink-muted);
    transition: transform var(--motion-fast) var(--easing-spring), color var(--motion-fast) ease;
  }

  .ledger-row:hover .arrow {
    transform: translateX(6px);
    color: var(--color-accent);
  }

  .fade-in-up {
    animation: fadeInUp 0.8s var(--easing-smooth) both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1180px) {
    .contact-hero {
      grid-template-columns: 1fr;
    }
    .ledger-row {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 24px 16px;
    }
    .channel-action, .arrow {
      display: none;
    }
  }
</style>
