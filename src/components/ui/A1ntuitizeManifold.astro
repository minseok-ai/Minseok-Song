    font-size: 9px;
    font-weight: 750;
    color: var(--color-ink-muted);
    font-family: var(--font-mono, monospace);
  }

  .osb-name {
    font-size: 11px;
    font-weight: 800;
    line-height: 1.25;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .osb-mass-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
  }

  .osb-mass-track {
    flex-grow: 1;
    height: 3.5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }

  [data-theme="light"] .osb-mass-track {
    background: rgba(0, 0, 0, 0.08);
  }

  .osb-mass-fill {
    height: 100%;
    border-radius: 999px;
    transition: width 0.15s ease-out;
  }

  .osb-mass-num {
    font-size: 8.5px;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    color: var(--color-ink-muted);
    min-width: 22px;
    text-align: right;
  }

  /* Dynamic Active Readout Command Strip */
  .colormap-readout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 16px;
    border-radius: 10px;
    background: rgba(10, 18, 32, 0.65);
    border: 1px solid rgba(56, 189, 248, 0.25);
    font-family: var(--font-mono, monospace);
  }

  [data-theme="light"] .colormap-readout {
    background: rgba(241, 245, 249, 0.9);
    border-color: rgba(6, 182, 212, 0.3);
  }

  .cm-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .cm-angle-badge {
    font-size: 11px;
    font-weight: 900;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.14);
    padding: 3px 9px;
    border-radius: 6px;
    border: 1px solid rgba(56, 189, 248, 0.35);
  }

  .cm-coords {
    font-size: 10.5px;
    font-weight: 800;
    color: var(--color-ink-muted);
  }

  .cm-center {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex-grow: 1;
    overflow: hidden;
  }

  .cm-active-name {
    font-size: 13px;
    font-weight: 850;
    color: var(--color-ink);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .cm-sub-emotions {
    font-size: 11px;
    color: var(--color-ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cm-right {
    flex-shrink: 0;
  }

  .active-inject-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 8px;
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid rgba(56, 189, 248, 0.45);
    color: #38bdf8;
    font-size: 11px;
    font-weight: 850;
    font-family: var(--font-mono, monospace);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .active-inject-btn:hover,
  .active-inject-btn.is-pulsing {
    background: rgba(56, 189, 248, 0.3);
    border-color: #38bdf8;
    color: #ffffff;
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.45);
    transform: translateY(-1px);
  }

  /* HUD Bottom Footer */
  .manifold-3d-hud-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 20px;
    border-top: 1px solid var(--color-line);
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(14px);
    z-index: 2;
    min-width: 0;
    gap: 16px;
    flex-wrap: wrap;
  }

  [data-theme="light"] .manifold-3d-hud-bottom {
    background: rgba(255, 255, 255, 0.7);
  }

  .hud-status-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.22);
  }

  [data-theme="light"] .hud-status-chip {
    background: rgba(6, 182, 212, 0.08);
    border-color: rgba(6, 182, 212, 0.25);
  }

  .hud-cue-text {
    font-size: 10px;
    font-weight: 800;
    color: var(--color-ink-muted);
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hud-cue-text strong {
    color: #38bdf8;
  }

  [data-theme="light"] .hud-cue-text strong {
    color: #0284c7;
  }

  .hud-telemetry {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tele-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  [data-theme="light"] .tele-item {
    background: rgba(0, 0, 0, 0.03);
    border-color: rgba(0, 0, 0, 0.08);
  }

  .ti-label {
    font-size: 9px;
    font-weight: 800;
    color: var(--color-ink-muted);
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.04em;
  }

  .ti-val {
    font-size: 10.5px;
    font-weight: 850;
    color: #38bdf8;
    font-family: var(--font-mono, monospace);
  }

  [data-theme="light"] .ti-val {
    color: #0284c7;
  }

  .sealed-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    min-width: 0;
    max-width: 100%;
  }

  .sealed-feature-box {
    display: flex;
    flex-direction: column;
    padding: 26px;
    border-radius: 14px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    word-break: break-word;
  }

  .sealed-feature-box:hover {
    transform: translateY(-2px);
    border-color: var(--color-line-strong);
    background: var(--color-panel-solid);
  }

  .feature-idx {
    font-size: 11px;
    font-weight: 900;
    color: #f59e0b;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.08em;
    margin-bottom: 12px;
  }

  [data-theme="light"] .feature-idx {
    color: #b45309;
  }

  .sealed-feature-box h3 {
    margin: 0 0 10px;
    font-size: 16.5px;
    font-weight: 700;
    line-height: 1.4;
    word-break: break-word;
  }

  .sealed-feature-box p {
    color: var(--color-ink-muted);
    font-size: 13.5px;
    line-height: 1.6;
    margin: 0 0 18px;
    flex-grow: 1;
    word-break: break-word;
  }

  .feature-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .feature-tags span {
    padding: 4px 8px;
    border-radius: 6px;
    background: var(--color-paper);
    border: 1px solid var(--color-line);
    color: var(--color-ink-muted);
    font-size: 10.5px;
    font-weight: 700;
  }

  /* MATHEMATICAL FORMULA REFERENCE SECTION */
  .math-reference-section {
    display: grid;
    gap: 24px;
    margin-top: 14px;
    padding-top: 28px;
    border-top: 1px solid var(--color-line);
    min-width: 0;
    max-width: 100%;
  }

  .math-ref-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .math-kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    font-size: 11.5px;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #f59e0b;
    word-break: break-word;
  }

  [data-theme="light"] .math-kicker {
    color: #b45309;
  }

  .math-kicker i {
    display: block;
    width: 24px;
    height: 1px;
    background: var(--color-line-strong);
    flex-shrink: 0;
  }

  .math-kicker strong {
    color: var(--color-ink);
  }

  .math-ref-header p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 14.5px;
    line-height: 1.6;
    max-width: 860px;
    word-break: break-word;
  }

  .math-formula-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    min-width: 0;
    max-width: 100%;
  }

  .math-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    border-radius: 14px;
    background: rgba(8, 12, 22, 0.65);
    border: 1px solid rgba(56, 189, 248, 0.18);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  [data-theme="light"] .math-card {
    background: rgba(248, 250, 252, 0.85);
    border-color: rgba(6, 182, 212, 0.22);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .math-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow: 0 12px 32px rgba(6, 182, 212, 0.12);
  }

  .math-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-bottom: 14px;
    min-width: 0;
  }

  .math-tag {
    font-size: 10px;
    font-weight: 900;
    font-family: var(--font-mono, monospace);
    color: #38bdf8;
    letter-spacing: 0.06em;
  }

  [data-theme="light"] .math-tag {
    color: #0284c7;
  }

  .formula-katex-block {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px 14px;
    border-radius: 12px;
    background: rgba(4, 7, 14, 0.9);
    border: 1px solid rgba(56, 189, 248, 0.22);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 8px 24px rgba(0, 0, 0, 0.35);
    margin-bottom: 14px;
    overflow-x: auto;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    scrollbar-width: none;
    -ms-overflow-style: none;
    color: #f8fafc;
  }

  .formula-katex-block::-webkit-scrollbar {
    display: none;
  }

  [data-theme="light"] .formula-katex-block {
    background: #ffffff;
    border-color: rgba(6, 182, 212, 0.28);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 4px 16px rgba(0, 0, 0, 0.05);
    color: #0f172a;
  }

  .formula-katex-block :global(.katex-display) {
    margin: 0 auto !important;
    text-align: center !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    width: 100% !important;
    max-width: 100%;
    overflow: visible;
  }

  .formula-katex-block :global(.katex) {
    font-size: clamp(0.72rem, 2.4vw, 0.94rem);
    line-height: 1.6;
    text-align: center !important;
    margin: 0 auto !important;
    display: inline-block !important;
  }

  .formula-katex-block :global(.katex-html) {
    text-align: center !important;
    margin: 0 auto !important;
  }

  .formula-katex-block :global(.katex .frac-line) {
    border-bottom-width: 1.5px;
  }

  .math-desc {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 13px;
    line-height: 1.6;
  }

  .copy-latex-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 9px;
    border-radius: 6px;
    border: 1px solid var(--color-line);
    background: var(--glass-bg);
    color: var(--color-ink-muted);
    font-size: 10.5px;
    font-weight: 800;
    font-family: var(--font-mono, monospace);
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .copy-latex-btn:hover {
    border-color: rgba(56, 189, 248, 0.45);
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    transform: translateY(-1px);
  }

  .copy-latex-btn.is-copied {
    border-color: rgba(16, 185, 129, 0.5);
    background: rgba(16, 185, 129, 0.15);
  }

  .math-param-details {
    margin-top: 14px;
    border-top: 1px dashed var(--color-line);
    padding-top: 10px;
  }

  .math-param-details summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 10.5px;
    font-weight: 850;
    color: var(--color-ink-muted);
    font-family: var(--font-mono, monospace);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    user-select: none;
    list-style: none;
    transition: color 0.2s ease;
  }

  .math-param-details summary::-webkit-details-marker {
    display: none;
  }

  .math-param-details summary:hover {
    color: #38bdf8;
  }

  [data-theme="light"] .math-param-details summary:hover {
    color: #0284c7;
  }

  .mp-chevron {
    font-size: 10px;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .math-param-details[open] .mp-chevron {
    transform: rotate(180deg);
  }

  .mp-content {
    display: grid;
    gap: 7px;
    margin-top: 10px;
    padding: 10px 12px;
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--color-line);
  }

  [data-theme="light"] .mp-content {
    background: rgba(0, 0, 0, 0.03);
  }

  .mp-row {
    display: grid;
    grid-template-columns: 95px 1fr;
    gap: 8px;
    align-items: baseline;
    font-size: 11.5px;
    line-height: 1.45;
  }

  .mp-row code {
    font-size: 10px;
    font-weight: 850;
    color: #38bdf8;
    background: rgba(56, 189, 248, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono, monospace);
    width: fit-content;
  }

  [data-theme="light"] .mp-row code {
    color: #0284c7;
    background: rgba(6, 182, 212, 0.1);
  }

  .mp-row span {
    color: var(--color-ink-muted);
  }

  /* 3D Camera Controls & Interactive Pulses */
  .manifold-camera-controls {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 6px;
    border-radius: 999px;
    background: rgba(10, 20, 35, 0.7);
    border: 1px solid rgba(56, 189, 248, 0.25);
    backdrop-filter: blur(10px);
  }

  [data-theme="light"] .manifold-camera-controls {
    background: rgba(255, 255, 255, 0.85);
    border-color: rgba(6, 182, 212, 0.3);
  }

  .cam-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 9px;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-ink-muted);
    font-size: 10px;
    font-weight: 750;
    font-family: var(--font-mono, monospace);
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cam-btn:hover {
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.08);
  }

  [data-theme="light"] .cam-btn:hover {
    background: rgba(0, 0, 0, 0.05);
  }

  .cam-btn.is-active {
    background: rgba(56, 189, 248, 0.15);
    border-color: rgba(56, 189, 248, 0.4);
    color: #38bdf8;
    font-weight: 850;
    box-shadow: 0 0 10px rgba(56, 189, 248, 0.2);
  }

  [data-theme="light"] .cam-btn.is-active {
    background: rgba(6, 182, 212, 0.15);
    border-color: rgba(6, 182, 212, 0.4);
    color: #0284c7;
  }

  .pulse-fire-btn {
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.35);
    color: #f59e0b;
  }

  .pulse-fire-btn:hover,
  .pulse-fire-btn.is-firing {
    background: rgba(245, 158, 11, 0.25);
    border-color: #f59e0b;
    color: #fbbf24;
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.4);
    transform: scale(1.04);
  }

  /* ── RESPONSIVE: TABLET (≤1024px) ── */
  @media (max-width: 1024px) {
    .sealed-header {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .sealed-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .math-formula-grid {
      grid-template-columns: 1fr;
    }
    .octant-segmented-ribbon {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .colormap-readout {
      flex-wrap: wrap;
    }
    .manifold-canvas-box {
      height: 420px;
    }
  }

  /* ── RESPONSIVE: MOBILE (≤768px) ── */
  @media (max-width: 768px) {
    /* Page container */
    .sealed-card-container {
      padding: 22px 16px 20px;
      gap: 24px;
    }

    /* Header: single column */
    .sealed-header {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    /* Specs widget */
    .specs-widget-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    /* Feature grid: single column */
    .sealed-grid {
      grid-template-columns: 1fr;
    }

    /* 3D Canvas: smaller height on mobile */
    .manifold-canvas-box {
      height: 340px;
    }

    /* HUD top: stack vertically */
    .manifold-3d-hud-top {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
    }

    /* Camera controls: wrap */
    .manifold-camera-controls {
      flex-wrap: wrap;
      gap: 4px;
    }

    /* Hide nav badge to free up canvas space */
    .manifold-nav-guide-overlay {
      display: none;
    }

    /* AI HUD: hide desktop absolute overlay, show mobile row below canvas */
    .ai-hud-desktop {
      display: none;
    }

    .ai-hud-mobile-row {
      display: block;
      padding: 0 14px 8px;
    }

    .ai-avatar-card {
      width: 100%;
      box-sizing: border-box;
      border-radius: 10px;
    }

    /* Manifold canvas itself */
    .manifold-canvas-box {
      height: 300px;
      min-height: 260px;
    }

    /* Spectrum bar */
    .manifold-spectrum-bar {
      padding: 14px 14px;
      gap: 12px;
    }

    /* PAD Faders: single column */
    .pad-telemetry-faders {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    /* Octant ribbon: 2 columns on mobile */
    .octant-segmented-ribbon {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
    }

    /* HUD bottom: stack */
    .manifold-3d-hud-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 10px 14px;
    }

    .hud-telemetry {
      flex-wrap: wrap;
      gap: 6px;
    }

    /* Colormap readout: vertical */
    .colormap-readout {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 10px 12px;
    }

    .cm-center {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      width: 100%;
    }

    .cm-right {
      width: 100%;
    }

    .active-inject-btn {
      width: 100%;
      justify-content: center;
    }

    .cm-sub-emotions {
      white-space: normal;
    }

    /* Math formula grid: single column */
    .math-formula-grid {
      grid-template-columns: 1fr;
    }

    /* Math card formula block: allow scroll */
    .formula-katex-block {
      padding: 14px 10px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .formula-katex-block :global(.katex) {
      font-size: clamp(0.65rem, 2.8vw, 0.82rem);
    }

    .formula-katex-block :global(.katex-display) {
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 4px;
    }
  }

  /* ── RESPONSIVE: SMALL MOBILE (≤480px) ── */
  @media (max-width: 480px) {
    .sealed-card-container {
      padding: 16px 12px;
      border-radius: 14px;
    }

    .sealed-title-wrap h2 {
      font-size: clamp(18px, 5vw, 24px);
    }

    .manifold-canvas-box {
      height: 260px;
      min-height: 220px;
    }

    /* Octant ribbon: 2 columns compact */
    .octant-segmented-ribbon {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 5px;
    }

    .oct-seg-btn {
      padding: 8px 8px 6px;
    }

    .osb-name {
      font-size: 10px;
    }

    .osb-code {
      display: none;
    }

    /* Spectrum bar */
    .spectrum-bar-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .origin-decay-badge {
      width: 100%;
      justify-content: center;
    }

    /* AI face meta: hide description on very small */
    .ai-face-desc {
      display: none;
    }

