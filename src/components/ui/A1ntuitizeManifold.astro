---
import { eq1Html, eq2Html, eq3Html, eq4Html } from "../../utils/mathFormulas";
import "katex/dist/katex.min.css";
---

<!-- SECTION 02: A1NTUITIZE (SEALED R&D INITIATIVE) -->
<section id="a1ntuitize-sealed" class="a1ntuitize-sealed-section" aria-label="A1ntuitize R&D Initiative">
  <div class="sealed-banner-head">
    <div class="product-kicker">
      <span class="kicker-pill">02 / Emerging Initiative</span>
      <strong class="kicker-title">A1ntuitize Vision Memory Engine</strong>
    </div>
  </div>

  <div class="sealed-card-container">
    <div class="sealed-header">
      <div class="sealed-title-wrap">
        <span class="micro-label">Cognitive Architecture Research · Topological Affect Engine</span>
        <h2>3D PAD Topological Memory Accretion & Core Affect Synthesis Engine</h2>
        <p>
          An experimental intuition memory engine implementing psychological <strong>3D PAD (Pleasure-Arousal-Dominance) Emotional Space</strong> across 8 spatial octants. 
          Visual scenes are embedded into continuous PAD tensors via <strong>Qwen 3.5 Vision</strong>. 
          Sensory particles fire inward from these octants toward origin (0,0,0), undergoing <strong>inelastic collisions</strong> to stack physical memory mass ($M_k$) as discrete crystalline atoms into the central topological polyhedral accretion core. 
          The real-time <strong>Projected Weighted Sum (Spherical Centroid P<sub>centroid</sub>)</strong> synthesizes blended emotions on S² to drive reactive AI facial expressions, while unreinforced sectors implode toward the origin via Ebbinghaus entropy half-life decay.
        </p>
      </div>

      <div class="sealed-specs-widget" aria-label="A1ntuitize Architecture Specifications">
        <div class="specs-widget-header">
          <span class="spec-kicker">SYSTEM ARCHITECTURE</span>
          <span class="spec-state"><span class="pulse-amber"></span> SEALED R&D SPEC</span>
        </div>
        <div class="specs-widget-grid">
          <div class="spec-entry">
            <span class="se-label">Vision Model</span>
            <strong class="se-val">Qwen 3.5 Vision (Quantized)</strong>
          </div>
          <div class="spec-entry">
            <span class="se-label">Local Runtime</span>
            <strong class="se-val">LM Studio Inference Engine</strong>
          </div>
          <div class="spec-entry">
            <span class="se-label">Coordinate Field</span>
            <strong class="se-val">8-Octant 3D PAD Space</strong>
          </div>
          <div class="spec-entry">
            <span class="se-label">Entropy Pruning</span>
            <strong class="se-val">Ebbinghaus Half-Life (k = 0.16)</strong>
          </div>
          <div class="spec-entry">
            <span class="se-label">Manifold Geometry</span>
            <strong class="se-val">Inelastic Polyhedral Accretion Topology</strong>
          </div>
          <div class="spec-entry">
            <span class="se-label">Affect Synthesis</span>
            <strong class="se-val">Projected Spherical Centroid (S²)</strong>
          </div>
        </div>
        <div class="specs-widget-note">
          <div class="swn-row">
            <span class="swn-label">Architecture Pipeline:</span>
            <span class="swn-val">Continuous Vision Tensor &rarr; Inelastic Voxel Collision &rarr; Zero-Crumb Accretion</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3D TOPOLOGICAL MANIFOLD VIEWPORT -->
    <div class="manifold-3d-wrapper">
      <div class="manifold-3d-hud-top">
        <div class="hud-item hud-left">
          <span class="hud-label">8-OCTANT PAD CELESTIAL TOPOLOGY</span>
          <strong class="hud-val">POLYHEDRAL ACCRETION MANIFOLD & CENTROID</strong>
        </div>

        <div class="manifold-camera-controls" role="toolbar" aria-label="3D Camera Presets">
          <button class="cam-btn is-active" data-view="orbit" title="Interactive Orbit Mode">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            <span>Orbit</span>
          </button>
          <button class="cam-btn" data-view="top" title="Top-Down (+Y Arousal) Pole">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
            <span>Top</span>
          </button>
          <button class="cam-btn" data-view="front" title="Frontal (+Z Dominance) View">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
            <span>Front</span>
          </button>
          <button class="cam-btn" data-view="side" title="Lateral (+X Pleasure) View">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span>Side</span>
          </button>
        </div>
      </div>

      <div class="manifold-canvas-box" id="manifold-box">
        <canvas id="manifold-canvas" width="900" height="520" class="manifold-canvas"></canvas>
        <div class="manifold-callouts" id="manifold-callouts" aria-hidden="true"></div>

        <!-- TACTICAL NAVIGATION BADGE (BOTTOM-LEFT OF 3D CANVAS) -->
        <div class="manifold-nav-guide-overlay">
          <span class="mng-badge">3D NAV</span>
          <span class="mng-text">Drag to Orbit · Scroll to Zoom</span>
        </div>

        <!-- TACTICAL FLOATING HOLOGRAM AI FACE: desktop absolute overlay -->
        <div class="ai-expression-hud-overlay ai-hud-desktop" id="ai-expression-hud" aria-label="AI Personality Centroid">
          <div class="ai-avatar-card">
            <div class="ai-face-hologram" id="ai-face-holo" aria-label="AI Reactive Facial Expression Hologram">
              <canvas id="ai-face-canvas" width="104" height="76" class="ai-face-canvas"></canvas>
            </div>
            <div class="ai-face-meta">
              <div class="ai-meta-top">
                <span class="hud-label">AI PERSONALITY CENTROID</span>
                <span class="ai-spike-badge" id="ai-spike-badge">CORE AFFECT · O1 (+, +, +)</span>
              </div>
              <strong class="hud-val" id="hud-active-lobe">
                <span class="pulse-dot"></span> <span class="lobe-name">JOY & EUPHORIA</span>
              </strong>
              <span class="ai-face-desc" id="ai-face-desc">Positive, high-energy & proactive situation mastery</span>
            </div>
          </div>
        </div>
      </div>

      <!-- MOBILE AI HUD ROW: shown below canvas on small screens -->
      <div class="ai-hud-mobile-row">
        <div class="ai-avatar-card">
          <div class="ai-face-hologram ai-face-holo-mirror" aria-label="AI Reactive Facial Expression Hologram (mobile)">
            <canvas id="ai-face-canvas-mobile" width="104" height="76" class="ai-face-canvas"></canvas>
          </div>
          <div class="ai-face-meta">
            <div class="ai-meta-top">
              <span class="hud-label">AI PERSONALITY CENTROID</span>
              <span class="ai-spike-badge" id="ai-spike-badge-mobile">CORE AFFECT · O1 (+, +, +)</span>
            </div>
            <strong class="hud-val" id="hud-active-lobe-mobile">
              <span class="pulse-dot"></span> <span class="lobe-name">JOY & EUPHORIA</span>
            </strong>
            <span class="ai-face-desc" id="ai-face-desc-mobile">Positive, high-energy & proactive situation mastery</span>
          </div>
        </div>
      </div>

      <!-- Minimalist Precision 8-Octant PAD Synthesizer Console -->
      <div class="manifold-synthesizer-deck" id="manifold-spectrum" aria-label="8-Octant PAD Synthesizer Console">
        <!-- Deck Header: Title & Refined Inline Telemetry -->
        <div class="deck-top-row">
          <div class="deck-title-group">
            <span class="deck-kicker">02 · AFFECT TOPOLOGY SYNTHESIZER</span>
            <div class="deck-active-lobe" id="deck-active-indicator">
              <span class="deck-pulse-gold"></span>
              <strong class="deck-lobe-label" id="cm-active-name">Joy & Euphoria</strong>
              <span class="deck-octant-tag" id="cm-angle-badge">O1 (+,+,+)</span>
            </div>
          </div>

          <!-- Refined Inline 3-Axis Telemetry (Champagne Gold & Platinum) -->
          <div class="deck-meters-inline">
            <div class="meter-inline-item">
              <span class="mii-label">VALENCE</span>
              <strong class="mii-val" id="pad-val-text">+0.89</strong>
              <div class="mii-bar"><div class="mii-fill" id="pad-val-gauge" style="width: 79%;"></div></div>
            </div>
            <div class="meter-inline-item">
              <span class="mii-label">AROUSAL</span>
              <strong class="mii-val" id="pad-aro-text">+0.42</strong>
              <div class="mii-bar"><div class="mii-fill" id="pad-aro-gauge" style="width: 71%;"></div></div>
            </div>
            <div class="meter-inline-item">
              <span class="mii-label">DOMINANCE</span>
              <strong class="mii-val" id="pad-dom-text">+0.18</strong>
              <div class="mii-bar"><div class="mii-fill" id="pad-dom-gauge" style="width: 59%;"></div></div>
            </div>
          </div>
        </div>

        <!-- Sleek 8-Sector Precision Segment Ribbon (No Rainbow, High-End Pill Tabs) -->
        <div class="deck-octant-ribbon" role="tablist" aria-label="Affect Sector Selector">
          <button class="oct-seg-btn is-active" data-octant="1" role="tab" aria-selected="true" title="Sector 01 · (+,+,+) · Joy & Euphoria">
            <span class="osb-index">01</span>
            <span class="osb-title">Joy</span>
            <span class="osb-mass-num" id="mass-val-1">58%</span>
            <span class="osb-mass-bar-hidden" id="mass-bar-1" style="display:none;"></span>
          </button>
          <button class="oct-seg-btn" data-octant="2" role="tab" aria-selected="false" title="Sector 02 · (+,+,-) · Admiration & Trust">
            <span class="osb-index">02</span>
            <span class="osb-title">Admiration</span>
            <span class="osb-mass-num" id="mass-val-2">35%</span>
            <span class="osb-mass-bar-hidden" id="mass-bar-2" style="display:none;"></span>
          </button>
          <button class="oct-seg-btn" data-octant="3" role="tab" aria-selected="false" title="Sector 03 · (+,-,+) · Serenity & Calm">
            <span class="osb-index">03</span>
            <span class="osb-title">Serenity</span>
            <span class="osb-mass-num" id="mass-val-3">28%</span>
            <span class="osb-mass-bar-hidden" id="mass-bar-3" style="display:none;"></span>
          </button>
          <button class="oct-seg-btn" data-octant="4" role="tab" aria-selected="false" title="Sector 04 · (+,-,-) · Catharsis & Relief">
            <span class="osb-index">04</span>
            <span class="osb-title">Relief</span>
            <span class="osb-mass-num" id="mass-val-4">25%</span>
            <span class="osb-mass-bar-hidden" id="mass-bar-4" style="display:none;"></span>
          </button>
          <button class="oct-seg-btn" data-octant="5" role="tab" aria-selected="false" title="Sector 05 · (-,+,+) · Anger & Shock">
            <span class="osb-index">05</span>
            <span class="osb-title">Anger</span>
            <span class="osb-mass-num" id="mass-val-5">21%</span>
            <span class="osb-mass-bar-hidden" id="mass-bar-5" style="display:none;"></span>
          </button>
          <button class="oct-seg-btn" data-octant="6" role="tab" aria-selected="false" title="Sector 06 · (-,+,-) · Fear & Tension">
            <span class="osb-index">06</span>
            <span class="osb-title">Fear</span>
            <span class="osb-mass-num" id="mass-val-6">19%</span>
            <span class="osb-mass-bar-hidden" id="mass-bar-6" style="display:none;"></span>
          </button>
          <button class="oct-seg-btn" data-octant="7" role="tab" aria-selected="false" title="Sector 07 · (-,-,+) · Disgust & Contempt">
            <span class="osb-index">07</span>
            <span class="osb-title">Contempt</span>
            <span class="osb-mass-num" id="mass-val-7">15%</span>
            <span class="osb-mass-bar-hidden" id="mass-bar-7" style="display:none;"></span>
          </button>
          <button class="oct-seg-btn" data-octant="8" role="tab" aria-selected="false" title="Sector 08 · (-,-,-) · Sadness & Despair">
            <span class="osb-index">08</span>
            <span class="osb-title">Sadness</span>
            <span class="osb-mass-num" id="mass-val-8">14%</span>
            <span class="osb-mass-bar-hidden" id="mass-bar-8" style="display:none;"></span>
          </button>
        </div>

        <!-- Quiet Editorial Telemetry Strip -->
        <div class="deck-bottom-strip">
          <div class="dbs-left">
            <span class="dbs-dot"></span>
            <span class="dbs-text">PAD Projection: S² Centroid · Inelastic Polyhedral Accretion</span>
            <span class="dbs-coords" id="cm-coords">[P:+1.0 A:+1.0 D:+1.0]</span>
          </div>
          <div class="dbs-right">
            <span class="dbs-entropy" id="entropy-rate-badge">Temporal Entropy Rate <em>k = 0.16 day⁻¹</em></span>
            <span id="cm-sub-emotions" style="display:none;"></span>
            <span id="cm-resonance-val" style="display:none;"></span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3 CORE SYSTEM SPECIFICATIONS -->
    <div class="sealed-grid">
      <article class="sealed-feature-box">
        <span class="feature-idx">SPEC 01</span>
        <h3>Trajectory & Spike Bias Field</h3>
        <p>Sensory projectiles launched from the boundary sphere curve toward dominant memory clusters via a dynamic top-4 gravitational spike bias vector field.</p>
        <div class="feature-tags">
          <span>Spike Bias Field</span>
          <span>Inward Vector</span>
          <span>Quadrant Gating</span>
        </div>
      </article>

      <article class="sealed-feature-box">
        <span class="feature-idx">SPEC 02</span>
        <h3>Discrete 3D Voxel Grid Accretion</h3>
        <p>Upon physical collision or core contact, projectiles anchor into discrete 3D spatial voxel cells, accumulating spike height, base support, and memory mass.</p>
        <div class="feature-tags">
          <span>Voxel Accretion</span>
          <span>Support Gain</span>
          <span>Crystalline Spikes</span>
        </div>
      </article>

      <article class="sealed-feature-box">
        <span class="feature-idx">SPEC 03</span>
        <h3>Center of Mass Drift & Dual Decay</h3>
        <p>Tracks global 3D center of mass drift and cognitive stability, while unreinforced spikes undergo dual-factor decay with support floor collapse toward (0,0,0).</p>
        <div class="feature-tags">
          <span>Center of Mass</span>
          <span>Stability Metric</span>
          <span>Floor Collapse</span>
        </div>
      </article>
    </div>

    <!-- MATHEMATICAL FORMULA REFERENCE MATRIX -->
    <div class="math-reference-section" aria-label="Mathematical Reference Formulas for A1ntuitize">
      <div class="math-ref-header">
        <div class="math-kicker">
          <span class="kicker-pill kicker-pill-amber">Mathematical Architecture</span>
          <strong class="kicker-title">Topological Personality Field Theoretical Formulations</strong>
        </div>
        <p>Formal mathematical formulations governing the trajectory spike bias field, discrete 3D voxel grid accretion, center-of-mass field drift, and dual-factor structural decay with support floor collapse.</p>
      </div>

      <div class="math-formula-grid">
        <!-- Equation 01 -->
        <div class="math-card">
          <div class="math-card-top">
            <span class="math-tag">EQ. 01 · TRAJECTORY VECTOR & SPIKE BIAS FIELD</span>
            <button class="copy-latex-btn" data-eq="1" title="Copy LaTeX formula">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy TeX</span>
            </button>
          </div>
          <div class="formula-katex-block" set:html={eq1Html}></div>
          <p class="math-desc">Inward sensory projectiles launched from sphere radius R<sub>field</sub> curve toward dominant memory clusters via the top-4 weighted spike bias vector field.</p>
          <details class="math-param-details">
            <summary>
              <span class="mp-toggle-label">Trajectory Vector Field Parameters</span>
              <span class="mp-chevron">▾</span>
            </summary>
            <div class="mp-content">
              <div class="mp-row"><code>v_step</code><span>Stepping unit vector combining radial inward impulse and gravitational spike bias.</span></div>
              <div class="mp-row"><code>B_spike(S)</code><span>Gravitational bias synthesized across the top-4 highest/most-supported personality spikes.</span></div>
              <div class="mp-row"><code>w_in, w_bias</code><span>Configurable blending weights balancing inward drive against memory cluster attraction.</span></div>
            </div>
          </details>
        </div>

        <!-- Equation 02 -->
        <div class="math-card">
          <div class="math-card-top">
            <span class="math-tag">EQ. 02 · DISCRETE VOXEL GRID ACCRETION</span>
            <button class="copy-latex-btn" data-eq="2" title="Copy LaTeX formula">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy TeX</span>
            </button>
          </div>
          <div class="formula-katex-block" set:html={eq2Html}></div>
          <p class="math-desc">Upon collision contact or orthogonal gating, projectiles anchor into discrete 3D voxel coordinates (b<sub>x</sub>, b<sub>y</sub>, b<sub>z</sub>) to increment spike height, base support, and mass.</p>
          <details class="math-param-details">
            <summary>
              <span class="mp-toggle-label">Voxel Accretion Mechanics</span>
              <span class="mp-chevron">▾</span>
            </summary>
            <div class="mp-content">
              <div class="mp-row"><code>(bx, by, bz)</code><span>Spatial grid quantization key hashing continuous 3D points into discrete voxel clusters.</span></div>
              <div class="mp-row"><code>Δh_k, Δs_k</code><span>Spike height and structural base support gains scaled by impact and radius factor.</span></div>
              <div class="mp-row"><code>ΔM_k</code><span>Physical memory mass increment accumulated into the local voxel cell.</span></div>
            </div>
          </details>
        </div>

        <!-- Equation 03 -->
        <div class="math-card">
          <div class="math-card-top">
            <span class="math-tag">EQ. 03 · CENTER OF MASS, DRIFT & STABILITY</span>
            <button class="copy-latex-btn" data-eq="3" title="Copy LaTeX formula">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy TeX</span>
            </button>
          </div>
          <div class="formula-katex-block" set:html={eq3Html}></div>
          <p class="math-desc">Evaluates global 3D center of mass and drift vector across all active spikes to determine octant personality bias and evaluate cognitive stability index S<sub>stability</sub>.</p>
          <details class="math-param-details">
            <summary>
              <span class="mp-toggle-label">Center of Mass & Stability Metrics</span>
              <span class="mp-chevron">▾</span>
            </summary>
            <div class="mp-content">
              <div class="mp-row"><code>C_mass</code><span>Global 3D center of mass weighted across all active memory spike masses.</span></div>
              <div class="mp-row"><code>D_drift(t)</code><span>Inter-round spatial drift tracking velocity of personality state evolution.</span></div>
              <div class="mp-row"><code>S_stability</code><span>Ratio of dominant spike height against top-6 total height measuring cognitive focus.</span></div>
            </div>
          </details>
        </div>

        <!-- Equation 04 -->
        <div class="math-card">
          <div class="math-card-top">
            <span class="math-tag">EQ. 04 · DUAL-FACTOR DECAY & FLOOR COLLAPSE</span>
            <button class="copy-latex-btn" data-eq="4" title="Copy LaTeX code">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy TeX</span>
            </button>
          </div>
          <div class="formula-katex-block" set:html={eq4Html}></div>
          <p class="math-desc">Simulates memory half-life through dual base/spike decay. When structural base support drops below critical floor s<sub>floor</sub>, spike height suffers accelerated collapse.</p>
          <details class="math-param-details">
            <summary>
              <span class="mp-toggle-label">Entropy Pruning & Structural Decay</span>
              <span class="mp-chevron">▾</span>
            </summary>
            <div class="mp-content">
              <div class="mp-row"><code>δ_base, δ_spike</code><span>Discrete temporal decay coefficients reducing support and height per round.</span></div>
              <div class="mp-row"><code>s_floor</code><span>Critical structural threshold triggering 8% per-round accelerated collapse when undermined.</span></div>
              <div class="mp-row"><code>Origin Collapse</code><span>Unreinforced memory sectors organically dissolve toward (0,0,0) origin.</span></div>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initA1ntuitizeEngine } from "../../features/a1-firm/a1ntuitizeEngine";

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initA1ntuitizeEngine();
      });
    } else {
      initA1ntuitizeEngine();
    }
  }
</script>

<style>
  /* SECTION 02: A1NTUITIZE SEALED R&D SECTION */
  .a1ntuitize-sealed-section {
    display: grid;
    gap: 28px;
    margin-top: 20px;
    animation: sectionFadeIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes sectionFadeIn {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .sealed-banner-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  .product-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .kicker-pill {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.28);
    color: #D4AF37;
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: var(--font-mono, monospace);
  }

  :global(html[data-theme="light"]) .kicker-pill {
    color: #8F6932;
    background: rgba(179, 138, 77, 0.1);
    border-color: rgba(179, 138, 77, 0.3);
  }

  .kicker-pill-amber {
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.25);
    color: #f59e0b;
  }

  :global(html[data-theme="light"]) .kicker-pill-amber {
    color: #b45309;
  }

