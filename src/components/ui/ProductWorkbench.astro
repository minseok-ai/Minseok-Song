---
const { appUrl } = Astro.props;

const pipelinePhases = [
  {
    num: "01",
    title: "Input Detection",
    model: "Solar",
    role: "Intent Classifier",
    desc: "Upstage Solar classifies the user query into Business, Career, IP, or semiconductor domains and expands prompt keywords."
  },
  {
    num: "02",
    title: "Research Scrutiny",
    model: "Sonar",
    role: "Context Harvester",
    desc: "Perplexity Sonar performs live web searches, scraping high-signal citations and localizing raw reference data."
  },
  {
    num: "03",
    title: "Adaptive scoring",
    model: "Rule Engine",
    role: "Pipeline Gatekeeper",
    desc: "Evaluates context quality (score 0-100). If score < 75, loops into supplementary research; otherwise, skips directly to draft to save API costs."
  },
  {
    num: "04",
    title: "Adversarial Critique",
    model: "DeepSeek & Gemini",
    role: "Creative & Critic Loop",
    desc: "Gemini drafts the report. DeepSeek critiques it as an adversarial agent to correct hallucinations and refine conclusions."
  },
  {
    num: "05",
    title: "QA & Verification",
    model: "Rules & Verification",
    role: "Compliance Inspector",
    desc: "Performs strict semiconductor equipment spec checks and generates formatted Word, PowerPoint, PDF, or Excel sheets."
  }
];
---

<section class="product-workbench fade-in-up">
  <aside class="process-panel">
    <span class="micro-label">Method / cognitive pipeline</span>
    <div class="process-list" id="process-list">
      {pipelinePhases.map((phase, index) => (
        <article data-step={index + 1} class={index === 0 ? "active" : ""}>
          <span>{phase.num}</span>
          <div>
            <h2>{phase.title}</h2>
            <p>{phase.role}</p>
          </div>
        </article>
      ))}
    </div>
  </aside>

  <div class="product-panel" id="product-panel">
    <div class="panel-toolbar">
      <span>A1trategize Pipeline Visualizer</span>
      <strong class="telemetry-log">Active Trace / Latency: 420ms</strong>
    </div>
    
    <div class="product-diagram" aria-hidden="true" id="diagram-container">
      <svg viewBox="0 0 720 300" id="product-svg">
        <!-- Background static grid lines -->
        <path class="flow-line line-main" d="M 70 150 L 650 150" />
        <path class="flow-line line-sub" d="M 220 150 Q 370 240 520 150" />
        <path class="flow-line line-loop" d="M 650 150 Q 585 60 520 150" />
        
        <!-- Animated pulse flows -->
        <path class="pulse-line pulse-main" d="M 70 150 L 650 150" />
        <path class="pulse-line pulse-sub" d="M 220 150 Q 370 240 520 150" />
        <path class="pulse-line pulse-loop" d="M 650 150 Q 585 60 520 150" />
        
        <!-- Nodes -->
        <!-- Step 1: Detect -->
        <circle class="node node-1 active" cx="70" cy="150" r="7" data-step="1" />
        
        <!-- Step 2: Research -->
        <circle class="node node-2" cx="220" cy="150" r="7" data-step="2" />
        
        <!-- Step 3: Adaptive Gate (Diamond Node) -->
        <polygon class="node-gate node-3" points="370,136 384,150 370,164 356,150" data-step="3" />
        
        <!-- Step 4: Critique & QA -->
        <circle class="node node-4" cx="520" cy="150" r="7" data-step="4" />
        
        <!-- Step 5: Save & Export -->
        <circle class="node node-5" cx="650" cy="150" r="7" data-step="5" />
      </svg>
    </div>

    <!-- Repositioned Dedicated Telemetry Status Bar -->
    <div class="telemetry-info-bar" id="telemetry-bar">
      <div class="bar-left">
        <span class="bar-kicker" id="card-model">Solar</span>
        <h3 id="card-title">Input Detection</h3>
      </div>
      <div class="bar-center">
        <p id="card-desc">Upstage Solar classifies the user query into Business, Career, IP, or semiconductor domains and expands prompt keywords.</p>
      </div>
      <div class="bar-right">
        <div>
          <span>Engine</span>
          <strong id="card-engine">Solar</strong>
        </div>
        <div>
          <span>Target</span>
          <strong id="card-status">Adaptive</strong>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ pipelinePhases }}>
  document.addEventListener("DOMContentLoaded", () => {
    const listArticles = document.querySelectorAll('#process-list article');
    const nodes = document.querySelectorAll('#product-svg .node, #product-svg .node-gate');
    const svg = document.getElementById('product-svg');
    
    // Telemetry Bar Elements
    const cardModel = document.getElementById('card-model');
    const cardTitle = document.getElementById('card-title');
    const cardDesc = document.getElementById('card-desc');
    const cardEngine = document.getElementById('card-engine');
    const cardStatus = document.getElementById('card-status');
    
    let currentStep = 1;
    const totalSteps = 5;
    
    function updateDetails(stepIndex) {
      const data = pipelinePhases[stepIndex - 1];
      if (!data) return;
      
      // Update info panel
      if (cardModel) cardModel.textContent = data.role;
      if (cardTitle) cardTitle.textContent = data.title;
      if (cardDesc) cardDesc.textContent = data.desc;
      if (cardEngine) cardEngine.textContent = data.model;
      if (cardStatus) cardStatus.textContent = data.num === "03" ? "Condition Gate" : "Active Flow";
    }

    function setStep(step) {
      currentStep = step;
      
      // Highlight list items
      listArticles.forEach(article => {
        const stepNum = parseInt(article.dataset.step);
        article.classList.toggle('active', stepNum === step);
      });

      // Highlight SVG nodes
      nodes.forEach(node => {
        const stepNum = parseInt(node.dataset.step);
        node.classList.toggle('active', stepNum === step);
      });
      
      // Update active step attribute on the SVG element
      if (svg) {
        svg.setAttribute('data-active-step', step.toString());
      }
      
      updateDetails(step);
    }

    // Auto-cycle in the background (very slowly, every 4.5s)
    let cycleInterval = setInterval(() => {
      const nextStep = currentStep >= totalSteps ? 1 : currentStep + 1;
      setStep(nextStep);
    }, 4500);

    // Allow manual interaction
    listArticles.forEach(article => {
      article.addEventListener('click', () => {
        clearInterval(cycleInterval); // Pause auto-cycle
        const step = parseInt(article.dataset.step);
        setStep(step);
      });
    });

    nodes.forEach(node => {
      node.addEventListener('click', () => {
        clearInterval(cycleInterval); // Pause auto-cycle
        const step = parseInt(node.dataset.step);
        setStep(step);
      });
      
      node.addEventListener('mouseenter', () => {
        const step = parseInt(node.dataset.step);
        updateDetails(step);
      });
      
      node.addEventListener('mouseleave', () => {
        updateDetails(currentStep);
      });
    });

    // 3D Parallax Movement (SVG only)
    const panel = document.getElementById('diagram-container');
    
    if (panel && svg) {
      panel.addEventListener('mousemove', (e) => {
        const rect = panel.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;

        // Soft, elegant movement
        svg.style.transform = `translate(${x * -0.015}px, ${y * -0.015}px)`;
      });

      panel.addEventListener('mouseleave', () => {
        svg.style.transform = `translate(0, 0)`;
        svg.style.transition = 'transform 0.5s ease';
      });
      
      panel.addEventListener('mouseenter', () => {
        svg.style.transition = 'none';
      });
    }
    
    // Initial load
    updateDetails(1);
  });
</script>

<style>
  .product-workbench {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    position: relative;
    z-index: 10;
  }

  .process-panel {
    position: sticky;
    top: calc(var(--header-height) + 48px);
    display: grid;
    gap: 24px;
  }

  .process-list {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .process-list article {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 16px;
    padding: 24px 0;
    border-bottom: 1px solid var(--color-line-dark);
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0.35;
    position: relative;
  }

  .process-list article::before {
    content: '';
    position: absolute;
    left: -20px;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 0;
    background: var(--color-accent);
    border-radius: 4px;
    transition: height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    opacity: 0;
  }

  .process-list article:hover {
    opacity: 0.7;
    transform: translateX(4px);
  }

  .process-list article.active {
    opacity: 1;
    transform: translateX(8px);
  }

  .process-list article.active::before {
    height: 60%;
    opacity: 1;
    box-shadow: 0 0 12px var(--color-accent-glow);
  }

  .process-list article.active span {
    color: var(--color-accent);
    text-shadow: 0 0 12px var(--color-accent-glow);
  }

  .process-list article.active h2 {
    color: var(--color-ink);
  }

  .process-list span {
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    transition: all 0.4s ease;
  }

  .process-list h2 {
    margin: 0 0 6px;
    font-size: 1.25rem;
    line-height: 1.25;
    font-weight: 600;
    transition: color 0.4s ease;
    color: var(--color-ink-soft);
    letter-spacing: -0.01em;
  }

  .process-list p {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .product-panel {
    min-width: 0;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: inset 0 1px 0 var(--color-line-dark), 0 20px 50px var(--glass-shadow);
    position: relative;
    backdrop-filter: blur(20px);
  }

  .product-panel:hover {
    border-color: var(--color-line-strong);
    box-shadow: inset 0 1px 0 var(--color-line), 0 30px 70px rgba(0, 0, 0, 0.4);
    transform: translateY(-4px);
  }

  .panel-toolbar {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    align-items: center;
    min-height: 52px;
    padding: 0 24px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-line-dark);
  }

  .panel-toolbar span {
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .telemetry-log {
    color: var(--color-accent-ink);
    font-size: 11px;
    font-family: var(--font-mono);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .telemetry-log::before {
    content: '';
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-green);
    box-shadow: 0 0 8px var(--color-green-glow);
    animation: pulseLight 2s infinite;
  }

  @keyframes pulseLight {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .product-diagram {
    position: relative;
    min-height: 320px;
    overflow: hidden;
    background:
      linear-gradient(90deg, var(--color-line-strong) 1px, transparent 1px),
      linear-gradient(180deg, var(--color-line-strong) 1px, transparent 1px);
    background-size: 60px 60px;
    background-position: center;
    perspective: 1000px;
  }

  .product-diagram::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 20%, var(--color-paper-deep) 100%);
    pointer-events: none;
    opacity: 0.8;
  }

  .product-diagram svg {
    position: absolute;
    inset: 6% 4%;
    width: 92%;
    height: 88%;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 0 20px rgba(0, 0, 0, 0.5));
  }

  /* SVG Flow Lines */
  .flow-line {
    fill: none;
    stroke-linecap: round;
  }

  .line-main {
    stroke: var(--color-ink-soft);
    stroke-width: 1.5;
  }

  .line-sub {
    stroke: var(--color-ink-muted);
    stroke-width: 1.2;
    stroke-dasharray: 2 4;
  }

  .line-loop {
    stroke: var(--color-ink-muted);
    stroke-width: 1.2;
    stroke-dasharray: 2 4;
  }

  /* Animated pulse flows - Ultra slow and elegant */
  .pulse-line {
    fill: none;
    stroke-linecap: round;
    opacity: 0.08;
    stroke-dasharray: 12 60;
    animation: flowPulse 7s linear infinite;
    transition: opacity 0.5s ease, stroke-width 0.5s ease;
  }

  .pulse-main {
    stroke: var(--color-accent);
    stroke-width: 2.2;
  }

  .pulse-sub {
    stroke: var(--color-warm);
    stroke-width: 1.8;
    animation-duration: 9s;
  }

  .pulse-loop {
    stroke: var(--color-green);
    stroke-width: 1.8;
    animation-duration: 8s;
    animation-direction: reverse;
  }

  /* Interactive active step line styling highlights */
  #product-svg[data-active-step="1"] .pulse-main {
    opacity: 0.7;
    stroke-width: 3;
    filter: drop-shadow(0 0 6px var(--color-accent-glow));
  }

  #product-svg[data-active-step="2"] .pulse-main {
    opacity: 0.7;
    stroke-width: 3;
    filter: drop-shadow(0 0 6px var(--color-accent-glow));
  }

  #product-svg[data-active-step="3"] .pulse-main {
    opacity: 0.35;
  }
  #product-svg[data-active-step="3"] .pulse-sub {
    opacity: 0.8;
    stroke-width: 3;
    filter: drop-shadow(0 0 6px var(--color-warm-glow));
  }

  #product-svg[data-active-step="4"] .pulse-main {
    opacity: 0.35;
  }
  #product-svg[data-active-step="4"] .pulse-loop {
    opacity: 0.8;
    stroke-width: 3;
    filter: drop-shadow(0 0 6px var(--color-green-glow));
  }

  #product-svg[data-active-step="5"] .pulse-main {
    opacity: 0.7;
    stroke-width: 3;
    filter: drop-shadow(0 0 6px var(--color-accent-glow));
  }

  @keyframes flowPulse {
    from { stroke-dashoffset: 360; }
    to { stroke-dashoffset: 0; }
  }

  /* Node items */
  .node, .node-gate {
    fill: var(--color-paper);
    stroke: var(--color-ink-soft);
    stroke-width: 2;
    cursor: pointer;
    transform-box: fill-box;
    transform-origin: center;
    transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .node.active {
    fill: var(--color-accent);
    stroke: #ffffff;
    stroke-width: 3;
    transform: scale(1.6);
    filter: drop-shadow(0 0 16px var(--color-accent-glow));
    animation: nodePulse 2s infinite;
  }

  .node-gate.active {
    fill: var(--color-warm);
    stroke: #ffffff;
    stroke-width: 3;
    transform: scale(1.5) rotate(45deg);
    filter: drop-shadow(0 0 16px var(--color-warm-glow));
    animation: gatePulse 2s infinite;
  }

  @keyframes nodePulse {
    0%, 100% { filter: drop-shadow(0 0 12px var(--color-accent-glow)); }
    50% { filter: drop-shadow(0 0 24px var(--color-accent-glow)); }
  }

  @keyframes gatePulse {
    0%, 100% { filter: drop-shadow(0 0 12px var(--color-warm-glow)); }
    50% { filter: drop-shadow(0 0 24px var(--color-warm-glow)); }
  }

  /* Telemetry Status Bar Styling */
  .telemetry-info-bar {
    display: grid;
    grid-template-columns: 220px 1fr 200px;
    gap: 32px;
    padding: 28px 32px;
    border-top: 1px solid var(--color-line);
    background: linear-gradient(90deg, var(--color-line-dark) 0%, transparent 100%);
    position: relative;
    overflow: hidden;
  }

  .telemetry-info-bar::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 200px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0.5;
  }

  .bar-left {
    display: grid;
    gap: 6px;
  }

  .bar-kicker {
    color: var(--color-accent-ink);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .bar-left h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .bar-center p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 14px;
    line-height: 1.6;
  }

  .bar-right {
    display: flex;
    justify-content: flex-end;
    gap: 28px;
  }

  .bar-right div {
    display: grid;
    gap: 6px;
    text-align: right;
  }

  .bar-right span {
    color: var(--color-ink-muted);
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 800;
    letter-spacing: 0.05em;
  }

  .bar-right strong {
    font-size: 13px;
    color: var(--color-ink);
    font-family: var(--font-mono);
  }

  @media (max-width: 1180px) {
    .product-workbench {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .process-panel {
      position: static;
    }
    .process-list article {
      grid-template-columns: 36px minmax(0, 1fr);
      padding: 18px 0;
    }
    .process-list article::before {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .product-workbench { gap: 20px; }
    .process-list article { grid-template-columns: 30px minmax(0, 1fr); gap: 12px; padding: 14px 0; opacity: 0.55; }
    .process-list article.active { opacity: 1; transform: translateX(4px); }
    .process-list h2 { font-size: 1.05rem; }
    .process-list p { font-size: 12.5px; }
    .product-diagram { min-height: 220px; }
    .telemetry-info-bar { grid-template-columns: 1fr; gap: 14px; padding: 18px 16px; }
    .bar-left h3 { font-size: 15px; }
    .bar-center p { font-size: 12.5px; line-height: 1.5; }
    .bar-right { justify-content: flex-start; gap: 24px; }
    .bar-right div { text-align: left; }
    .bar-right span { font-size: 9px; }
    .bar-right strong { font-size: 12px; }
    .panel-toolbar { padding: 0 16px; min-height: 44px; }
    .panel-toolbar span { font-size: 10px; }
    .telemetry-log { font-size: 10px; }
  }
</style>
