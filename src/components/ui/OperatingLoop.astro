---
const { signalLoop } = Astro.props;
---

<section class="loop-section fade-in-up" aria-label="Operating loop">
  <div class="section-head">
    <p class="micro-label">Operating loop</p>
    <h2>From signal to surface, without losing the reasoning trace.</h2>
  </div>

  <div class="loop-container">
    <!-- Sequential dotted connecting path line -->
    <div class="loop-connecting-line" aria-hidden="true"></div>
    <div class="loop-grid">
      {signalLoop.map((step, index) => (
        <article class={`loop-card loop-step-${(index % 4) + 1}`}>
          <span class="step-num">{step.num}</span>
          <h3>{step.title}</h3>
          <p>{step.copy}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .loop-section {
    display: grid;
    gap: 32px;
    padding-top: 104px;
    padding-bottom: 92px;
    border-top: 1px solid var(--color-line);
    width: min(100%, var(--max-site));
    margin: 0 auto;
    padding-right: var(--space-page);
    padding-left: var(--space-page);
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    gap: 28px;
    align-items: end;
    border-bottom: 1px solid var(--color-line-strong);
    padding-bottom: 24px;
  }

  .section-head h2 {
    max-width: 620px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: right;
  }

  .loop-container {
    position: relative;
    width: 100%;
  }

  .loop-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    z-index: 1;
  }

  .loop-connecting-line {
    position: absolute;
    top: 40px;
    left: 8%;
    right: 8%;
    height: 1px;
    background-image: linear-gradient(to right, rgba(255, 255, 255, 0.05) 50%, transparent 50%);
    background-size: 10px 1px;
    background-repeat: repeat-x;
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
  }

  .loop-card {
    position: relative;
    min-height: 320px;
    padding: 32px;
    border-radius: 8px;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    transition: transform var(--motion-base) var(--easing-spring), box-shadow var(--motion-base) var(--easing-spring), border-color var(--motion-base) ease;
    overflow: hidden;
    z-index: 1;
    
    animation: fadeInUp 0.6s var(--easing-smooth) both;
  }

  .loop-step-1 { animation-delay: 0ms; }
  .loop-step-2 { animation-delay: 100ms; }
  .loop-step-3 { animation-delay: 200ms; }
  .loop-step-4 { animation-delay: 300ms; }

  /* Distinct hover glows per step - Synthesized color scheme (Blue & Warm Gold) */
  .loop-card:nth-of-type(1),
  .loop-card:nth-of-type(2) { 
    --card-glow: var(--color-blue); 
  }
  .loop-card:nth-of-type(3),
  .loop-card:nth-of-type(4) { 
    --card-glow: var(--color-warm); 
  }

  .loop-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at top right, var(--card-glow, rgba(107, 156, 242, 0.05)), transparent 60%);
    opacity: 0;
    transition: opacity var(--motion-base) ease;
  }

  /* Premium border gradient shine */
  .loop-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, transparent 40%, transparent 60%, rgba(255, 255, 255, 0.04) 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.5;
    transition: opacity var(--motion-base) ease;
    pointer-events: none;
  }

  .loop-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.1);
  }

  .loop-card:hover::before {
    opacity: 0.12;
  }

  .loop-card:hover::after {
    opacity: 1;
    background: linear-gradient(135deg, var(--card-glow) 0%, transparent 50%, rgba(255, 255, 255, 0.1) 100%);
  }

  .step-num {
    color: var(--color-accent);
    font-size: 14px;
    font-weight: 800;
    font-family: var(--font-mono);
    transition: text-shadow 0.3s ease, color 0.3s ease;
  }

  .loop-card:hover .step-num {
    color: var(--card-glow);
    text-shadow: 0 0 12px var(--card-glow);
  }

  .loop-card h3 {
    margin: 84px 0 16px;
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .loop-card h3::after {
    content: "";
    display: block;
    width: 34px;
    height: 1px;
    margin-top: 18px;
    background: var(--card-glow);
    opacity: 0.55;
  }

  .loop-card p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 15px;
    line-height: 1.64;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1180px) {
    .loop-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .loop-connecting-line {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .loop-grid {
      grid-template-columns: 1fr;
    }
    .section-head {
      display: grid;
      align-items: start;
    }
    .section-head h2 {
      text-align: left;
    }
  }
</style>
