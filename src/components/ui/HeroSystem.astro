---
const { a1Firms, focusStats, siteConfig } = Astro.props;
---

<section class="hero-system" aria-label="A1 Firms overview">
  <!-- Dotted geometric background overlay with a radial mask -->
  <div class="hero-dots-bg" aria-hidden="true">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="hero-dots" width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="0.8" fill="var(--glass-border)" />
        </pattern>
        <radialGradient id="hero-dots-fade" cx="30%" cy="40%" r="55%">
          <stop offset="0%" stop-color="#fff" stop-opacity="1" />
          <stop offset="60%" stop-color="#fff" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#fff" stop-opacity="0" />
        </radialGradient>
        <mask id="hero-dots-mask">
          <rect width="100%" height="100%" fill="url(#hero-dots-fade)" />
        </mask>
      </defs>
      <rect width="100%" height="100%" fill="url(#hero-dots)" mask="url(#hero-dots-mask)" />
    </svg>
  </div>

  <div class="hero-copy-panel fade-in-up">
    <p class="micro-label">Minseok Song / A1 Firms</p>
    <h1>
      Strategy systems for <span>AI-native firms.</span>
    </h1>
    <p>
      A public operating layer for A1trategize, selected work, field notes,
      and the strategic intelligence loop behind them.
    </p>
    <div class="hero-actions" aria-label="Primary actions">
      <a class="primary-action" href={siteConfig.a1FirmPath}>Open A1trategize</a>
      <a class="secondary-action" href="#surfaces">Explore surfaces <span class="arrow-shifted">→</span></a>
    </div>
  </div>

  <aside class="hero-brief fade-in-up" style="animation-delay: 150ms;" aria-label="Current focus">
    <div class="brief-glow"></div>
    <div class="brief-content">
      <div class="focus-title-wrap">
        <p class="micro-label">Current focus</p>
        <span class="live-indicator">
          <span class="indicator-dot"></span>
          Live
        </span>
      </div>
      <h2>{a1Firms?.hero?.title ?? "A1trategize"}</h2>
      <p>
        The working product remains separate. This site explains the context,
        proof, writing, and product memory around it.
      </p>

      <!-- Multi-LLM Routing Telemetry -->
      <div class="telemetry-bar">
        <div class="telemetry-pipeline">
          <div class="telemetry-node active" style="--node-color: var(--color-accent);">
            <span class="telemetry-dot"></span>
            <span class="telemetry-label">solar-pro</span>
          </div>
          <span class="telemetry-arrow">➔</span>
          <div class="telemetry-node active" style="--node-color: var(--color-blue);">
            <span class="telemetry-dot"></span>
            <span class="telemetry-label">sonar-pro</span>
          </div>
          <span class="telemetry-arrow">➔</span>
          <div class="telemetry-node active" style="--node-color: var(--color-coral);">
            <span class="telemetry-dot"></span>
            <span class="telemetry-label">gemini-pro</span>
          </div>
          <span class="telemetry-arrow">➔</span>
          <div class="telemetry-node active" style="--node-color: var(--color-purple);">
            <span class="telemetry-dot"></span>
            <span class="telemetry-label">deepseek-v4</span>
          </div>
        </div>
        <div class="telemetry-status">
          <span class="telemetry-log">ROUTING CONTEXT / LATENCY 420ms</span>
          <span class="telemetry-progress-track">
            <span class="telemetry-progress-bar"></span>
          </span>
        </div>
      </div>

      <dl>
        {focusStats.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </aside>
</section>

<style>
  .hero-system {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(420px, 0.78fr);
    grid-template-rows: 1fr auto;
    gap: 42px 62px;
    width: min(100%, var(--max-site));
    margin: 0 auto;
    padding-right: var(--space-page);
    padding-left: var(--space-page);
    min-height: calc(100svh - var(--header-height) - 40px);
    padding-top: 56px;
    padding-bottom: 28px;
    overflow: hidden;
  }

  .hero-dots-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.6;
  }

  .hero-system::before {
    content: "";
    position: absolute;
    inset: 0 var(--space-page) auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(var(--rgb-warm), 0.6), transparent);
    opacity: 0.6;
    z-index: 1;
  }

  .hero-system::after {
    content: "";
    position: absolute;
    top: -200px;
    left: -100px;
    width: 800px;
    height: 800px;
    background: radial-gradient(circle, rgba(var(--rgb-warm), 0.04) 0%, transparent 60%);
    pointer-events: none;
    z-index: -1;
  }

  .hero-copy-panel {
    position: relative;
    z-index: 2;
    align-self: center;
    max-width: 800px;
    grid-column: 1;
    grid-row: 1;
  }

  .hero-copy-panel h1 {
    margin: 18px 0 24px;
    font-size: clamp(3.2rem, 7vw, 6.8rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-family: "Noto Serif KR", "Noto Serif", serif;
    color: var(--color-ink-muted);
  }

  .hero-copy-panel h1 span {
    display: inline-block;
    background: linear-gradient(135deg, var(--color-ink) 30%, var(--color-accent-ink) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
    transition: filter var(--motion-base) ease;
  }

  .hero-copy-panel h1:hover span {
    filter: drop-shadow(0 0 12px rgba(var(--rgb-warm), 0.35));
  }

  .hero-copy-panel p:not(.micro-label) {
    max-width: 650px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 18px;
    line-height: 1.72;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
  }

  .primary-action,
  .secondary-action {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 32px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }

  .primary-action {
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-paper-deep);
    background: var(--color-ink);
    box-shadow: 0 8px 20px rgba(255, 255, 255, 0.15);
  }

  .secondary-action {
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-ink);
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05), 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  .secondary-action .arrow-shifted {
    margin-left: 6px;
    transition: transform var(--motion-fast) var(--easing-smooth);
    display: inline-block;
  }

  .primary-action:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(255, 255, 255, 0.25);
    background: #ffffff;
  }

  .secondary-action:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.3);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3), inset 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  .secondary-action:hover .arrow-shifted {
    transform: translateX(4px);
  }

  .hero-brief {
    position: relative;
    align-self: center;
    padding: 32px;
    border-radius: var(--radius-lg);
    background: var(--color-panel);
    border: 1px solid var(--glass-border);
    transition:
      transform var(--motion-base) var(--easing-spring),
      box-shadow var(--motion-base) var(--easing-spring);
    overflow: hidden;
    z-index: 2;
    grid-column: 2;
    grid-row: 1;
  }

  .hero-brief:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
  }

  .brief-glow {
    position: absolute;
    top: -50px;
    right: -50px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(var(--rgb-warm), 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .brief-content {
    position: relative;
    z-index: 1;
  }

  .focus-title-wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .live-indicator {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 9px;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--color-green);
    letter-spacing: 0.1em;
    background: rgba(108, 163, 125, 0.08);
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid rgba(108, 163, 125, 0.15);
  }

  .indicator-dot {
    width: 5px;
    height: 5px;
    background: var(--color-green);
    border-radius: 50%;
    position: relative;
  }

  .indicator-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--color-green);
    opacity: 0.4;
    animation: dotPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes dotPulse {
    0% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(2.4); opacity: 0; }
    100% { transform: scale(1); opacity: 0; }
  }

  .hero-brief h2 {
    font-family: "Noto Serif KR", "Noto Serif", serif;
    font-size: 2.6rem;
    margin: 12px 0 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  
  .hero-brief p {
    color: var(--color-ink-soft);
    font-size: 15px;
    line-height: 1.65;
    margin-bottom: 20px;
  }

  /* Sleek Multi-LLM Routing Telemetry Styles */
  .telemetry-bar {
    margin-bottom: 24px;
    padding: 14px 18px;
    border-radius: 6px;
    background: var(--color-field);
    border: 1px solid var(--color-line);
    box-shadow: inset 0 1px 2px var(--color-line-dark);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .telemetry-pipeline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 4px;
  }

  .telemetry-node {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .telemetry-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--node-color, var(--color-accent));
    box-shadow: 0 0 6px var(--node-color, var(--color-accent));
  }

  .telemetry-label {
    font-size: 9px;
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .telemetry-arrow {
    font-size: 9px;
    color: var(--color-ink-muted);
  }

  .telemetry-status {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .telemetry-log {
    font-size: 8px;
    color: var(--color-ink-muted);
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .telemetry-progress-track {
    width: 100%;
    height: 1px;
    background: var(--color-line);
    position: relative;
    overflow: hidden;
  }

  .telemetry-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 30%;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    animation: telemetrySweep 3s infinite linear;
  }

  @keyframes telemetrySweep {
    0% { transform: translateX(-150%); }
    100% { transform: translateX(350%); }
  }

  .hero-brief dl {
    display: grid;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid rgba(var(--rgb-warm), 0.25);
  }

  .hero-brief dl div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .hero-brief dl div:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .hero-brief dt {
    font-size: 10px;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .hero-brief dd {
    margin: 0;
    font-family: "Noto Serif KR", "Noto Serif", serif;
    font-size: 18px;
    font-weight: 500;
    color: var(--color-ink);
    text-align: right;
  }

  .fade-in-up {
    animation: fadeInUp var(--motion-slow) var(--easing-smooth) both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 1180px) {
    .hero-system {
      grid-template-columns: 1fr;
    }
    
    .hero-copy-panel {
      grid-column: 1;
      grid-row: 1;
    }

    .hero-brief {
      grid-column: 1;
      grid-row: 2;
      max-width: 600px;
    }
  }

  @media (max-width: 820px) {
    .hero-system {
      min-height: auto;
      padding-top: 42px;
    }
  }
</style>
