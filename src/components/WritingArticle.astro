---
import type { WritingBlock, WritingContent } from "../lib/schemas/content";

const { writing, slug } = Astro.props as {
  writing: WritingContent;
  slug: string;
};

const fallbackBlocks: WritingBlock[] = writing.body
  ? [
      {
        id: "legacy-body",
        type: "paragraph",
        hidden: false,
        variant: "body",
        body: writing.body
      }
    ]
  : [];

const visibleBlocks = (writing.blocks?.length ? writing.blocks : fallbackBlocks).filter(
  (block) => !block.hidden
);

const blockLabel = (block: WritingBlock) => {
  if (block.type === "embed") return block.provider;
  if (block.type === "code") return block.language || "text";
  return block.type;
};
const embedSandbox = "allow-scripts allow-same-origin allow-popups allow-presentation";
---

<article class="writing-article page-frame">
  <header class="writing-head">
    <a class="back-link" href="/writings">Back to writings</a>
    <div class="writing-meta">
      <span>{writing.date ?? "Draft"}</span>
      <span>{writing.status}</span>
      <span>{slug}</span>
    </div>
    <h1>{writing.title}</h1>
    {writing.summary && <p>{writing.summary}</p>}
    {writing.tags.length > 0 && (
      <div class="writing-tags">
        {writing.tags.map((tag) => <span>{tag}</span>)}
      </div>
    )}
  </header>

  <div class="writing-body">
    {visibleBlocks.map((block) => (
      <section class={`article-block article-${block.type}`}>
        <span class="block-type">{blockLabel(block)}</span>

        {block.type === "paragraph" && (
          <p class={`paragraph-${block.variant}`}>{block.body}</p>
        )}

        {block.type === "heading" && block.level === 2 && <h2>{block.body}</h2>}
        {block.type === "heading" && block.level === 3 && <h3>{block.body}</h3>}

        {block.type === "image" && (
          <figure>
            <img src={block.src} alt={block.alt} loading="lazy" />
            {block.caption && <figcaption>{block.caption}</figcaption>}
          </figure>
        )}

        {block.type === "code" && (
          <pre><code>{block.code}</code></pre>
        )}

        {block.type === "embed" && (
          <div>
            <div
              class="writing-embed"
              style={`--embed-ratio: ${block.aspectRatio.replace("/", " / ")};`}
            >
              <iframe
                src={block.src}
                title={`${block.provider} embed`}
                loading="lazy"
                allow="fullscreen"
                allowfullscreen={block.allowFullscreen}
                referrerpolicy="no-referrer"
                sandbox={embedSandbox}
              />
            </div>
            {block.caption && <p class="caption">{block.caption}</p>}
          </div>
        )}

        {block.type === "quote" && (
          <blockquote>
            <p>{block.body}</p>
            {block.cite && <cite>{block.cite}</cite>}
          </blockquote>
        )}

        {block.type === "divider" && <hr />}
      </section>
    ))}
  </div>
</article>

<style>
  .writing-article {
    display: grid;
    gap: 64px;
  }

  .writing-head {
    display: grid;
    gap: 18px;
    max-width: 1040px;
  }

  .back-link {
    width: fit-content;
    color: var(--color-ink-muted);
    font-size: 12px;
    font-weight: 850;
    text-decoration: none;
    text-transform: uppercase;
  }

  .back-link:hover {
    color: var(--color-accent-ink);
  }

  .writing-meta,
  .writing-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .writing-meta span,
  .writing-tags span,
  .block-type {
    border: 1px solid var(--color-line);
    padding: 6px 8px;
    color: var(--color-ink-muted);
    font-size: 11px;
    font-weight: 850;
    text-transform: uppercase;
  }

  .writing-head h1 {
    margin: 0;
    font-size: 7rem;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.96;
  }

  .writing-head > p {
    max-width: 840px;
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 20px;
    line-height: 1.65;
  }

  .writing-body {
    display: grid;
    gap: 0;
    max-width: 1040px;
  }

  @media (max-width: 1180px) {
    .writing-head h1 {
      font-size: 5.4rem;
    }
  }

  @media (max-width: 760px) {
    .writing-head h1 {
      font-size: 3.1rem;
    }
  }

  .article-block {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: clamp(18px, 4vw, 44px);
    padding: 34px 0;
    border-top: 1px solid var(--color-line);
  }

  .article-block:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .article-block h2,
  .article-block h3,
  .article-block p,
  .article-block blockquote {
    margin-top: 0;
  }

  .article-block h2 {
    margin-bottom: 0;
    font-size: 3rem;
    line-height: 1.08;
  }

  .article-block h3 {
    margin-bottom: 0;
    font-size: 2rem;
    line-height: 1.18;
  }

  .paragraph-lead {
    margin-bottom: 0;
    font-size: 2rem;
    font-weight: 850;
    line-height: 1.34;
  }

  .paragraph-body {
    margin-bottom: 0;
    color: var(--color-ink-soft);
    font-size: 17px;
    line-height: 1.82;
    white-space: pre-wrap;
  }

  .paragraph-small,
  .caption {
    margin-bottom: 0;
    color: var(--color-ink-muted);
    font-size: 14px;
    line-height: 1.65;
    white-space: pre-wrap;
  }

  figure {
    margin: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-panel);
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    padding: 12px 14px;
    color: var(--color-ink-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  pre {
    margin: 0;
    overflow: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 20px;
    background: #020202;
    color: var(--color-ivory-soft);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
  }

  code {
    font-family: inherit;
  }

  .writing-embed {
    position: relative;
    width: 100%;
    aspect-ratio: var(--embed-ratio, 16 / 9);
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-field);
  }

  .writing-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .caption {
    margin-top: 12px;
  }

  blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 22px;
  }

  blockquote p {
    margin-bottom: 10px;
    font-size: 1.65rem;
    font-weight: 850;
    line-height: 1.35;
  }

  cite {
    color: var(--color-ink-muted);
    font-size: 13px;
    font-style: normal;
  }

  hr {
    width: 100%;
    height: 1px;
    border: 0;
    background: var(--color-line-strong);
  }

  @media (max-width: 760px) {
    .writing-article {
      gap: 42px;
    }

    .article-block {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 28px 0;
    }

    .article-block h2 {
      font-size: 2.15rem;
    }

    .paragraph-lead {
      font-size: 1.45rem;
    }
  }
</style>
