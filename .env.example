SITE_URL=https://minseoksong.com
A1TRATEGIZE_URL=https://a1trategize.com

# Auth.js / auth-astro GitHub OAuth.
# GitHub OAuth callback:
#   https://minseoksong.com/api/auth/callback/github
# Local callback:
#   http://localhost:4321/api/auth/callback/github
AUTH_SECRET=
AUTH_TRUST_HOST=true
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Prefer stable numeric GitHub user IDs. Usernames are supported for convenience.
ADMIN_GITHUB_ID=
ADMIN_GITHUB_IDS=
ADMIN_GITHUB_USERNAME=
ADMIN_GITHUB_USERNAMES=

# Git-backed publishing, later production content writes.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
